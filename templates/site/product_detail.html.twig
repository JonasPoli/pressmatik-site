{# templates/site/product_detail.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Pressmatik - {% if activeSubproduct %}{{ activeSubproduct.model }} {{ activeSubproduct.getName(locale) }}{% else %}{{ product.getName(locale) }}{% endif %}{% endblock %}

{% block body %}
    <div class="container product-detail-layout">
        <!-- Breadcrumbs -->
        <div class="breadcrumbs scroll-animate slide-left">
            <a href="{{ path('app_home', {'_locale': locale}) }}">{{ 'menu.home'|trans }}</a>
            <span>/</span>
            <a href="{{ path('app_home', {'_locale': locale}) ~ '#products' }}">{{ 'menu.products'|trans }}</a>
            <span>/</span>
            {% if activeSubproduct %}
                <a href="{{ path('app_product_detail', {'_locale': locale, 'slug': product.slug}) }}">{{ product.getName(locale) }}</a>
                <span>/</span>
                <span style="color: var(--color-accent-red);">{{ activeSubproduct.model }} {{ activeSubproduct.getName(locale) }}</span>
            {% else %}
                <span style="color: var(--color-accent-red);">{{ product.getName(locale) }}</span>
            {% endif %}
        </div>

        <!-- Product Introduction (Above the Fold) -->
        <div class="product-intro-grid">
            <div class="product-gallery scroll-animate slide-left" style="display: flex; align-items: center; justify-content: center; background: var(--color-surface-dark); border-radius: 12px; border: 1px solid var(--color-border); padding: 2rem;">
                <img src="{% if activeSubproduct and activeSubproduct.imageName %}/uploads/products/{{ activeSubproduct.imageName }}{% elseif product.imageName %}/uploads/products/{{ product.imageName }}{% else %}/images/prensa-hidraulica-tipo-c-linha-st.png{% endif %}" alt="{% if activeSubproduct %}{{ activeSubproduct.getName(locale) }}{% else %}{{ product.getName(locale) }}{% endif %}" style="max-width: 100%; max-height: 400px; object-fit: contain; display: block; margin: auto;">
            </div>
            
            <div class="product-meta-panel scroll-animate slide-right">
                <span class="product-tag">{{ 'product_detail.tag'|trans }}</span>
                <h1>{% if activeSubproduct %}{{ activeSubproduct.model }} - {{ activeSubproduct.getName(locale) }}{% else %}{{ product.getName(locale) }}{% endif %}</h1>
                {% if product.tonnage %}
                    <div class="product-tonnage">
                        {{ 'product_detail.spec_capacity'|trans }}: {{ product.tonnage }}
                    </div>
                {% endif %}
                <p class="product-description">
                    {% if activeSubproduct %}{{ activeSubproduct.getDescription(locale) }}{% else %}{{ product.getDescription(locale) }}{% endif %}
                </p>
                <div class="product-action-buttons">
                    {% set active_pdf = activeSubproduct ? activeSubproduct.getPdfForLocale(locale) : null %}
                    {% if active_pdf %}
                        <wa-button variant="brand" size="large" href="/uploads/products/{{ active_pdf }}" download target="_blank">
                            <i class="fa-solid fa-file-pdf" style="margin-right: 8px;"></i>
                            {{ 'cta.download_catalog'|trans }}
                        </wa-button>
                    {% endif %}
                    
                    <wa-button variant="neutral" outline size="large" href="#quote-product-form" onclick="document.getElementById('p-model').value = '{{ activeSubproduct ? activeSubproduct.model|lower : '' }}';">
                        <i class="fa-solid fa-envelope" style="margin-right: 8px;"></i>
                        {{ 'product_detail.quote_product'|trans }}
                    </wa-button>
                </div>
            </div>
        </div>



        <!-- Product Overview & Detailed Features -->
        <section class="product-overview-section scroll-animate slide-top" style="margin-top: 6rem; margin-bottom: 6rem;">
            <div class="overview-header" style="margin-bottom: 3.5rem; text-align: left; max-width: 900px;">
                <span class="section-title-tag">{{ 'product_detail.overview_heading'|trans }}</span>
                <h2 style="font-size: 2.5rem; margin-top: 1rem; margin-bottom: 1.5rem; font-weight: 800; font-family: var(--font-heading);">Foco em Segurança e Robustez</h2>
                <p style="color: var(--color-text-secondary); font-size: 1.15rem; line-height: 1.8; margin: 0;">
                    Projetadas sob rígidas normas internacionais, nossas máquinas unem estrutura reforçada de aço com componentes de líderes globais para máxima produtividade industrial.
                </p>
            </div>

            <div class="overview-details-grid">
                <div class="overview-detail-card">
                    <div class="overview-detail-card-inner">
                        <div class="overview-detail-icon-box">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div>
                            <h4>{{ 'product_detail.overview_security_title'|trans }}</h4>
                            <p>{{ 'product_detail.overview_security_desc'|trans }}</p>
                        </div>
                    </div>
                </div>

                <div class="overview-detail-card">
                    <div class="overview-detail-card-inner">
                        <div class="overview-detail-icon-box">
                            <i class="fa-solid fa-microchip"></i>
                        </div>
                        <div>
                            <h4>{{ 'product_detail.overview_siemens_title'|trans }}</h4>
                            <p>{{ 'product_detail.overview_siemens_desc'|trans }}</p>
                        </div>
                    </div>
                </div>

                <div class="overview-detail-card">
                    <div class="overview-detail-card-inner">
                        <div class="overview-detail-icon-box">
                            <i class="fa-solid fa-gears"></i>
                        </div>
                        <div>
                            <h4>{{ 'product_detail.overview_bosch_title'|trans }}</h4>
                            <p>{{ 'product_detail.overview_bosch_desc'|trans }}</p>
                        </div>
                    </div>
                </div>

                <div class="overview-detail-card">
                    <div class="overview-detail-card-inner">
                        <div class="overview-detail-icon-box">
                            <i class="fa-solid fa-cube"></i>
                        </div>
                        <div>
                            <h4>{{ 'product_detail.overview_premium_title'|trans }}</h4>
                            <p>{{ 'product_detail.overview_premium_desc'|trans }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Applications (Banners com Imagem) Section -->
        {% if activeSubproduct and activeSubproduct.applications|length > 0 %}
            <section class="product-applications-section scroll-animate slide-top" style="margin-top: 5rem; margin-bottom: 5rem;">
                <div class="overview-header" style="margin-bottom: 3rem; text-align: left;">
                    <span class="section-title-tag">
                        {% if locale == 'en' %}Applications{% elseif locale == 'es' %}Aplicaciones{% else %}Aplicações{% endif %}
                    </span>
                    <h2 style="font-size: 2.2rem; margin-top: 0.8rem; font-weight: 800; font-family: var(--font-heading);">
                        {% if locale == 'en' %}Recommended Applications{% elseif locale == 'es' %}Aplicaciones Recomendadas{% else %}Aplicações Recomendadas{% endif %}
                    </h2>
                    <p style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.6; margin-top: 0.5rem; max-width: 900px;">
                        {% if locale == 'en' %}Our industrial presses serve a wide variety of processes with high efficiency and repeatability.
                        {% elseif locale == 'es' %}Nuestras prensas industriales atienden una amplia variedad de procesos con alta eficiencia y repetibilidad.
                        {% else %}Nossas prensas industriais atendem a uma ampla variedade de processos com alta eficiência e repetibilidade.
                        {% endif %}
                    </p>
                </div>

                <div class="applications-grid">
                    {% for app in activeSubproduct.applications %}
                        <div class="application-card">
                            <div class="application-img-wrapper" style="width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
                                <img src="{% if app.imageName %}/uploads/applications/{{ app.imageName }}{% else %}/uploads/applications/corte.png{% endif %}" alt="{{ app.getName(locale) }}" style="max-width: 100%; max-height: 100%; object-fit: contain; filter: brightness(1.2) contrast(1.1);">
                            </div>
                            <h4 style="text-align: center; margin: 0; color: var(--color-text-primary); font-size: 1rem; font-weight: 700;">{{ app.getName(locale) }}</h4>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <!-- Technical Specifications Table Section (Sem Abas) -->
        {% if productSizes is not empty %}
            <section class="product-specs-section scroll-animate slide-top" style="margin-top: 5rem; margin-bottom: 5rem;">
                <div class="overview-header" style="margin-bottom: 3rem; text-align: left; max-width: 900px;">
                    <span class="section-title-tag">{{ 'product_detail.specs_tag'|trans }}</span>
                    <h2 style="font-size: 2.2rem; margin-top: 0.8rem; font-weight: 800; font-family: var(--font-heading);">
                        {{ 'product_detail.specs_title'|trans }}
                    </h2>
                    <p style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.6; margin-top: 0.5rem; max-width: 900px;">
                        {{ 'product_detail.specs_desc'|trans }}
                    </p>
                </div>

                <div class="specs-table-wrapper">
                    <table class="specs-table">
                        <thead>
                            {% set hasAnySub = false %}
                            {% for size in productSizes %}
                                {% if size.hasVType or size.hasHType %}
                                    {% set hasAnySub = true %}
                                {% endif %}
                            {% endfor %}
                            <tr>
                                <th {% if hasAnySub %}rowspan="2" style="vertical-align: middle;"{% endif %}>{{ 'product_detail.spec_name'|trans }}</th>
                                <th {% if hasAnySub %}rowspan="2" style="vertical-align: middle;"{% endif %}>{{ 'product_detail.spec_unit'|trans }}</th>
                                {% for size in productSizes %}
                                    {% set hasSub = size.hasVType or size.hasHType %}
                                    <th colspan="{{ hasSub ? (size.hasVType ? 1 : 0) + (size.hasHType ? 1 : 0) : 1 }}"
                                        {% if hasAnySub and not hasSub %}rowspan="2" style="vertical-align: middle; text-align: center;"{% else %}style="text-align: center;"{% endif %}>
                                        {{ size.name }}
                                    </th>
                                {% endfor %}
                            </tr>
                            {% if hasAnySub %}
                            <tr>
                                {% for size in productSizes %}
                                    {% if size.hasVType %}
                                        <th style="text-align: center; border-bottom: 2px solid var(--color-accent-red);">V-type</th>
                                    {% endif %}
                                    {% if size.hasHType %}
                                        <th style="text-align: center; border-bottom: 2px solid var(--color-accent-red);">H-type</th>
                                    {% endif %}
                                {% endfor %}
                            </tr>
                            {% endif %}
                        </thead>
                        <tbody>
                            {% for row in specsTableRows %}
                                <tr>
                                    <td>{{ row.specification.getName(locale) }}</td>
                                    <td>{{ row.specification.getUnit(locale) }}</td>
                                    {% for size in productSizes %}
                                        {% if size.hasVType %}
                                            <td style="text-align: center;">{{ row.values[size.id].v ?? '—' }}</td>
                                        {% endif %}
                                        {% if size.hasHType %}
                                            <td style="text-align: center;">{{ row.values[size.id].h ?? '—' }}</td>
                                        {% endif %}
                                        {% if not size.hasVType and not size.hasHType %}
                                            <td style="text-align: center;">{{ row.values[size.id].v ?? '—' }}</td>
                                        {% endif %}
                                    {% endfor %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <p style="margin-top: 1rem; font-size: 0.85rem; color: var(--color-text-secondary); font-style: italic;">
                    {{ 'product_detail.footnote'|trans }}
                </p>
            </section>
        {% endif %}

        <!-- ================================================================= -->
        <!-- THREE NEW SUBPRODUCT ITEM SECTIONS (Standard, Applications, Optionals) -->
        <!-- Below Parâmetros Técnicos, Above Vídeos de Operação -->
        <!-- ================================================================= -->

        {% if activeSubproduct %}

            <!-- 1. ITENS DE SÉRIE (STANDARD ITEMS) -->
            {% if activeSubproduct.standardItems|length > 0 %}
                <section class="subproduct-standard-items-section scroll-animate slide-top" style="margin-top: 5rem; margin-bottom: 4rem;">
                    <div class="overview-header" style="margin-bottom: 3rem; text-align: left; max-width: 900px;">
                        <span class="section-title-tag">
                            {% if locale == 'en' %}FACTORY STANDARD EQUIPMENT{% elseif locale == 'es' %}EQUIPAMIENTO DE FÁBRICA{% else %}EQUIPAMENTO DE FÁBRICA{% endif %}
                        </span>
                        <h2 style="font-size: 2.2rem; margin-top: 0.8rem; font-weight: 800; font-family: var(--font-heading);">
                            {% if locale == 'en' %}Standard Items & Features{% elseif locale == 'es' %}Ítems de Serie del Equipo{% else %}Itens de Série do Equipamento{% endif %}
                        </h2>
                        <p style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.6; margin-top: 0.5rem; max-width: 900px;">
                            {% if locale == 'en' %}Factory-integrated safety systems, controls, and premium components included standard with model {{ activeSubproduct.model }}.
                            {% elseif locale == 'es' %}Sistemas de seguridad, mandos y componentes de alta calidad integrados de fábrica en el modelo {{ activeSubproduct.model }}.
                            {% else %}Sistemas de segurança, comandos e componentes integrados de fábrica neste modelo {{ activeSubproduct.model }} para garantir máxima eficiência.
                            {% endif %}
                        </p>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem;">
                        {% for item in activeSubproduct.standardItems %}
                            <div style="background: var(--color-surface-dark); border-left: 4px solid #3b82f6; border-top: 1px solid var(--color-border); border-right: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); border-radius: 10px; padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-card-subtle); transition: transform 0.3s ease, box-shadow 0.3s ease;"
                                 onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 10px 25px rgba(59, 130, 246, 0.15)';"
                                 onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow-card-subtle)';">
                                <div style="width: 44px; height: 44px; min-width: 44px; border-radius: 10px; background: rgba(59, 130, 246, 0.12); color: #3b82f6; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                                    <i class="{{ item.icon ?: 'fa-solid fa-check' }}"></i>
                                </div>
                                <div style="flex-grow: 1;">
                                    <h4 style="margin: 0; font-size: 1rem; font-weight: 700; color: var(--color-text-primary); line-height: 1.4;">
                                        {{ item.getName(locale) }}
                                    </h4>
                                    <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; color: #3b82f6; opacity: 0.85;">
                                        {% if locale == 'en' %}In-Series{% elseif locale == 'es' %}De Serie{% else %}De Série{% endif %}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            <!-- 2. APLICAÇÕES (LISTAGEM) -->
            {% if activeSubproduct.applicationListItems|length > 0 %}
                <section class="subproduct-applications-section scroll-animate slide-top" style="margin-top: 5rem; margin-bottom: 4rem;">
                    <div class="overview-header" style="margin-bottom: 3rem; text-align: left; max-width: 900px;">
                        <span class="section-title-tag">
                            {% if locale == 'en' %}OPERATIONAL VERSATILITY{% elseif locale == 'es' %}VERSATILIDAD OPERATIVA{% else %}VERSATILIDADE OPERACIONAL{% endif %}
                        </span>
                        <h2 style="font-size: 2.2rem; margin-top: 0.8rem; font-weight: 800; font-family: var(--font-heading);">
                            {% if locale == 'en' %}Recommended Applications{% elseif locale == 'es' %}Aplicaciones Recomendadas{% else %}Aplicações Recomendadas{% endif %}
                        </h2>
                        <p style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.6; margin-top: 0.5rem; max-width: 900px;">
                            {% if locale == 'en' %}Industrial operations, manufacturing processes, and materials optimized for model {{ activeSubproduct.model }}.
                            {% elseif locale == 'es' %}Operaciones industriales, procesos de fabricación y materiales ideales para el modelo {{ activeSubproduct.model }}.
                            {% else %}Processos produtivos, operações industriais e materiais especialmente indicados para o modelo {{ activeSubproduct.model }}.
                            {% endif %}
                        </p>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem;">
                        {% for app in activeSubproduct.applicationListItems %}
                            <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.04), var(--color-surface-dark)); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 14px; padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-card-subtle); transition: all 0.3s ease;"
                                 onmouseover="this.style.transform='translateY(-3px)'; this.style.borderColor='rgba(16, 185, 129, 0.6)'; this.style.boxShadow='0 10px 25px rgba(16, 185, 129, 0.15)';"
                                 onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='rgba(16, 185, 129, 0.25)'; this.style.boxShadow='var(--shadow-card-subtle)';">
                                <div style="width: 48px; height: 48px; min-width: 48px; border-radius: 12px; background: rgba(16, 185, 129, 0.12); color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
                                    <i class="{{ app.icon ?: 'fa-solid fa-industry' }}"></i>
                                </div>
                                <div>
                                    <h4 style="margin: 0; font-size: 1rem; font-weight: 700; color: var(--color-text-primary); line-height: 1.4;">
                                        {{ app.getName(locale) }}
                                    </h4>
                                    <span style="font-size: 0.72rem; font-weight: 600; color: #10b981;">
                                        <i class="fa-solid fa-circle-check" style="font-size: 0.65rem; margin-right: 4px;"></i>
                                        {% if locale == 'en' %}Optimized{% elseif locale == 'es' %}Recomendado{% else %}Recomendado{% endif %}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            <!-- 3. ITENS OPCIONAIS (OPTIONAL ITEMS) -->
            {% if activeSubproduct.optionalItems|length > 0 %}
                <section class="subproduct-optional-items-section scroll-animate slide-top" style="margin-top: 5rem; margin-bottom: 5rem;">
                    <div class="overview-header" style="margin-bottom: 3rem; text-align: left; max-width: 900px;">
                        <span class="section-title-tag">
                            {% if locale == 'en' %}TAILORED CUSTOMIZATION{% elseif locale == 'es' %}CONFIGURACIÓN OPCIONAL{% else %}PERSONALIZAÇÃO SOB MEDIDA{% endif %}
                        </span>
                        <h2 style="font-size: 2.2rem; margin-top: 0.8rem; font-weight: 800; font-family: var(--font-heading);">
                            {% if locale == 'en' %}Optional Equipment & Peripherals{% elseif locale == 'es' %}Ítems Opcionales y Periféricos{% else %}Itens Opcionais e Periféricos{% endif %}
                        </h2>
                        <p style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.6; margin-top: 0.5rem; max-width: 900px;">
                            {% if locale == 'en' %}Custom automation features, sensors, extra cylinders, and specialized tooling controls for model {{ activeSubproduct.model }}.
                            {% elseif locale == 'es' %}Automatización avanzada, sensores, cilindros auxiliares y accesorios especializados para el modelo {{ activeSubproduct.model }}.
                            {% else %}Recursos avançados de automação, sensores, cilindros auxiliares e periféricos sob medida para o modelo {{ activeSubproduct.model }}.
                            {% endif %}
                        </p>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem;">
                        {% for item in activeSubproduct.optionalItems %}
                            <div style="background: rgba(245, 158, 11, 0.03); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 12px; padding: 1.25rem 1.5rem; display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-card-subtle); transition: all 0.3s ease;"
                                 onmouseover="this.style.transform='translateY(-3px)'; this.style.borderColor='rgba(245, 158, 11, 0.6)'; this.style.boxShadow='0 10px 25px rgba(245, 158, 11, 0.15)';"
                                 onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='rgba(245, 158, 11, 0.25)'; this.style.boxShadow='var(--shadow-card-subtle)';">
                                <div style="width: 44px; height: 44px; min-width: 44px; border-radius: 10px; background: rgba(245, 158, 11, 0.12); color: #f59e0b; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
                                    <i class="{{ item.icon ?: 'fa-solid fa-plus-circle' }}"></i>
                                </div>
                                <div style="flex-grow: 1;">
                                    <h4 style="margin: 0; font-size: 1rem; font-weight: 700; color: var(--color-text-primary); line-height: 1.4;">
                                        {{ item.getName(locale) }}
                                    </h4>
                                    <span style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; color: #f59e0b; opacity: 0.9;">
                                        {% if locale == 'en' %}Optional{% elseif locale == 'es' %}Opcional{% else %}Opcional{% endif %}
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

        {% endif %}

        <!-- Operational Videos Section (Always Visible) -->
        {% if productVideos is not empty %}
            <section class="product-videos-section scroll-animate slide-top" style="margin-top: 5rem; margin-bottom: 5rem; border-top: 1px solid var(--color-border); padding-top: 4rem;">
                <div class="overview-header" style="margin-bottom: 3rem;">
                    <span class="section-title-tag">Vídeos</span>
                    <h2 style="font-size: 2.2rem; margin-top: 0.8rem; font-weight: 800; font-family: var(--font-heading);">Vídeos de Operação e Demonstração</h2>
                    <p style="color: var(--color-text-secondary); font-size: 1.1rem; line-height: 1.6; margin-top: 0.5rem; max-width: 900px;">
                        Assista aos nossos equipamentos em funcionamento e comprove a robustez, velocidade e silêncio operacional das nossas máquinas.
                    </p>
                </div>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem; width: 100%;">
                    {% for video in productVideos %}
                        <div class="video-card" style="background: var(--color-surface-dark); border-radius: 16px; border: 1px solid var(--color-border); padding: 1.5rem; box-shadow: var(--shadow-card-subtle);">
                            {% if video.getTitle(locale) %}
                                <h4 style="margin-top: 0; margin-bottom: 1rem; font-size: 1.15rem; font-family: var(--font-heading); color: var(--color-text-primary); font-weight: 700;">
                                    <i class="fa-solid fa-play" style="color: var(--color-accent-red); margin-right: 8px;"></i>
                                    {{ video.getTitle(locale) }}
                                </h4>
                            {% endif %}
                            
                            <div class="video-wrapper" style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 10px;">
                                {% if 'youtube.com' in video.url or 'youtu.be' in video.url %}
                                    {% set ytId = '' %}
                                    {% if 'youtu.be/' in video.url %}
                                        {% set ytId = video.url|split('youtu.be/')[1]|split('?')[0] %}
                                    {% elseif 'v=' in video.url %}
                                        {% set ytId = video.url|split('v=')[1]|split('&')[0] %}
                                    {% elseif 'embed/' in video.url %}
                                        {% set ytId = video.url|split('embed/')[1]|split('?')[0] %}
                                    {% endif %}
                                    {% if ytId %}
                                        <iframe src="https://www.youtube.com/embed/{{ ytId }}" frameborder="0" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"></iframe>
                                    {% else %}
                                        <a href="{{ video.url }}" target="_blank" style="color: var(--color-accent-red);">{{ video.url }}</a>
                                    {% endif %}
                                {% else %}
                                    <video controls preload="metadata" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;">
                                        <source src="{{ video.url }}" type="video/mp4">
                                        Your browser does not support the video tag.
                                    </video>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        <!-- Modelos Section -->
        <section class="subproducts-section">
            <div class="section-header scroll-animate slide-top">
                <span class="section-title-tag">{{ 'product_detail.models_tag'|trans }}</span>
                <h2 class="section-title">{{ 'product_detail.models_title'|trans }}</h2>
                <p class="section-desc">{{ 'product_detail.models_desc'|trans }}</p>
            </div>
            
            <div class="subproducts-grid">
                {% for sub in product.subproducts %}
                    {% set is_active = (activeSubproduct and sub.model == activeSubproduct.model) %}
                    <div class="subproduct-card scroll-animate slide-top {% if is_active %}active-subproduct{% endif %}"
                         style="{% if is_active %}border: 2px solid var(--color-accent-red); box-shadow: 0 10px 25px rgba(213, 28, 35, 0.15); transform: translateY(-4px);{% endif %}">
                        
                        {% if not is_active %}
                            <a href="{{ path('app_product_detail', {'_locale': locale, 'slug': product.slug, 'model': sub.model}) }}" class="subproduct-card-link" style="text-decoration: none; color: inherit; display: block;">
                        {% endif %}
                        
                        <div class="product-image-container" style="aspect-ratio: 16/11; border-radius: 8px; margin-bottom: 1.5rem; overflow: hidden; border: 1px solid var(--color-border);">
                            <img src="{% if sub.imageName %}/uploads/products/{{ sub.imageName }}{% else %}/images/prensa-hidraulica-tipo-c-linha-st.png{% endif %}" alt="{{ sub.getName(locale) }}" loading="lazy" style="width: 100%; height: 100%; object-fit: contain; background: var(--color-surface-dark); padding: 0.5rem;">
                        </div>
                        <span class="subproduct-model">{{ sub.model }}</span>
                        <h4 style="margin-top: 0.5rem; font-family: var(--font-heading); font-weight: 700; color: var(--color-text-primary);">{{ sub.getName(locale) }}</h4>
                        
                        {% if not is_active %}
                            </a>
                        {% endif %}
                        
                        <p style="margin-top: 0.5rem; margin-bottom: 1rem; color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.5;">{{ sub.getDescription(locale) }}</p>
                        <span class="subproduct-tag-detail">{{ sub.tag }}</span>
                        
                        <div style="margin-top: 1.5rem; display: flex; gap: 0.5rem; align-items: center;">
                            {% if is_active %}
                                <wa-button variant="brand" size="small" href="#quote-product-form" onclick="document.getElementById('p-model').value = '{{ sub.model|lower }}';">
                                    {{ 'cta.quote_now'|trans }}
                                </wa-button>
                                <span style="font-size: 0.75rem; color: var(--color-accent-red); font-weight: 700; text-transform: uppercase; margin-left: auto; letter-spacing: 0.5px;">Atual</span>
                            {% else %}
                                <wa-button variant="neutral" size="small" outline href="{{ path('app_product_detail', {'_locale': locale, 'slug': product.slug, 'model': sub.model}) }}">
                                    {{ 'cta.learn_more'|trans }}
                                </wa-button>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>

        <!-- Product Quote Form -->
        <section id="quote-product-form" class="section-padding scroll-animate slide-top" style="background-color: var(--color-surface-dark); border: 1px solid var(--color-border); border-radius: 16px; padding: 4rem; margin-top: 6rem;">
            <div class="section-header" style="margin-bottom: 3rem;">
                <span class="section-title-tag">{{ 'contact_form.commercial_heading'|trans }}</span>
                <h2>{{ 'contact_form.request_quote_heading'|trans }}</h2>
                <p>{{ 'contact_form.request_quote_desc'|trans }}</p>
            </div>
            
            <form id="quote-product-form-element" data-turbo="false" style="max-width: 600px; margin: 0 auto;">
                <div class="form-group">
                    <wa-input id="p-name" type="text" label="{{ 'contact_form.name'|trans }}" placeholder="Ex: Engenharia Mecânica Ltda" required></wa-input>
                </div>
                <div class="form-group">
                    <wa-input id="p-email" type="email" label="{{ 'contact_form.email'|trans }}" placeholder="comercial@suaempresa.com" required></wa-input>
                </div>
                <div class="form-group">
                    <wa-input id="p-phone" type="tel" label="{{ 'contact_form.phone'|trans }}" placeholder="(16) 99999-9999" required></wa-input>
                </div>
                <div class="form-group">
                    <wa-input id="p-cnpj" type="text" label="CPF / CNPJ" placeholder="Digite apenas números (11 ou 14 dígitos)" required></wa-input>
                </div>
                <div class="form-group">
                    <wa-select id="p-model" label="{{ 'contact_form.selected_model'|trans }}" value="{{ activeSubproduct ? activeSubproduct.model|lower : '' }}">
                        {% for sub in product.subproducts %}
                            <wa-option value="{{ sub.model|lower }}">{{ sub.model }} ({{ sub.getName(locale) }})</wa-option>
                        {% endfor %}
                    </wa-select>
                </div>
                <div class="form-group">
                    <wa-textarea id="p-message" label="{{ 'contact_form.message'|trans }}" placeholder="Especificações adicionais (ex: profundidade da garganta customizada, almofada de estampagem, etc.)"></wa-textarea>
                </div>
                
                <wa-button id="p-submit-btn" type="submit" variant="brand" style="width: 100%;">
                    {{ 'cta.submit'|trans }}
                </wa-button>
                <div id="p-status-message" style="margin-top: 1.5rem; padding: 1rem; border-radius: 8px; display: none;"></div>
            </form>
        </section>
    </div>

    <!-- AJAX & Validation Script -->
    <script>
        function initProductQuoteForm() {
            const form = document.getElementById('quote-product-form-element');
            const submitBtn = document.getElementById('p-submit-btn');
            const statusMsg = document.getElementById('p-status-message');

            if (!form || !submitBtn) return;
            if (form.dataset.initialized === 'true') return;
            form.dataset.initialized = 'true';

            function validateCPF(cpf) {
                cpf = cpf.replace(/[^\d]+/g,'');
                if(cpf == '') return false;
                if (cpf.length != 11 || 
                    cpf == "00000000000" || 
                    cpf == "11111111111" || 
                    cpf == "22222222222" || 
                    cpf == "33333333333" || 
                    cpf == "44444444444" || 
                    cpf == "55555555555" || 
                    cpf == "66666666666" || 
                    cpf == "77777777777" || 
                    cpf == "88888888888" || 
                    cpf == "99999999999")
                        return false;		
                let add = 0;	
                for (let i=0; i < 9; i++)		
                    add += parseInt(cpf.charAt(i)) * (10 - i);	
                let rev = 11 - (add % 11);	
                if (rev == 10 || rev == 11)		
                    rev = 0;	
                if (rev != parseInt(cpf.charAt(9)))		
                    return false;		
                add = 0;	
                for (let i = 0; i < 10; i++)		
                    add += parseInt(cpf.charAt(i)) * (11 - i);	
                rev = 11 - (add % 11);	
                if (rev == 10 || rev == 11)	
                    rev = 0;	
                if (rev != parseInt(cpf.charAt(10)))
                    return false;		
                return true;   
            }

            function validateCNPJ(cnpj) {
                cnpj = cnpj.replace(/[^\d]+/g,'');
                if(cnpj == '') return false;
                if (cnpj.length != 14)
                    return false;
                if (cnpj == "00000000000000" || 
                    cnpj == "11111111111111" || 
                    cnpj == "22222222222222" || 
                    cnpj == "33333333333333" || 
                    cnpj == "44444444444444" || 
                    cnpj == "55555555555555" || 
                    cnpj == "66666666666666" || 
                    cnpj == "77777777777777" || 
                    cnpj == "88888888888888" || 
                    cnpj == "99999999999999")
                    return false;
                let tamanho = cnpj.length - 2
                let numeros = cnpj.substring(0,tamanho);
                let digitos = cnpj.substring(tamanho);
                let soma = 0;
                let pos = tamanho - 7;
                for (let i = tamanho; i >= 1; i--) {
                  soma += numeros.charAt(tamanho - i) * pos--;
                  if (pos < 2)
                        pos = 9;
                }
                let resultado = soma % 11 < 2 ? 0 : 11 - (soma % 11);
                if (resultado != digitos.charAt(0))
                    return false;
                tamanho = tamanho + 1;
                numeros = cnpj.substring(0,tamanho);
                soma = 0;
                pos = tamanho - 7;
                for (let i = tamanho; i >= 1; i--) {
                  soma += numeros.charAt(tamanho - i) * pos--;
                  if (pos < 2)
                        pos = 9;
                }
                resultado = soma % 11 < 2 ? 0 : 11 - (soma % 11);
                if (resultado != digitos.charAt(1))
                      return false;
                return true;
            }

            function showStatus(type, msg) {
                if (type === 'success') {
                    statusMsg.style.backgroundColor = '#def7ec';
                    statusMsg.style.color = '#03543f';
                    statusMsg.style.border = '1px solid #bcf0da';
                    statusMsg.innerHTML = '<i class="fa-solid fa-circle-check" style="margin-right: 8px;"></i>' + msg;
                } else if (type === 'warning') {
                    statusMsg.style.backgroundColor = '#feecdc';
                    statusMsg.style.color = '#9a3412';
                    statusMsg.style.border = '1px solid #fbd5d5';
                    statusMsg.innerHTML = '<i class="fa-solid fa-triangle-exclamation" style="margin-right: 8px;"></i>' + msg;
                } else {
                    statusMsg.style.backgroundColor = '#fde8e8';
                    statusMsg.style.color = '#9b1c1c';
                    statusMsg.style.border = '1px solid #f8b4b4';
                    statusMsg.innerHTML = '<i class="fa-solid fa-circle-exclamation" style="margin-right: 8px;"></i>' + msg;
                }
                statusMsg.style.display = 'block';
                statusMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            async function handleProductFormSubmit(e) {
                if (e) e.preventDefault();
                if (e) e.stopPropagation();
                statusMsg.style.display = 'none';

                const nameInput = document.getElementById('p-name');
                const emailInput = document.getElementById('p-email');
                const phoneInput = document.getElementById('p-phone');
                const cnpjInput = document.getElementById('p-cnpj');
                const modelSelect = document.getElementById('p-model');
                const messageInput = document.getElementById('p-message');

                const name = (nameInput.value || '').trim();
                const email = (emailInput.value || '').trim();
                const phone = (phoneInput.value || '').trim();
                const docVal = (cnpjInput.value || '').trim().replace(/[^\d]+/g,'');
                const model = (modelSelect.value || '');
                const message = (messageInput.value || '').trim();

                function validateEmail(emailStr) {
                    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailStr);
                }

                if (!name || name.length < 3) {
                    showStatus('error', 'Por favor, informe seu nome completo.');
                    return;
                }

                if (!email || !validateEmail(email)) {
                    showStatus('error', 'Por favor, informe um endereço de e-mail válido (ex: nome@empresa.com.br).');
                    return;
                }

                const phoneDigits = phone.replace(/[^\d]+/g, '');
                if (!phone || phoneDigits.length < 8) {
                    showStatus('error', 'Por favor, informe um número de telefone/WhatsApp válido com DDD.');
                    return;
                }

                if (!docVal) {
                    showStatus('error', 'Por favor, informe o CPF ou CNPJ.');
                    return;
                }

                if (docVal.length === 11) {
                    if (!validateCPF(docVal)) {
                        showStatus('error', 'O CPF informado é inválido. Verifique os dígitos.');
                        return;
                    }
                } else if (docVal.length === 14) {
                    if (!validateCNPJ(docVal)) {
                        showStatus('error', 'O CNPJ informado é inválido. Verifique os dígitos.');
                        return;
                    }
                } else {
                    showStatus('error', 'Insira um CPF (11 dígitos) ou CNPJ (14 dígitos) válido.');
                    return;
                }

                submitBtn.setAttribute('loading', '');
                submitBtn.disabled = true;

                try {
                    const response = await fetch('{{ path('app_contact_submit', {'_locale': locale}) }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json'
                        },
                        body: JSON.stringify({
                            name,
                            email,
                            phone,
                            cpf_cnpj: docVal,
                            product_interest: model.toUpperCase(),
                            product_slug: '{{ product.slug }}',
                            message,
                            type: 'quote'
                        })
                    });

                    const resData = await response.json();
                    submitBtn.removeAttribute('loading');
                    submitBtn.disabled = false;

                    if (resData.success) {
                        const statusType = resData.mail_sent === false ? 'warning' : 'success';
                        showStatus(statusType, resData.message);
                        form.querySelectorAll('wa-input, wa-textarea').forEach(el => { el.value = ''; });
                    } else {
                        showStatus('error', 'Ocorreu um erro: ' + resData.message);
                    }
                } catch (error) {
                    submitBtn.removeAttribute('loading');
                    submitBtn.disabled = false;
                    showStatus('error', 'Erro de conexão com o servidor. Tente novamente.');
                }
            }

            form.addEventListener('submit', handleProductFormSubmit);

            submitBtn.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                handleProductFormSubmit(e);
            });
        }

        document.addEventListener('DOMContentLoaded', initProductQuoteForm);
        document.addEventListener('turbo:load', initProductQuoteForm);
    </script>
{% endblock %}
