{% extends 'base.html.twig' %}

{% block title %}{{ item.getSeoTitle(locale) ?: item.getTitle(locale) }} - Pressmatik{% endblock %}
{% block meta_description %}{{ item.getSeoDescription(locale) ?: (item.getShortDescription(locale) ?: item.getTitle(locale)) }}{% endblock %}
{% block og_title %}{{ item.getTitle(locale) }} - Pressmatik{% endblock %}
{% block og_description %}{{ item.getShortDescription(locale) ?: item.getTitle(locale) }}{% endblock %}
{% block og_image %}{% if item.imageName %}{{ app.request.schemeAndHttpHost }}/uploads/news/{{ item.imageName }}{% else %}{{ parent() }}{% endif %}{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        "headline": "{{ item.getTitle(locale) }}",
        "description": "{{ item.getShortDescription(locale) ?: item.getTitle(locale) }}",
        "datePublished": "{{ item.date ? item.date|date('Y-m-d') : '' }}",
        "image": [
            "{% if item.imageName %}{{ app.request.schemeAndHttpHost }}/uploads/news/{{ item.imageName }}{% else %}{{ app.request.schemeAndHttpHost }}/images/logo.png{% endif %}"
        ],
        "publisher": {
            "@type": "Organization",
            "name": "Pressmatik",
            "logo": {
                "@type": "ImageObject",
                "url": "{{ app.request.schemeAndHttpHost }}/images/logos/PRESSMATIK_LOGO2_HORIZONTAL_SEGMENTOBASE_VERMELHO.png"
            }
        }
    }
    </script>
{% endblock %}

{% block body %}
    <div class="container product-detail-layout" style="margin-top: 3rem; margin-bottom: 6rem; max-width: 900px;">
        <!-- Breadcrumbs -->
        <div class="breadcrumbs scroll-animate slide-left" style="margin-bottom: 2rem;">
            <a href="{{ path('app_home', {'_locale': locale}) }}">{{ 'menu.home'|trans }}</a>
            <span>/</span>
            <a href="{{ path('app_news_list', {'_locale': locale}) }}">{{ 'news.tag'|trans }}</a>
            <span>/</span>
            <span style="color: var(--color-accent-red); max-width: 300px; display: inline-block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom;">{{ item.getTitle(locale) }}</span>
        </div>

        <!-- News Header Area -->
        <div class="news-detail-header scroll-animate slide-top" style="margin-bottom: 2.5rem;">
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
                {% for cat in item.categories %}
                    <span style="font-size: 0.75rem; font-weight: 700; color: var(--color-accent-red); text-transform: uppercase; letter-spacing: 0.5px;">{{ cat.getName(locale) }}</span>
                {% endfor %}
            </div>
            
            <h1 style="font-size: 2.5rem; font-family: var(--font-heading); font-weight: 700; color: var(--color-text-primary); line-height: 1.25; margin-bottom: 1rem;">
                {{ item.getTitle(locale) }}
            </h1>
            
            <div style="font-size: 0.85rem; color: var(--color-text-secondary); display: flex; align-items: center; gap: 1.5rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem;">
                <span><i class="bi bi-calendar-event" style="margin-right: 0.35rem; color: var(--color-accent-red);"></i>{{ item.date ? item.date|date('d/m/Y') : '' }}</span>
                <span><i class="bi bi-clock" style="margin-right: 0.35rem; color: var(--color-accent-red);"></i>Leitura rápida</span>
            </div>
        </div>

        <!-- Main Featured Image -->
        {% if item.imageName %}
        <div class="news-detail-featured-img scroll-animate slide-top" style="border-radius: 12px; overflow: hidden; border: 1px solid var(--color-border); margin-bottom: 3rem; background: #000; max-height: 500px;">
            <img src="{{ ('/uploads/news/' ~ item.imageName)|webp }}" alt="{{ item.getImageAlt(locale) ?: item.getTitle(locale) }}" width="800" height="450" style="width: 100%; height: auto; display: block; object-fit: contain; max-height: 500px; margin: auto;" fetchpriority="high" decoding="async">
        </div>
        {% endif %}

        <!-- Body Content -->
        <div class="news-detail-body scroll-animate slide-top" style="color: var(--color-text-primary); font-size: 1.1rem; line-height: 1.8; margin-bottom: 4rem;">
            {% if item.getShortDescription(locale) %}
            <p style="font-size: 1.25rem; font-weight: 500; color: var(--color-text-primary); margin-bottom: 2rem; border-left: 4px solid var(--color-accent-red); padding-left: 1.5rem; line-height: 1.6;">
                {{ item.getShortDescription(locale) }}
            </p>
            {% endif %}
            
            <div style="text-align: justify; white-space: pre-line;">
                {{ item.getFullDescription(locale) }}
            </div>
        </div>

        <!-- Gallery / Photo Slider (only if there are images) -->
        {% if item.images|length > 0 %}
        <section class="news-gallery-section scroll-animate slide-top" style="margin-bottom: 4rem; border-top: 1px solid var(--color-border); pt-3rem; padding-top: 3rem;">
            <h2 style="font-size: 1.75rem; font-family: var(--font-heading); font-weight: 700; color: var(--color-text-primary); text-align: center; margin-bottom: 2rem;">
                Galeria de Fotos
            </h2>
            
            <div style="position: relative; max-width: 800px; margin: 0 auto;">
                <wa-carousel navigation pagination loop mouse-dragging style="width: 100%; border-radius: 12px; overflow: hidden; border: 1px solid var(--color-border);">
                    {% for img in item.images|sort((a, b) => a.position <=> b.position) %}
                        <wa-carousel-item style="display: flex; flex-direction: column; background: var(--color-surface-dark);">
                            <div style="aspect-ratio: 16/10; width: 100%; display: flex; align-items: center; justify-content: center; background: #0a0e17;">
                                <img src="/uploads/gallery/{{ img.imageName }}" alt="{{ img.getCaption(locale) }}" style="max-width: 100%; max-height: 100%; object-fit: contain; display: block;">
                            </div>
                            {% if img.getCaption(locale) %}
                                <div style="background: rgba(11, 15, 23, 0.95); color: var(--color-text-secondary); padding: 1rem; font-size: 0.9rem; text-align: center; border-top: 1px solid var(--color-border);">
                                    {{ img.getCaption(locale) }}
                                </div>
                            {% endif %}
                        </wa-carousel-item>
                    {% endfor %}
                </wa-carousel>
            </div>
        </section>
        {% endif %}

        <!-- Video Embed Area -->
        {% if item.youtubeVideoCode %}
        <section class="news-video-section scroll-animate slide-top" style="margin-bottom: 4rem; border-top: 1px solid var(--color-border); padding-top: 3rem;">
            <h2 style="font-size: 1.75rem; font-family: var(--font-heading); font-weight: 700; color: var(--color-text-primary); text-align: center; margin-bottom: 2rem;">
                Vídeo Relacionado
            </h2>
            <div style="aspect-ratio: 16/9; width: 100%; border-radius: 12px; overflow: hidden; border: 1px solid var(--color-border); background: #000; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);">
                <iframe src="https://www.youtube.com/embed/{{ item.youtubeVideoCode }}" title="YouTube video player" frameborder="0" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen style="width: 100%; height: 100%;"></iframe>
            </div>
        </section>
        {% endif %}
    </div>
{% endblock %}
