    <!-- Contato (Contact & Form) Section -->
    <section id="contact" class="section-padding contact-section">
        <div class="container contact-grid">
            <div class="contact-info-column scroll-animate slide-left">
                <span class="section-title-tag">{{ 'contact_form.tag'|trans }}</span>
                <h2>{{ 'contact_form.title'|trans }}</h2>
                <p>{{ 'contact_form.request_quote_desc'|trans }}</p>
                
                <div class="contact-details">
                    <div class="contact-item">
                        <i class="bi bi-geo-alt contact-item-icon"></i>
                        <div class="contact-item-text">
                            <h4>{{ 'footer.address_title'|trans }}</h4>
                            <p>{{ 'footer.address_factory'|trans }}</p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <i class="bi bi-telephone contact-item-icon"></i>
                        <div class="contact-item-text">
                            <h4>{{ 'menu.contact'|trans }}</h4>
                            <p>{{ 'footer.phone'|trans }}</p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <i class="bi bi-envelope contact-item-icon"></i>
                        <div class="contact-item-text">
                            <h4>E-mail Comercial</h4>
                            <p>{{ 'footer.email'|trans }}</p>
                        </div>
                    </div>
                </div>

                <!-- Google Map -->
                <div class="map-container">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3704.126178620653!2d-48.15148342472135!3d-21.814055180039055!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94b8f3ca207bffe5%3A0x8f549c30f9c2e200!2sPressmatik%20Prensas%20e%20Equipamentos%20Hidr%C3%A1ulicos!5e0!3m2!1spt-BR!2sbr!4v1782507981053!5m2!1spt-BR!2sbr" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
                </div>
            </div>

            <div class="contact-form-column scroll-animate slide-right">
                <h3>{{ 'cta.quote_now'|trans }}</h3>
                <form id="quote-form">
                    <div class="form-group">
                        <wa-input id="form-name" type="text" label="{{ 'contact_form.name'|trans }}" placeholder="Ex: João Silva" required></wa-input>
                    </div>
                    <div class="form-group">
                        <wa-input id="form-email" type="email" label="{{ 'contact_form.email'|trans }}" placeholder="nome@suaempresa.com.br" required></wa-input>
                    </div>
                    <div class="form-group">
                        <wa-input id="form-phone" type="tel" label="{{ 'contact_form.phone'|trans }}" placeholder="(16) 99999-9999" required></wa-input>
                    </div>
                    <div class="form-group">
                        <wa-input id="form-cnpj" type="text" label="CPF / CNPJ" placeholder="Digite apenas números (11 ou 14 dígitos)" required></wa-input>
                    </div>
                    <div class="form-group">
                        <wa-input id="form-product" type="text" label="{{ 'contact_form.product_interest'|trans }}" placeholder="Ex: PMC-ST 60 Toneladas"></wa-input>
                    </div>
                    <div class="form-group">
                        <wa-textarea id="form-message" label="{{ 'contact_form.message'|trans }}" placeholder="Descreva os requisitos técnicos da prensa..."></wa-textarea>
                    </div>
                    <wa-button id="form-submit-btn" type="submit" variant="brand" style="width: 100%;">
                        {{ 'cta.submit'|trans }}
                    </wa-button>
                    <div id="form-status-message" style="margin-top: 1.5rem; padding: 1rem; border-radius: 8px; display: none;"></div>
                </form>
            </div>
        </div>
    </section>

    <!-- AJAX & Validation Script for Contact Form -->
    <script>
        function initHeroSlider() {
            const slider = document.querySelector('.hero-slider');
            if (!slider) return;

            const slides = Array.from(slider.querySelectorAll('.hero-slide'));
            const dots = Array.from(document.querySelectorAll('.hero-dot'));
            const prevBtn = document.querySelector('.hero-prev-btn');
            const nextBtn = document.querySelector('.hero-next-btn');

            if (slides.length <= 1) return;

            let currentIndex = 0;
            let timer = null;

            function showSlide(index) {
                slides[currentIndex].classList.remove('active');
                if (dots[currentIndex]) dots[currentIndex].classList.remove('active');

                currentIndex = (index + slides.length) % slides.length;

                slides[currentIndex].classList.add('active');
                if (dots[currentIndex]) dots[currentIndex].classList.add('active');
            }

            function startAutoplay() {
                stopAutoplay();
                timer = setInterval(() => {
                    showSlide(currentIndex + 1);
                }, 6000);
            }

            function stopAutoplay() {
                if (timer) {
                    clearInterval(timer);
                    timer = null;
                }
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', () => {
                    showSlide(currentIndex - 1);
                    startAutoplay();
                });
            }
            if (nextBtn) {
                nextBtn.addEventListener('click', () => {
                    showSlide(currentIndex + 1);
                    startAutoplay();
                });
            }

            dots.forEach((dot, idx) => {
                dot.addEventListener('click', () => {
                    showSlide(idx);
                    startAutoplay();
                });
            });

            startAutoplay();
        }

        document.addEventListener('turbo:load', initHeroSlider);

        document.addEventListener('DOMContentLoaded', () => {
            initHeroSlider();
            const form = document.getElementById('quote-form');
            const submitBtn = document.getElementById('form-submit-btn');
            const statusMsg = document.getElementById('form-status-message');

            function validateCPF(cpf) {
                cpf = cpf.replace(/[^\d]+/g,'');
                if(cpf == '') return false;
                if (cpf.length != 11 || 
                    cpf == "00000000000" || 
                    cpf == "11111111111" || 
                    cpf == "22222222222" || 
                    cpf == "33333333333" || 
                    cpf == "44444444444" || 
                    cpf == "55555555555" || 
                    cpf == "66666666666" || 
                    cpf == "77777777777" || 
                    cpf == "88888888888" || 
                    cpf == "99999999999")
                        return false;		
                let add = 0;	
                for (let i=0; i < 9; i++)		
                    add += parseInt(cpf.charAt(i)) * (10 - i);	
                let rev = 11 - (add % 11);	
                if (rev == 10 || rev == 11)		
                    rev = 0;	
                if (rev != parseInt(cpf.charAt(9)))		
                    return false;		
                add = 0;	
                for (let i = 0; i < 10; i++)		
                    add += parseInt(cpf.charAt(i)) * (11 - i);	
                rev = 11 - (add % 11);	
                if (rev == 10 || rev == 11)	
                    rev = 0;	
                if (rev != parseInt(cpf.charAt(10)))
                    return false;		
                return true;   
            }

            function validateCNPJ(cnpj) {
                cnpj = cnpj.replace(/[^\d]+/g,'');
                if(cnpj == '') return false;
                if (cnpj.length != 14)
                    return false;
                if (cnpj == "00000000000000" || 
                    cnpj == "11111111111111" || 
                    cnpj == "22222222222222" || 
                    cnpj == "33333333333333" || 
                    cnpj == "44444444444444" || 
                    cnpj == "55555555555555" || 
                    cnpj == "66666666666666" || 
                    cnpj == "77777777777777" || 
                    cnpj == "88888888888888" || 
                    cnpj == "99999999999999")
                    return false;
                let tamanho = cnpj.length - 2
                let numeros = cnpj.substring(0,tamanho);
                let digitos = cnpj.substring(tamanho);
                let soma = 0;
                let pos = tamanho - 7;
                for (let i = tamanho; i >= 1; i--) {
                  soma += numeros.charAt(tamanho - i) * pos--;
                  if (pos < 2)
                        pos = 9;
                }
                let resultado = soma % 11 < 2 ? 0 : 11 - (soma % 11);
                if (resultado != digitos.charAt(0))
                    return false;
                tamanho = tamanho + 1;
                numeros = cnpj.substring(0,tamanho);
                soma = 0;
                pos = tamanho - 7;
                for (let i = tamanho; i >= 1; i--) {
                  soma += numeros.charAt(tamanho - i) * pos--;
                  if (pos < 2)
                        pos = 9;
                }
                resultado = soma % 11 < 2 ? 0 : 11 - (soma % 11);
                if (resultado != digitos.charAt(1))
                      return false;
                return true;
            }

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                statusMsg.style.display = 'none';

                const nameInput = document.getElementById('form-name');
                const emailInput = document.getElementById('form-email');
                const phoneInput = document.getElementById('form-phone');
                const cnpjInput = document.getElementById('form-cnpj');
                const productInput = document.getElementById('form-product');
                const messageInput = document.getElementById('form-message');

                const name = nameInput.value.trim();
                const email = emailInput.value.trim();
                const phone = phoneInput.value.trim();
                const docVal = cnpjInput.value.trim().replace(/[^\d]+/g,'');
                const productInterest = productInput.value.trim();
                const message = messageInput.value.trim();

                // Validate document
                if (docVal.length === 11) {
                    if (!validateCPF(docVal)) {
                        statusMsg.style.backgroundColor = '#fde8e8';
                        statusMsg.style.color = '#9b1c1c';
                        statusMsg.style.border = '1px solid #f8b4b4';
                        statusMsg.innerHTML = '<i class="fa-solid fa-circle-exclamation" style="margin-right: 8px;"></i>CPF inválido. Verifique os dígitos.';
                        statusMsg.style.display = 'block';
                        return;
                    }
                } else if (docVal.length === 14) {
                    if (!validateCNPJ(docVal)) {
                        statusMsg.style.backgroundColor = '#fde8e8';
                        statusMsg.style.color = '#9b1c1c';
                        statusMsg.style.border = '1px solid #f8b4b4';
                        statusMsg.innerHTML = '<i class="fa-solid fa-circle-exclamation" style="margin-right: 8px;"></i>CNPJ inválido. Verifique os dígitos.';
                        statusMsg.style.display = 'block';
                        return;
                    }
                } else {
                    statusMsg.style.backgroundColor = '#fde8e8';
                    statusMsg.style.color = '#9b1c1c';
                    statusMsg.style.border = '1px solid #f8b4b4';
                    statusMsg.innerHTML = '<i class="fa-solid fa-circle-exclamation" style="margin-right: 8px;"></i>Insira um CPF (11 dígitos) ou CNPJ (14 dígitos) válido.';
                    statusMsg.style.display = 'block';
                    return;
                }

                submitBtn.setAttribute('loading', '');
                submitBtn.disabled = true;

                try {
                    const response = await fetch('{{ path('app_contact_submit', {'_locale': locale}) }}', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            name,
                            email,
                            phone,
                            cpf_cnpj: docVal,
                            product_interest: productInterest,
                            message,
                            type: 'contact'
                        })
                    });

                    const resData = await response.json();
                    submitBtn.removeAttribute('loading');
                    submitBtn.disabled = false;

                    if (resData.success) {
                        statusMsg.style.backgroundColor = '#def7ec';
                        statusMsg.style.color = '#03543f';
                        statusMsg.style.border = '1px solid #bcf0da';
                        statusMsg.innerHTML = '<i class="fa-solid fa-circle-check" style="margin-right: 8px;"></i>' + resData.message;
                        statusMsg.style.display = 'block';
                        form.reset();
                    } else {
                        statusMsg.style.backgroundColor = '#fde8e8';
                        statusMsg.style.color = '#9b1c1c';
                        statusMsg.style.border = '1px solid #f8b4b4';
                        statusMsg.innerHTML = '<i class="fa-solid fa-circle-exclamation" style="margin-right: 8px;"></i>Ocorreu um erro: ' + resData.message;
                        statusMsg.style.display = 'block';
                    }
                } catch (error) {
                    submitBtn.removeAttribute('loading');
                    submitBtn.disabled = false;
                    statusMsg.style.backgroundColor = '#fde8e8';
                    statusMsg.style.color = '#9b1c1c';
                    statusMsg.style.border = '1px solid #f8b4b4';
                    statusMsg.innerHTML = '<i class="fa-solid fa-circle-exclamation" style="margin-right: 8px;"></i>Erro de conexão com o servidor. Tente novamente.';
                    statusMsg.style.display = 'block';
                }
            });
        });
    </script>
{% endblock %}
