{# templates/site/home.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Pressmatik - {{ 'banner.title'|trans }}{% endblock %}

{% block body %}
    <!-- Hero Banner Section (Premium Two-Column Slider Layout) -->
    <section class="hero-section">
        <div class="hero-grid-overlay"></div>
        
        <div class="hero-slider">
            {% if banners|length > 0 %}
                {% for item in banners %}
                    <div class="hero-slide {% if loop.first %}active{% endif %}">
                        <div class="container hero-grid">
                            <div class="hero-content">
                                <span class="section-title-tag">PRESSMATIK</span>
                                <h1 class="hero-title">{{ item.getTitle(locale) }}</h1>
                                <p class="hero-subtitle">{{ item.getSubtitle(locale) }}</p>
                                <div class="hero-buttons">
                                    <wa-button variant="brand" size="large" href="{{ item.getButtonUrl() ?: '#contact' }}">
                                        {{ item.getButtonText(locale) ?: 'cta.quote_now'|trans }}
                                    </wa-button>
                                    <wa-button variant="neutral" size="large" outline href="#about">
                                        {{ 'cta.learn_more'|trans }}
                                    </wa-button>
                                </div>
                            </div>
                            
                            <div class="hero-visual">
                                <div class="hero-image-frame">
                                    <img src="{% if item.getImageName() %}/uploads/banners/{{ item.getImageName() }}{% else %}/images/prensa-hidraulica-tipo-c-linha-st.png{% endif %}" alt="" class="hero-main-img">
                                    <div class="hero-badge badge-top">
                                        <span class="badge-num">25-315</span>
                                        <span class="badge-lbl">Toneladas</span>
                                    </div>
                                    <div class="hero-badge badge-bottom">
                                        <span class="badge-num">JIS Classe 1</span>
                                        <span class="badge-lbl">Alta Precisão</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="hero-slide active">
                    <div class="container hero-grid">
                        <div class="hero-content">
                            <span class="section-title-tag">PRESSMATIK</span>
                            <h1 class="hero-title">{{ 'banner.title'|trans }}</h1>
                            <p class="hero-subtitle">{{ 'banner.subtitle'|trans }}</p>
                            <div class="hero-buttons">
                                <wa-button variant="brand" size="large" href="#contact">
                                    {{ 'cta.quote_now'|trans }}
                                </wa-button>
                                <wa-button variant="neutral" size="large" outline href="#about">
                                    {{ 'cta.learn_more'|trans }}
                                </wa-button>
                            </div>
                        </div>
                        
                        <div class="hero-visual">
                            <div class="hero-image-frame">
                                <img src="/images/prensa-hidraulica-tipo-c-linha-st.png" alt="" class="hero-main-img">
                                <div class="hero-badge badge-top">
                                    <span class="badge-num">25-315</span>
                                    <span class="badge-lbl">Toneladas</span>
                                </div>
                                <div class="hero-badge badge-bottom">
                                    <span class="badge-num">JIS Classe 1</span>
                                    <span class="badge-lbl">Alta Precisão</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        <!-- Slider Controls -->
        {% if banners|length > 1 %}
        <div class="hero-slider-nav">
            <button class="hero-prev-btn" type="button"><i class="fa-solid fa-chevron-left"></i></button>
            <button class="hero-next-btn" type="button"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
        <div class="hero-slider-dots">
            {% for item in banners %}
                <span class="hero-dot {% if loop.first %}active{% endif %}" data-index="{{ loop.index0 }}"></span>
            {% endfor %}
        </div>
        {% endif %}
    </section>

    <!-- Quem Somos (About Us) Section with Image Collage and Bullet Grid -->
    <section id="about" class="section-padding about-section">
        <div class="container about-grid">
            <div class="about-collage scroll-animate slide-left">
                <div class="collage-container">
                    <div class="collage-shape"></div>
                    <div class="collage-img-main-frame">
                        <img src="{% if about and about.getHomeImageName() %}/uploads/about/{{ about.getHomeImageName() }}{% else %}/images/about-img.png{% endif %}" alt="Premium Hydraulic Press Manufacturing" class="collage-img-main">
                    </div>
                </div>
            </div>

            <div class="about-content scroll-animate slide-right">
                <span class="section-title-tag">{{ 'about.tag'|trans }}</span>
                <h2>{{ about ? about.getTitle(locale) : 'about.title'|trans }}</h2>
                <p>{{ about ? (about.getHomeText(locale) ?: about.getDescription(locale)) : 'about.text'|trans }}</p>
                
                <div class="about-bullets">
                    {% if about %}
                        {% for i in 1..4 %}
                            {% set adv_title = about.getAdvantageTitle(i, locale) %}
                            {% set adv_desc = about.getAdvantageDesc(i, locale) %}
                            {% set adv_icon = about.getAdvantageIcon(i) %}
                            {% if adv_title %}
                                <div class="about-bullet-item">
                                    <div class="bullet-icon-wrapper">
                                        <i class="{{ adv_icon ?: 'fa-solid fa-shield-halved' }}"></i>
                                    </div>
                                    <div class="bullet-text">
                                        <h4>{{ adv_title }}</h4>
                                        <p>{{ adv_desc }}</p>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        <div class="about-bullet-item">
                            <div class="bullet-icon-wrapper">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                            <div class="bullet-text">
                                <h4>Segurança Avançada (NR12)</h4>
                                <p>Sistemas eletro-hidráulicos monitorados redundantes e cortinas ópticas integradas.</p>
                            </div>
                        </div>
                    {% endif %}
                </div>
                
                <wa-button variant="neutral" outline href="{{ path('app_about_us', {'_locale': locale}) }}" style="margin-top: 1.5rem;">
                    {{ 'menu.company'|trans }}
                </wa-button>
            </div>
        </div>
    </section>

    <!-- Diferenciais Técnicos Section -->
    <section class="section-padding">
        <div class="container">
            <div class="section-header scroll-animate slide-top">
                <span class="section-title-tag">{{ 'differentials.tag'|trans }}</span>
                <h2 class="section-title">{{ 'differentials.title'|trans }}</h2>
            </div>
            
            <div class="diff-grid">
                {% for diff in differentials %}
                    <div class="diff-card scroll-animate {% if loop.index0 % 3 == 0 %}slide-left{% elseif loop.index0 % 3 == 1 %}slide-top{% else %}slide-right{% endif %}">
                        <div class="diff-card-icon-wrapper">
                            <i class="{{ diff.icon ?: 'fa-solid fa-star' }}"></i>
                        </div>
                        <h3>{{ diff.getTitle(locale) }}</h3>
                        <p>{{ diff.getDescription(locale) }}</p>
                    </div>
                {% else %}
                    <div class="diff-card scroll-animate slide-left">
                        <div class="diff-card-icon-wrapper">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <h3>{{ 'differentials.safety.title'|trans }}</h3>
                        <p>{{ 'differentials.safety.desc'|trans }}</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Grade de Destaque de Produtos Section -->
    <section id="products" class="section-padding products-section">
        <div class="container">
            <div class="section-header scroll-animate slide-top">
                <span class="section-title-tag">{{ 'products_sec.tag'|trans }}</span>
                <h2 class="section-title">{{ 'products_sec.title'|trans }}</h2>
            </div>

            {% set db_grouped = get_products_grouped() %}
            <wa-tab-group class="products-tab-group scroll-animate slide-top">
                <wa-tab slot="nav" panel="hydraulic">{{ 'products_sec.hydraulic_presses'|trans }}</wa-tab>
                <wa-tab slot="nav" panel="servo-hydraulic">{{ 'products_sec.servo_presses'|trans }}</wa-tab>
                <wa-tab slot="nav" panel="mechanical">Prensas Mecânicas</wa-tab>
                <wa-tab slot="nav" panel="equipments">{{ 'products_sec.equipments'|trans }}</wa-tab>
                <wa-tab slot="nav" panel="parts">{{ 'products_sec.parts'|trans }}</wa-tab>

                {% for cat in ['hydraulic', 'servo-hydraulic', 'mechanical', 'equipments', 'parts'] %}
                    <wa-tab-panel name="{{ cat }}">
                        <div class="products-tab-grid">
                            {% for prod in db_grouped[cat] ?? [] %}
                                <div class="product-tab-card">
                                    <div class="product-tab-img-wrapper">
                                        <img src="{% if prod.imageName %}/uploads/products/{{ prod.imageName }}{% else %}/images/prensa-hidraulica-tipo-c-linha-st.png{% endif %}" alt="{{ prod.getName(locale) }}" loading="lazy">
                                    </div>
                                    <div class="product-tab-info">
                                        <h3>{{ prod.getName(locale) }}</h3>
                                        <p>{{ prod.getDescription(locale) }}</p>
                                        <div class="product-tab-footer">
                                            {% if prod.tonnage %}
                                                <span class="product-specs-badge">{{ prod.tonnage }}</span>
                                            {% else %}
                                                <span class="product-specs-badge">{{ 'product_detail.tag'|trans }}</span>
                                            {% endif %}
                                            <wa-button variant="brand" size="small" href="{{ path('app_product_detail', {'_locale': locale, 'slug': prod.slug}) }}">
                                                {{ 'cta.learn_more'|trans }}
                                            </wa-button>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </wa-tab-panel>
                {% endfor %}
            </wa-tab-group>
        </div>
    </section>

    <!-- Seção de Serviços Section with Video Background -->
    <section id="services" class="section-padding services-video-section">
        <div class="video-bg-container">
            <video autoplay loop muted playsinline class="video-bg">
                <source src="/images/service-bg.mp4" type="video/mp4">
            </video>
            <div class="video-bg-overlay"></div>
        </div>

        <div class="container" style="position: relative; z-index: 2;">
            <div class="section-header scroll-animate slide-top">
                <span class="section-title-tag" style="color: var(--color-accent-red);">{{ 'services_sec.tag'|trans }}</span>
                <h2 class="section-title" style="color: #ffffff;">{{ 'services_sec.title'|trans }}</h2>
            </div>

            <div class="services-grid">
                {% for item in services %}
                    <div class="service-card scroll-animate {% if loop.index0 % 3 == 0 %}slide-left{% elseif loop.index0 % 3 == 1 %}slide-top{% else %}slide-right{% endif %}">
                        <div class="service-img-container">
                            <img src="/uploads/services/{{ item.imageName }}" alt="{{ item.getTitle(locale) }}" class="service-img" loading="lazy">
                            <div class="service-icon-floating">
                                <i class="bi {% if loop.index0 % 3 == 0 %}bi-wrench{% elseif loop.index0 % 3 == 1 %}bi-arrow-repeat{% else %}bi-exclamation-triangle{% endif %}"></i>
                            </div>
                        </div>
                        <div class="service-card-content">
                            <h3>{{ item.getTitle(locale) }}</h3>
                            <p>{{ item.getShortDescription(locale) }}</p>
                            <wa-button variant="text" href="{{ path('app_service_detail', {'_locale': locale, 'slug': item.getSlug(locale)}) }}" style="padding: 0; display: inline-block; color: #ffffff;">{{ 'cta.learn_more'|trans }} →</wa-button>
                        </div>
                    </div>
                {% else %}
                    <div class="service-card scroll-animate slide-left">
                        <div class="service-img-container">
                            <img src="/images/service-maintenance.png" alt="Manutenção de Prensas" class="service-img" loading="lazy">
                            <div class="service-icon-floating">
                                <i class="bi bi-wrench"></i>
                            </div>
                        </div>
                        <div class="service-card-content">
                            <h3>{{ 'services_sec.maintenance.title'|trans }}</h3>
                            <p>{{ 'services_sec.maintenance.desc'|trans }}</p>
                            <wa-button variant="text" href="#contact" style="padding: 0; display: inline-block; color: #ffffff;">{{ 'cta.quote_now'|trans }} →</wa-button>
                        </div>
                    </div>

                    <div class="service-card scroll-animate slide-top">
                        <div class="service-img-container">
                            <img src="/images/service-retrofit.png" alt="Retrofit de Prensas" class="service-img" loading="lazy">
                            <div class="service-icon-floating">
                                <i class="bi bi-arrow-repeat"></i>
                            </div>
                        </div>
                        <div class="service-card-content">
                            <h3>{{ 'services_sec.refit.title'|trans }}</h3>
                            <p>{{ 'services_sec.refit.desc'|trans }}</p>
                            <wa-button variant="text" href="#contact" style="padding: 0; display: inline-block; color: #ffffff;">{{ 'cta.quote_now'|trans }} →</wa-button>
                        </div>
                    </div>

                    <div class="service-card scroll-animate slide-right">
                        <div class="service-img-container">
                            <img src="/images/service-safety.png" alt="Adequação NR12" class="service-img" loading="lazy">
                            <div class="service-icon-floating">
                                <i class="bi bi-exclamation-triangle"></i>
                            </div>
                        </div>
                        <div class="service-card-content">
                            <h3>{{ 'services_sec.nr12.title'|trans }}</h3>
                            <p>{{ 'services_sec.nr12.desc'|trans }}</p>
                            <wa-button variant="text" href="#contact" style="padding: 0; display: inline-block; color: #ffffff;">{{ 'cta.quote_now'|trans }} →</wa-button>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Seção de Notícias & Eventos (Blog) -->
    <section id="news" class="section-padding news-section">
        <div class="container">
            <div class="section-header scroll-animate slide-top">
                <span class="section-title-tag">{{ 'news.tag'|trans }}</span>
                <h2 class="section-title">{{ 'news.title'|trans }}</h2>
                <p class="section-desc" style="max-width: 700px; color: var(--color-text-secondary); margin-bottom: 3.5rem;">
                    {{ 'news.desc'|trans }}
                </p>
            </div>
            
            <div class="news-grid">
                {% for item in news %}
                    <div class="news-card scroll-animate {% if loop.index0 % 3 == 0 %}slide-left{% elseif loop.index0 % 3 == 1 %}slide-top{% else %}slide-right{% endif %}">
                        <div class="news-img-container">
                            {% if item.imageName %}
                                <img src="/uploads/news/{{ item.imageName }}" alt="{{ item.getImageAlt(locale) ?: item.getTitle(locale) }}" class="news-img" loading="lazy">
                            {% else %}
                                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #1a1f2c; color: var(--color-text-secondary);">
                                    <i class="bi bi-image" style="font-size: 2.5rem;"></i>
                                </div>
                            {% endif %}
                            <div class="news-date-badge">
                                {{ item.date ? item.date|date('d/m/Y') : '' }}
                            </div>
                        </div>
                        <div class="news-card-content">
                            <h3>{{ item.getTitle(locale) }}</h3>
                            <p>{{ item.getShortDescription(locale) }}</p>
                            <a href="{{ path('app_news_detail', {'_locale': locale, 'slug': item.getSlug(locale)}) }}" class="news-readmore-btn">{{ 'news.read_more'|trans }} <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                {% else %}
                    <!-- Card 1 -->
                    <div class="news-card scroll-animate slide-left">
                        <div class="news-img-container">
                            <img src="/images/news-exhibition1.png" alt="{{ 'news.items.0.title'|trans }}" class="news-img" loading="lazy">
                            <div class="news-date-badge">
                                {{ 'news.items.0.date'|trans }}
                            </div>
                        </div>
                        <div class="news-card-content">
                            <h3>{{ 'news.items.0.title'|trans }}</h3>
                            <p>{{ 'news.items.0.desc'|trans }}</p>
                            <a href="#contact" class="news-readmore-btn">{{ 'news.read_more'|trans }} <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>

                    <!-- Card 2 -->
                    <div class="news-card scroll-animate slide-top">
                        <div class="news-img-container">
                            <img src="/images/news-seminar.png" alt="{{ 'news.items.1.title'|trans }}" class="news-img" loading="lazy">
                            <div class="news-date-badge">
                                {{ 'news.items.1.date'|trans }}
                            </div>
                        </div>
                        <div class="news-card-content">
                            <h3>{{ 'news.items.1.title'|trans }}</h3>
                            <p>{{ 'news.items.1.desc'|trans }}</p>
                            <a href="#contact" class="news-readmore-btn">{{ 'news.read_more'|trans }} <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>

                    <!-- Card 3 -->
                    <div class="news-card scroll-animate slide-right">
                        <div class="news-img-container">
                            <img src="/images/news-hannover.png" alt="{{ 'news.items.2.title'|trans }}" class="news-img" loading="lazy">
                            <div class="news-date-badge">
                                {{ 'news.items.2.date'|trans }}
                            </div>
                        </div>
                        <div class="news-card-content">
                            <h3>{{ 'news.items.2.title'|trans }}</h3>
                            <p>{{ 'news.items.2.desc'|trans }}</p>
                            <a href="#contact" class="news-readmore-btn">{{ 'news.read_more'|trans }} <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Depoimentos (Testimonials) Section -->
    <section class="section-padding testimonials-section">
        <div class="container">
            <div class="section-header scroll-animate slide-top">
                <span class="section-title-tag">{{ 'testimonials.tag'|trans }}</span>
                <h2 class="section-title">{{ 'testimonials.title'|trans }}</h2>
            </div>

            <div class="testimonials-carousel">
                {% for item in testimonials %}
                    <div class="testimonial-card scroll-animate {% if loop.index0 % 3 == 0 %}slide-left{% elseif loop.index0 % 3 == 1 %}slide-top{% else %}slide-right{% endif %}">
                        <div class="testimonial-rating">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                        </div>
                        <p class="testimonial-quote">"{{ item.getText(locale) }}"</p>
                        <div class="testimonial-client">
                            {% if item.imageName %}
                                <img src="/uploads/testimonies/{{ item.imageName }}" alt="{{ item.name }}" class="client-avatar">
                            {% else %}
                                <div class="client-avatar" style="background: linear-gradient(135deg,#4f8ef7,#a855f7); color:white; display:flex; align-items:center; justify-content:center; font-weight:700; font-size: 14px;">
                                    {{ item.name|first|upper }}
                                </div>
                            {% endif %}
                            <div class="client-meta">
                                <h4>{{ item.name }}</h4>
                                <p>{{ item.getRole(locale) }} - {{ item.company }}</p>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <!-- Static Fallbacks -->
                    <div class="testimonial-card scroll-animate slide-left">
                        <div class="testimonial-rating">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                        </div>
                        <p class="testimonial-quote">"{{ 'testimonials.client1.text'|trans }}"</p>
                        <div class="testimonial-client">
                            <img src="/images/client1.jpg" alt="{{ 'testimonials.client1.name'|trans }}" class="client-avatar">
                            <div class="client-meta">
                                <h4>{{ 'testimonials.client1.name'|trans }}</h4>
                                <p>{{ 'testimonials.client1.role'|trans }} - {{ 'testimonials.client1.company'|trans }}</p>
                            </div>
                        </div>
                    </div>

                    <div class="testimonial-card scroll-animate slide-top">
                        <div class="testimonial-rating">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                        </div>
                        <p class="testimonial-quote">"{{ 'testimonials.client2.text'|trans }}"</p>
                        <div class="testimonial-client">
                            <img src="/images/client2.jpg" alt="{{ 'testimonials.client2.name'|trans }}" class="client-avatar">
                            <div class="client-meta">
                                <h4>{{ 'testimonials.client2.name'|trans }}</h4>
                                <p>{{ 'testimonials.client2.role'|trans }} - {{ 'testimonials.client2.company'|trans }}</p>
                            </div>
                        </div>
                    </div>

                    <div class="testimonial-card scroll-animate slide-right">
                        <div class="testimonial-rating">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                        </div>
                        <p class="testimonial-quote">"{{ 'testimonials.client3.text'|trans }}"</p>
                        <div class="testimonial-client">
                            <img src="/images/client3.jpg" alt="{{ 'testimonials.client3.name'|trans }}" class="client-avatar">
                            <div class="client-meta">
                                <h4>{{ 'testimonials.client3.name'|trans }}</h4>
                                <p>{{ 'testimonials.client3.role'|trans }} - {{ 'testimonials.client3.company'|trans }}</p>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Clientes (Logos) Section -->
    <section class="clients-section">
        <div class="container">
            <div class="clients-grid scroll-animate slide-top" style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 3rem;">
                {% for item in clientLogos %}
                    <span class="client-logo-item" aria-label="{{ item.name }}" style="display: flex; align-items: center; justify-content: center; height: 50px;">
                        <img src="/uploads/clients/{{ item.imageName }}" alt="{{ item.name }}" style="max-height: 45px; max-width: 130px; object-fit: contain; filter: grayscale(100%); opacity: 0.6; transition: all 0.3s ease;">
                    </span>
                {% else %}
                    <!-- Static Fallbacks -->
                    <span class="client-logo-item" aria-label="Schuler">
                        <svg viewBox="0 0 140 30" xmlns="http://www.w3.org/2000/svg" style="height: 30px;">
