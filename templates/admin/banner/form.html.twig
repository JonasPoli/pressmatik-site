{% extends 'admin/base.html.twig' %}

{% block title %}{{ formTitle }}{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">{{ formTitle }}</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400">
        <a href="{{ path('app_admin_banner_index') }}" class="text-primary hover:underline">← Voltar para listagem</a>
    </p>
</div>

<form method="post" enctype="multipart/form-data" class="space-y-6">
    {# Multilingual tabs #}
    <div class="admin-card">
        <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-4">Conteúdo do Banner</h3>

        <div class="space-y-4">
            {% for lang, label in { pt: '🇧🇷 Português', en: '🇺🇸 Inglês', es: '🇪🇸 Espanhol' } %}
            <fieldset class="border border-slate-200 dark:border-slate-700 rounded-lg p-4">
                <legend class="text-xs font-semibold text-slate-500 px-2">{{ label }}</legend>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                    <div class="wab-field">
                        <label class="wab-label">Título</label>
                        <input type="text" name="title{{ lang|capitalize }}" value="{{ item ? attribute(item, 'title' ~ lang|capitalize) : '' }}" class="wab-input">
                    </div>
                    <div class="wab-field">
                        <label class="wab-label">Subtítulo</label>
                        <input type="text" name="subtitle{{ lang|capitalize }}" value="{{ item ? attribute(item, 'subtitle' ~ lang|capitalize) : '' }}" class="wab-input">
                    </div>
                    <div class="wab-field">
                        <label class="wab-label">Texto do Botão</label>
                        <input type="text" name="buttonText{{ lang|capitalize }}" value="{{ item ? attribute(item, 'buttonText' ~ lang|capitalize) : '' }}" class="wab-input">
                    </div>
                </div>
                <div class="border-t border-slate-100 dark:border-slate-700/50 pt-3">
                    <p class="text-xs font-semibold text-slate-500 mb-2">Destaques / Badges do Banner (Selos sobre a imagem)</p>
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                        <div class="wab-field">
                            <label class="wab-label">Badge 1 (Superior) - Valor/Número</label>
                            <input type="text" name="badgeTopNum{{ lang|capitalize }}" value="{{ item ? attribute(item, 'badgeTopNum' ~ lang|capitalize) : '' }}" class="wab-input" placeholder="Ex: 25-315">
                        </div>
                        <div class="wab-field">
                            <label class="wab-label">Badge 1 (Superior) - Rótulo</label>
                            <input type="text" name="badgeTopLabel{{ lang|capitalize }}" value="{{ item ? attribute(item, 'badgeTopLabel' ~ lang|capitalize) : '' }}" class="wab-input" placeholder="Ex: Toneladas">
                        </div>
                        <div class="wab-field">
                            <label class="wab-label">Badge 2 (Inferior) - Valor/Número</label>
                            <input type="text" name="badgeBottomNum{{ lang|capitalize }}" value="{{ item ? attribute(item, 'badgeBottomNum' ~ lang|capitalize) : '' }}" class="wab-input" placeholder="Ex: JIS Classe 1">
                        </div>
                        <div class="wab-field">
                            <label class="wab-label">Badge 2 (Inferior) - Rótulo</label>
                            <input type="text" name="badgeBottomLabel{{ lang|capitalize }}" value="{{ item ? attribute(item, 'badgeBottomLabel' ~ lang|capitalize) : '' }}" class="wab-input" placeholder="Ex: Alta Precisão">
                        </div>
                    </div>
                </div>
            </fieldset>
            {% endfor %}
        </div>
    </div>

    <div class="admin-card">
        <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-4">Configurações</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="wab-field">
                <label class="wab-label">URL do Botão</label>
                <input type="text" name="buttonUrl" value="{{ item ? item.buttonUrl : '' }}" class="wab-input" placeholder="/produtos/...">
            </div>
            <div class="wab-field">
                <label class="wab-label">Posição</label>
                <input type="number" name="position" value="{{ item ? item.position : 0 }}" class="wab-input" min="0">
            </div>
            <div class="wab-field flex items-end">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="isActive" value="1" {{ (item is null or item.isActive) ? 'checked' : '' }} class="rounded border-slate-300 text-primary focus:ring-primary">
                    <span class="text-sm text-slate-700 dark:text-slate-300">Ativo</span>
                </label>
            </div>
        </div>
    </div>

    <div class="admin-card">
        <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-4">Imagem Principal do Produto/Máquina no Banner</h3>
        {% if item and item.imageName %}
        <div class="mb-3">
            <img src="/uploads/banners/{{ item.imageName }}" alt="" class="max-h-40 rounded bg-slate-100 p-2 border border-slate-200">
            <div class="mt-2">
                <label class="inline-flex items-center gap-1.5 text-xs text-red-500 cursor-pointer">
                    <input type="checkbox" name="deleteImage" value="1" class="rounded border-slate-300 text-red-600 focus:ring-red-500"> Remover imagem atual
                </label>
            </div>
        </div>
        {% endif %}
        <input type="file" name="imageFile" accept="image/*" class="wab-input" {% if item is null %}required{% endif %}>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            <strong>Resolução indicada:</strong> 800 × 600 px ou fundo transparente PNG &nbsp;|&nbsp; <strong>Proporção recomendada:</strong> 4:3 ou recorte da máquina &nbsp;|&nbsp; <strong>Formatos:</strong> WebP, PNG, JPG
        </p>
    </div>

    <div class="admin-card">
        <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-4">Imagem de Fundo do Banner (Opcional)</h3>
        {% if item and item.bgImageName %}
        <div class="mb-3">
            <img src="/uploads/banners/{{ item.bgImageName }}" alt="Fundo do Banner" class="max-h-40 rounded bg-slate-100 p-2 border border-slate-200 object-cover w-full max-w-lg">
            <div class="mt-2">
                <label class="inline-flex items-center gap-1.5 text-xs text-red-500 cursor-pointer">
                    <input type="checkbox" name="deleteBgImage" value="1" class="rounded border-slate-300 text-red-600 focus:ring-red-500"> Remover imagem de fundo atual
                </label>
            </div>
        </div>
        {% endif %}
        <input type="file" name="bgImageFile" accept="image/*" class="wab-input">
        <div class="mt-2 space-y-1 text-xs text-slate-500 dark:text-slate-400">
            <p>
                <strong>Resolução indicada:</strong> 1920 × 1080 px (ou 1920 × 800 px) &nbsp;|&nbsp; 
                <strong>Proporção recomendada:</strong> 16:9 ou 21:9 Widescreen &nbsp;|&nbsp; 
                <strong>Formatos aceitos:</strong> WebP, JPG, PNG
            </p>
            <p class="text-amber-600 dark:text-amber-400 flex items-center gap-1.5 font-medium">
                <i class="fa-solid fa-circle-info"></i>
                <strong>Efeito Aplicado:</strong> Será aplicado automaticamente um filtro de escurecimento (overlay escuro) sobre esta imagem de fundo no site para assegurar o contraste e a perfeita legibilidade dos textos e títulos do banner.
            </p>
        </div>
    </div>

    <div class="flex justify-end gap-3">
        <a href="{{ path('app_admin_banner_index') }}" class="px-4 py-2 text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors">Cancelar</a>
        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium">
            <i class="fa-solid fa-save"></i> Salvar
        </button>
    </div>
</form>
{% endblock %}
