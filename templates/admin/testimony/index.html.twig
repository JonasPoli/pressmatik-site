{% extends 'admin/base.html.twig' %}

{% block title %}Depoimentos{% endblock %}

{% block body %}
<div class="page-header flex items-center justify-between">
    <div>
        <h1 class="page-title">Depoimentos</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400">Gerenciamento dos depoimentos dos clientes</p>
    </div>
    <a href="{{ path('app_admin_testimony_new') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium">
        <i class="fa-solid fa-plus"></i> Novo Depoimento
    </a>
</div>

<div class="admin-card">
    {% if items|length == 0 %}
        <p class="text-sm text-slate-500 dark:text-slate-400 py-8 text-center">Nenhum depoimento cadastrado ainda.</p>
    {% else %}
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-slate-200 dark:border-slate-700">
                    <th class="text-left py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Pos.</th>
                    <th class="text-left py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Foto</th>
                    <th class="text-left py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Nome</th>
                    <th class="text-left py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Empresa / Cargo (PT)</th>
                    <th class="text-left py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Ativo</th>
                    <th class="text-right py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Ações</th>
                </tr>
            </thead>
            <tbody id="testimony-tbody">
                {% for item in items %}
                <tr class="border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors" data-id="{{ item.id }}">
                    <td class="py-3 px-4 text-slate-500 cursor-move"><i class="fa-solid fa-grip-vertical mr-2 text-slate-400"></i>{{ item.position }}</td>
                    <td class="py-3 px-4">
                        {% if item.imageName %}
                            <img src="/uploads/testimonies/{{ item.imageName }}" alt="" class="w-10 h-10 object-cover rounded-full">
                        {% else %}
                            <span class="w-10 h-10 bg-slate-200 dark:bg-slate-700 rounded-full flex items-center justify-center text-slate-400"><i class="fa-solid fa-user"></i></span>
                        {% endif %}
                    </td>
                    <td class="py-3 px-4 font-medium text-slate-800 dark:text-white">{{ item.name }}</td>
                    <td class="py-3 px-4 text-slate-500">
                        {{ item.company }} {% if item.rolePt %}({{ item.rolePt }}){% endif %}
                    </td>
                    <td class="py-3 px-4">
                        {% if item.isActive %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-400">Sim</span>
                        {% else %}
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-400">Não</span>
                        {% endif %}
                    </td>
                    <td class="py-3 px-4 text-right">
                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ path('app_admin_testimony_edit', {id: item.id}) }}" class="text-primary hover:text-primary-dark" title="Editar">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <form method="post" action="{{ path('app_admin_testimony_delete', {id: item.id}) }}" onsubmit="return confirm('Tem certeza?')" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}">
                                <button type="submit" class="text-red-500 hover:text-red-700" title="Excluir">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
function initSortable() {
    const el = document.getElementById('testimony-tbody');
    if (el && !el.dataset.sortableInitialized) {
        el.dataset.sortableInitialized = 'true';
        new Sortable(el, {
            animation: 150,
            handle: '.cursor-move',
            onEnd: function () {
                const ids = Array.from(el.children).map(tr => tr.dataset.id);
                fetch('{{ path("app_admin_testimony_reorder") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids })
                });
            }
        });
    }
}
initSortable();
document.addEventListener('turbo:load', initSortable);
document.addEventListener('DOMContentLoaded', initSortable);
</script>
{% endblock %}
