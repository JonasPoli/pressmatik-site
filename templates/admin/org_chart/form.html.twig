{% extends 'admin/base.html.twig' %}
{% block title %}{{ formTitle }}{% endblock %}
{% block body %}
<div class="page-header"><h1 class="page-title">{{ formTitle }}</h1><p class="text-sm text-slate-500 dark:text-slate-400"><a href="{{ path('app_admin_org_chart_index') }}" class="text-primary hover:underline">← Voltar</a></p></div>
<form method="post" class="space-y-6">
    <div class="admin-card">
        {% for lang, label in { pt: '🇧🇷 Português', en: '🇺🇸 Inglês', es: '🇪🇸 Espanhol' } %}
        <fieldset class="border border-slate-200 dark:border-slate-700 rounded-lg p-4 mb-4">
            <legend class="text-xs font-semibold text-slate-500 px-2">{{ label }}</legend>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="wab-field"><label class="wab-label">Título</label><input type="text" name="title{{ lang|capitalize }}" value="{{ item ? attribute(item, 'title' ~ lang|capitalize) : '' }}" class="wab-input" {{ lang == 'pt' ? 'required' : '' }}></div>
                <div class="wab-field"><label class="wab-label">Descrição</label><textarea name="description{{ lang|capitalize }}" class="wab-input" rows="2">{{ item ? attribute(item, 'description' ~ lang|capitalize) : '' }}</textarea></div>
            </div>
        </fieldset>
        {% endfor %}
    </div>
    <div class="admin-card">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="wab-field">
                <label class="wab-label">Ícone</label>
                <div class="flex items-center gap-3">
                    <div class="flex items-center justify-center w-12 h-12 rounded-lg bg-slate-100 dark:bg-slate-700">
                        <i id="icon-preview" class="{{ item and item.icon ? item.icon : 'fa-solid fa-icons' }} text-xl text-primary"></i>
                    </div>
                    <input type="hidden" name="icon" id="icon-input" value="{{ item ? item.icon : '' }}">
                    <button type="button" onclick="openIconPicker('icon-input','icon-preview')" class="px-3 py-1.5 text-sm bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors">Escolher</button>
                </div>
            </div>
            <div class="wab-field"><label class="wab-label">Posição</label><input type="number" name="position" value="{{ item ? item.position : 0 }}" class="wab-input" min="0"></div>
        </div>
    </div>
    <div class="flex justify-end gap-3">
        <a href="{{ path('app_admin_org_chart_index') }}" class="px-4 py-2 text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors">Cancelar</a>
        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium"><i class="fa-solid fa-save"></i> Salvar</button>
    </div>
</form>
{% include 'admin/_partials/_icon_picker.html.twig' %}
{% endblock %}
