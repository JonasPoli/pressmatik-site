{% extends 'admin/base.html.twig' %}
{% block title %}Gerenciar: {{ slug }}{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">Gerenciar: {{ slug }}</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400">
        <a href="{{ path('app_admin_product_manage_index') }}" class="text-primary hover:underline">← Voltar</a>
    </p>
</div>



{# ═══════════════════════════════════════════════════════════════════════
   SUBPRODUTOS (Subproducts, PDFs & Applications)
   ═══════════════════════════════════════════════════════════════════════ #}
<div class="admin-card mb-6">
    <h2 class="admin-card-title mb-4"><i class="fa-solid fa-boxes-stacked mr-2"></i>Subprodutos (Modelos, PDFs e Aplicações)</h2>

    {% if product.subproducts|length > 0 %}
    <div class="space-y-4 mb-6" id="subproducts-list">
        {% for sub in product.subproducts %}
        <div class="border border-slate-200 dark:border-slate-700 rounded-lg p-4 bg-white dark:bg-slate-800" data-id="{{ sub.id }}" x-data="{ showEdit: false, showSerie: false, showApps: false, showOpts: false, showSpecs: false }">
            <div class="flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-center">
                    <i class="fa-solid fa-grip-vertical text-slate-400 cursor-move mr-3"></i>
                    {% if sub.imageName %}
                        <img src="/uploads/products/{{ sub.imageName }}" alt="" class="w-10 h-10 object-contain rounded bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 mr-3">
                    {% else %}
                        <div class="w-10 h-10 flex items-center justify-center bg-slate-100 dark:bg-slate-700 rounded mr-3 text-slate-400 text-xs">
                            <i class="fa-regular fa-image"></i>
                        </div>
                    {% endif %}
                    <span class="px-2 py-0.5 bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded text-xs mr-2">{{ sub.model }}</span>
                    <span class="font-medium">{{ sub.namePt }}</span>
                    {% if sub.tag %}
                        <span class="ml-2 text-xs px-1.5 py-0.5 bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-200 rounded">{{ sub.tag }}</span>
                    {% endif %}
                    <span class="ml-2 text-xs {{ sub.isIsActive ? 'text-green-500' : 'text-slate-400' }}">({{ sub.isIsActive ? 'Ativo' : 'Inativo' }})</span>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" @click="showEdit = !showEdit" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 rounded text-xs transition-colors">
                        <i class="fa-solid fa-pen-to-square"></i> Editar / Listas / PDFs
                    </button>
                    <button type="button" @click="showSerie = !showSerie" class="px-2 py-1 bg-blue-50 hover:bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:hover:bg-blue-900/60 dark:text-blue-300 rounded text-xs transition-colors font-medium">
                        <i class="fa-solid fa-list-check"></i> Série ({{ sub.standardItems|length }})
                    </button>
                    <button type="button" @click="showApps = !showApps" class="px-2 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:hover:bg-emerald-900/60 dark:text-emerald-300 rounded text-xs transition-colors font-medium">
                        <i class="fa-solid fa-industry"></i> Aplicações ({{ sub.applicationListItems|length }})
                    </button>
                    <button type="button" @click="showOpts = !showOpts" class="px-2 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:hover:bg-amber-900/60 dark:text-amber-300 rounded text-xs transition-colors font-medium">
                        <i class="fa-solid fa-square-plus"></i> Opcionais ({{ sub.optionalItems|length }})
                    </button>
                    <button type="button" @click="showSpecs = !showSpecs" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 rounded text-xs transition-colors">
                        <i class="fa-solid fa-table"></i> Parâmetros ({{ sub.sizes|length }})
                    </button>
                    <form method="post" action="{{ path('app_admin_subproduct_delete', {slug: slug, id: sub.id}) }}" onsubmit="return confirm('Remover subproduto? Isso apagará todas as suas especificações e aplicações associadas.')" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_sub' ~ sub.id) }}">
                        <button type="submit" class="text-red-500 hover:text-red-700 p-1 text-xs"><i class="fa-solid fa-trash-can"></i></button>
                    </form>
                </div>
            </div>

            <!-- PDFs and basic info summary -->
            <div class="mt-2 flex flex-wrap gap-4 text-xs text-slate-500 dark:text-slate-400 border-t border-slate-100 dark:border-slate-700/50 pt-2">
                <div>
                    <strong>PDF PT:</strong> 
                    {% if sub.pdfNamePt %}
                        <a href="/uploads/products/{{ sub.pdfNamePt }}" target="_blank" class="text-primary hover:underline">{{ sub.pdfNamePt }}</a>
                    {% else %}
                        <span class="text-slate-400">Não cadastrado</span>
                    {% endif %}
                </div>
                <div>
                    <strong>PDF EN:</strong> 
                    {% if sub.pdfNameEn %}
                        <a href="/uploads/products/{{ sub.pdfNameEn }}" target="_blank" class="text-primary hover:underline">{{ sub.pdfNameEn }}</a>
                    {% else %}
                        <span class="text-slate-400">Não cadastrado</span>
                    {% endif %}
                </div>
                <div>
                    <strong>PDF ES:</strong> 
                    {% if sub.pdfNameEs %}
                        <a href="/uploads/products/{{ sub.pdfNameEs }}" target="_blank" class="text-primary hover:underline">{{ sub.pdfNameEs }}</a>
                    {% else %}
                        <span class="text-slate-400">Não cadastrado</span>
                    {% endif %}
                </div>
            </div>

            <!-- COLLAPSIBLE EDIT FORM -->
            <div x-show="showEdit" x-collapse class="mt-4 p-4 border border-slate-100 dark:border-slate-700 rounded bg-slate-50 dark:bg-slate-900/50 text-sm space-y-3">
                <form method="post" action="{{ path('app_admin_subproduct_edit', {slug: slug, id: sub.id}) }}" enctype="multipart/form-data">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div class="wab-field">
                            <label class="wab-label">Código do Modelo</label>
                            <input type="text" name="model" value="{{ sub.model }}" class="wab-input" required>
                        </div>
                        <div class="wab-field col-span-2">
                            <label class="wab-label">Tag (ex: Standard, Premium, Compact)</label>
                            <input type="text" name="tag" value="{{ sub.tag }}" class="wab-input">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-3">
                        <div class="wab-field">
                            <label class="wab-label">Nome (PT)</label>
                            <input type="text" name="namePt" value="{{ sub.namePt }}" class="wab-input" required>
                        </div>
                        <div class="wab-field">
                            <label class="wab-label">Nome (EN)</label>
                            <input type="text" name="nameEn" value="{{ sub.nameEn }}" class="wab-input">
                        </div>
                        <div class="wab-field">
                            <label class="wab-label">Nome (ES)</label>
                            <input type="text" name="nameEs" value="{{ sub.nameEs }}" class="wab-input">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-3">
                        <div class="wab-field">
                            <label class="wab-label">Descrição (PT)</label>
                            <textarea name="descriptionPt" class="wab-input" rows="2">{{ sub.descriptionPt }}</textarea>
                        </div>
                        <div class="wab-field">
                            <label class="wab-label">Descrição (EN)</label>
                            <textarea name="descriptionEn" class="wab-input" rows="2">{{ sub.descriptionEn }}</textarea>
                        </div>
                        <div class="wab-field">
                            <label class="wab-label">Descrição (ES)</label>
                            <textarea name="descriptionEs" class="wab-input" rows="2">{{ sub.descriptionEs }}</textarea>
                        </div>
                    </div>

                     <div class="grid grid-cols-1 md:grid-cols-4 gap-3 mt-3">
                        <div class="wab-field">
                            <label class="wab-label">Imagem do Subproduto</label>
                            {% if sub.imageName %}
                                <div class="mb-2">
                                    <img src="/uploads/products/{{ sub.imageName }}" alt="" class="h-16 object-contain rounded bg-slate-100 dark:bg-slate-700 p-1 border border-slate-200 dark:border-slate-600">
                                </div>
                            {% endif %}
                            <input type="file" name="imageFile" class="wab-input" accept="image/*">
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                                <strong>Resolução indicada:</strong> 800 × 800 px (ou 1000 × 750 px) &nbsp;|&nbsp; <strong>Proporção recomendada:</strong> 1:1 (Quadrado) ou 4:3 &nbsp;|&nbsp; <strong>Formatos:</strong> PNG transparente ou WebP
                            </p>
                        </div>
                        <div class="wab-field">
                            <label class="wab-label">Catálogo PDF (PT)</label>
                            <input type="file" name="pdfFilePt" class="wab-input" accept="application/pdf">
                        </div>
                        <div class="wab-field">
                            <label class="wab-label">Catálogo PDF (EN)</label>
                            <input type="file" name="pdfFileEn" class="wab-input" accept="application/pdf">
                        </div>
                        <div class="wab-field">
                            <label class="wab-label">Catálogo PDF (ES)</label>
                            <input type="file" name="pdfFileEs" class="wab-input" accept="application/pdf">
                        </div>
                    </div>

                    <!-- Standard Items Checkbox List -->
                    <div class="border-t border-slate-200 dark:border-slate-700 pt-3 mt-3">
                        <label class="wab-label font-semibold mb-2 block text-xs text-blue-700 dark:text-blue-400"><i class="fa-solid fa-list-check mr-1"></i> Itens de Série (Equipamento Padrão)</label>
                        {% if allStandardItems|length == 0 %}
                            <p class="text-xs text-slate-400">Nenhum item de série cadastrado.</p>
                        {% else %}
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 bg-white dark:bg-slate-800 p-3 rounded-lg border border-slate-200 dark:border-slate-700 max-h-48 overflow-y-auto">
                                {% for item in allStandardItems %}
                                    <label class="flex items-center gap-2 cursor-pointer p-1.5 hover:bg-blue-50/50 dark:hover:bg-blue-900/20 rounded transition-colors text-xs">
                                        <input type="checkbox" name="standardItems[]" value="{{ item.id }}" 
                                               {% if sub.standardItems.contains(item) %}checked{% endif %}
                                               class="rounded border-slate-300 dark:border-slate-600 text-blue-600">
                                        <i class="{{ item.icon ?: 'fa-solid fa-check' }} text-blue-500 text-sm"></i>
                                        <span class="text-slate-700 dark:text-slate-300 font-medium">{{ item.namePt }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <!-- ApplicationListItems Checkbox List -->
                    <div class="border-t border-slate-200 dark:border-slate-700 pt-3 mt-3">
                        <label class="wab-label font-semibold mb-2 block text-xs text-emerald-700 dark:text-emerald-400"><i class="fa-solid fa-industry mr-1"></i> Aplicações (Listagem)</label>
                        {% if allApplicationListItems|length == 0 %}
                            <p class="text-xs text-slate-400">Nenhuma aplicação (listagem) cadastrada.</p>
                        {% else %}
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 bg-white dark:bg-slate-800 p-3 rounded-lg border border-slate-200 dark:border-slate-700 max-h-48 overflow-y-auto">
                                {% for item in allApplicationListItems %}
                                    <label class="flex items-center gap-2 cursor-pointer p-1.5 hover:bg-emerald-50/50 dark:hover:bg-emerald-900/20 rounded transition-colors text-xs">
                                        <input type="checkbox" name="applicationListItems[]" value="{{ item.id }}" 
                                               {% if sub.applicationListItems.contains(item) %}checked{% endif %}
                                               class="rounded border-slate-300 dark:border-slate-600 text-emerald-600">
                                        <i class="{{ item.icon ?: 'fa-solid fa-industry' }} text-emerald-500 text-sm"></i>
                                        <span class="text-slate-700 dark:text-slate-300 font-medium">{{ item.namePt }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Applications (Banners) Checkbox List -->
                    <div class="border-t border-slate-200 dark:border-slate-700 pt-3 mt-3">
                        <label class="wab-label font-semibold mb-2 block text-xs text-slate-600 dark:text-slate-300"><i class="fa-solid fa-briefcase mr-1"></i> Aplicações (Banners com Imagem)</label>
                        {% if allApplications|length == 0 %}
                            <p class="text-xs text-slate-400">Nenhuma aplicação (banner) cadastrada.</p>
                        {% else %}
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 bg-white dark:bg-slate-800 p-3 rounded-lg border border-slate-200 dark:border-slate-700 max-h-48 overflow-y-auto">
                                {% for app in allApplications %}
                                    <label class="flex items-center gap-2 cursor-pointer p-1.5 hover:bg-slate-50 dark:hover:bg-slate-700/50 rounded transition-colors text-xs">
                                        <input type="checkbox" name="applications[]" value="{{ app.id }}" 
                                               {% if sub.applications.contains(app) %}checked{% endif %}
                                               class="rounded border-slate-300 dark:border-slate-600 text-primary">
                                        {% if app.imageName %}
                                            <img src="/uploads/applications/{{ app.imageName }}" alt="" class="w-4 h-4 object-contain bg-slate-100 dark:bg-slate-700 rounded p-0.5 border border-slate-200 dark:border-slate-600">
                                        {% endif %}
                                        <span class="text-slate-700 dark:text-slate-300 font-medium">{{ app.namePt }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <!-- Optional Items Checkbox List -->
                    <div class="border-t border-slate-200 dark:border-slate-700 pt-3 mt-3">
                        <label class="wab-label font-semibold mb-2 block text-xs text-amber-700 dark:text-amber-400"><i class="fa-solid fa-square-plus mr-1"></i> Itens Opcionais & Periféricos</label>
                        {% if allOptionalItems|length == 0 %}
                            <p class="text-xs text-slate-400">Nenhum item opcional cadastrado.</p>
                        {% else %}
                            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 bg-white dark:bg-slate-800 p-3 rounded-lg border border-slate-200 dark:border-slate-700 max-h-48 overflow-y-auto">
                                {% for item in allOptionalItems %}
                                    <label class="flex items-center gap-2 cursor-pointer p-1.5 hover:bg-amber-50/50 dark:hover:bg-amber-900/20 rounded transition-colors text-xs">
                                        <input type="checkbox" name="optionalItems[]" value="{{ item.id }}" 
                                               {% if sub.optionalItems.contains(item) %}checked{% endif %}
                                               class="rounded border-slate-300 dark:border-slate-600 text-amber-600">
                                        <i class="{{ item.icon ?: 'fa-solid fa-plus-circle' }} text-amber-500 text-sm"></i>
                                        <span class="text-slate-700 dark:text-slate-300 font-medium">{{ item.namePt }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div class="flex items-center gap-2 mt-4">
                        <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary-dark text-white rounded-lg text-xs font-semibold transition-colors">
                            Salvar Alterações
                        </button>
                        <button type="button" @click="showEdit = false" class="px-3 py-2 bg-slate-200 dark:bg-slate-700 rounded-lg text-xs transition-colors">
                            Cancelar
                        </button>
                    </div>
                </form>
            </div>

            <!-- COLLAPSIBLE STANDARD ITEMS SUMMARY (READ ONLY) -->
            <div x-show="showSerie" x-collapse class="mt-4 p-4 border border-blue-100 dark:border-blue-900/30 rounded bg-blue-50/30 dark:bg-blue-950/20 text-sm">
                <h3 class="font-semibold text-xs text-blue-800 dark:text-blue-300 mb-3"><i class="fa-solid fa-list-check mr-1"></i> Itens de Série de {{ sub.model }} ({{ sub.standardItems|length }})</h3>
                {% if sub.standardItems|length > 0 %}
                <div class="flex flex-wrap gap-2">
                    {% for item in sub.standardItems %}
                    <div class="flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-800 rounded-full border border-blue-200 dark:border-blue-800 shadow-sm text-xs">
                        <i class="{{ item.icon ?: 'fa-solid fa-check' }} text-blue-600"></i>
                        <span class="font-medium text-slate-800 dark:text-slate-200">{{ item.namePt }}</span>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-xs text-slate-400">Nenhum item de série associado. Clique em <strong>Editar / Listas / PDFs</strong> para associar.</p>
                {% endif %}
            </div>

            <!-- COLLAPSIBLE APPLICATIONS SUMMARY (READ ONLY) -->
            <div x-show="showApps" x-collapse class="mt-4 p-4 border border-emerald-100 dark:border-emerald-900/30 rounded bg-emerald-50/30 dark:bg-emerald-950/20 text-sm">
                <h3 class="font-semibold text-xs text-emerald-800 dark:text-emerald-300 mb-3"><i class="fa-solid fa-industry mr-1"></i> Aplicações (Listagem) de {{ sub.model }} ({{ sub.applicationListItems|length }})</h3>
                {% if sub.applicationListItems|length > 0 %}
                <div class="flex flex-wrap gap-2">
                    {% for item in sub.applicationListItems %}
                    <div class="flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-800 rounded-full border border-emerald-200 dark:border-emerald-800 shadow-sm text-xs">
                        <i class="{{ item.icon ?: 'fa-solid fa-industry' }} text-emerald-600"></i>
                        <span class="font-medium text-slate-800 dark:text-slate-200">{{ item.namePt }}</span>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-xs text-slate-400">Nenhuma aplicação (listagem) associada. Clique em <strong>Editar / Listas / PDFs</strong> para associar.</p>
                {% endif %}
            </div>

            <!-- COLLAPSIBLE OPTIONAL ITEMS SUMMARY (READ ONLY) -->
            <div x-show="showOpts" x-collapse class="mt-4 p-4 border border-amber-100 dark:border-amber-900/30 rounded bg-amber-50/30 dark:bg-amber-950/20 text-sm">
                <h3 class="font-semibold text-xs text-amber-800 dark:text-amber-300 mb-3"><i class="fa-solid fa-square-plus mr-1"></i> Itens Opcionais de {{ sub.model }} ({{ sub.optionalItems|length }})</h3>
                {% if sub.optionalItems|length > 0 %}
                <div class="flex flex-wrap gap-2">
                    {% for item in sub.optionalItems %}
                    <div class="flex items-center gap-2 px-3 py-1.5 bg-white dark:bg-slate-800 rounded-full border border-amber-200 dark:border-amber-800 shadow-sm text-xs">
                        <i class="{{ item.icon ?: 'fa-solid fa-plus-circle' }} text-amber-600"></i>
                        <span class="font-medium text-slate-800 dark:text-slate-200">{{ item.namePt }}</span>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <p class="text-xs text-slate-400">Nenhum item opcional associado. Clique em <strong>Editar / Listas / PDFs</strong> para associar.</p>
                {% endif %}
            </div>

            <!-- COLLAPSIBLE TECHNICAL PARAMETERS TABLE AND SIZES (READ & WRITE) -->
            <div x-show="showSpecs" x-collapse class="mt-4 p-4 border border-slate-100 dark:border-slate-700 rounded bg-slate-50 dark:bg-slate-900/50 text-sm space-y-4">
                
                <!-- Sizes Management Section -->
                <div class="border-b border-slate-200 dark:border-slate-700 pb-4">
                    <h3 class="font-semibold text-xs text-slate-600 dark:text-slate-300 mb-2">Gerenciar Tamanhos de {{ sub.model }}</h3>
                    <div class="flex flex-wrap gap-2 mb-3">
                        {% for size in sub.sizes %}
                            <div class="flex items-center gap-1.5 px-2.5 py-1 bg-white dark:bg-slate-800 rounded border border-slate-200 dark:border-slate-700 text-xs">
                                <span class="font-medium">{{ size.name }}</span>
                                <span class="text-xxs text-slate-400">({{ size.hasVType and size.hasHType ? 'V+H' : (size.hasVType ? 'V' : (size.hasHType ? 'H' : 'Único')) }})</span>
                                <form method="post" action="{{ path('app_admin_subproduct_size_delete', {subproductId: sub.id, id: size.id}) }}" onsubmit="return confirm('Excluir este tamanho? Todos os parâmetros técnicos deste tamanho serão apagados!')" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_size' ~ size.id) }}">
                                    <button type="submit" class="text-red-500 hover:text-red-700 font-bold ml-1">×</button>
                                </form>
                            </div>
                        {% endfor %}
                    </div>

                    <!-- Add Size Form -->
                    <form method="post" action="{{ path('app_admin_subproduct_size_add', {subproductId: sub.id}) }}" class="flex flex-wrap items-end gap-3 bg-white dark:bg-slate-800 p-3 rounded-lg border border-slate-200 dark:border-slate-700/60 max-w-xl">
                        <div class="wab-field" style="margin: 0; min-width: 120px;">
                            <label class="wab-label" style="font-size: 10px; margin-bottom: 2px;">Nome (ex: PMC-30)</label>
                            <input type="text" name="name" class="wab-input text-xs" required style="padding: 4px 8px; height: 28px;">
                        </div>
                        <label class="flex items-center gap-1 cursor-pointer text-xs mb-1.5">
                            <input type="checkbox" name="hasVType" value="1" checked class="rounded">
                            V-type
                        </label>
                        <label class="flex items-center gap-1 cursor-pointer text-xs mb-1.5">
                            <input type="checkbox" name="hasHType" value="1" checked class="rounded">
                            H-type
                        </label>
                        <button type="submit" class="px-3 py-1 bg-slate-700 hover:bg-slate-800 text-white rounded text-xs transition-colors h-7 font-medium">
                            + Adicionar Tamanho
                        </button>
                    </form>
                </div>

                <!-- Parameters Grid Section -->
                <div>
                    <h3 class="font-semibold text-xs text-slate-600 dark:text-slate-300 mb-3">Tabela de Parâmetros</h3>
                    {% if sub.sizes|length == 0 %}
                        <p class="text-xs text-slate-400 mb-3">Cadastre tamanhos acima ou importe um CSV para popular a tabela de especificações.</p>
                        <div class="flex flex-wrap items-center gap-2">
                            <form method="post" action="{{ path('app_admin_subproduct_specs_import_csv', {subproductId: sub.id}) }}" enctype="multipart/form-data" class="inline-flex items-center gap-1">
                                <input type="file" name="csvFile" accept=".csv,text/csv" class="hidden" id="csv-import-empty-{{ sub.id }}" onchange="this.form.submit()">
                                <button type="button" onclick="document.getElementById('csv-import-empty-{{ sub.id }}').click()" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs transition-colors font-medium inline-flex items-center gap-1">
                                    <i class="fa-solid fa-file-import"></i> Importar CSV
                                </button>
                            </form>
                            <span class="text-xs text-slate-400">(Os tamanhos serão criados automaticamente a partir do cabeçalho do CSV)</span>
                        </div>
                    {% else %}
                        <div x-data="subSpecTable_{{ sub.id }}()">
                            <div class="overflow-x-auto">
                                <table class="w-full text-xs border-collapse">
                                    <thead>
                                        {% set hasAnySub = false %}
                                        {% for size in sub.sizes %}
                                            {% if size.hasVType or size.hasHType %}
                                                {% set hasAnySub = true %}
                                            {% endif %}
                                        {% endfor %}
                                        <tr class="bg-slate-100 dark:bg-slate-800">
                                            <th class="py-2 px-2 text-center border border-slate-200 dark:border-slate-700" {% if hasAnySub %}rowspan="2"{% endif %} style="width: 40px;"></th>
                                            <th class="py-2 px-2 text-left font-semibold border border-slate-200 dark:border-slate-700" {% if hasAnySub %}rowspan="2"{% endif %}>Especificação</th>
                                            <th class="py-2 px-2 text-left font-semibold border border-slate-200 dark:border-slate-700" {% if hasAnySub %}rowspan="2"{% endif %}>Unidade</th>
                                            {% for size in sub.sizes %}
                                                {% set hasSub = size.hasVType or size.hasHType %}
                                                <th class="py-2 px-2 text-center font-semibold border border-slate-200 dark:border-slate-700"
                                                    colspan="{{ hasSub ? (size.hasVType ? 1 : 0) + (size.hasHType ? 1 : 0) : 1 }}"
                                                    {% if hasAnySub and not hasSub %}rowspan="2" style="vertical-align: middle;"{% endif %}>
                                                    {{ size.name }}
                                                </th>
                                            {% endfor %}
                                            <th class="py-2 px-2 border border-slate-200 dark:border-slate-700" {% if hasAnySub %}rowspan="2"{% endif %}>Ações</th>
                                        </tr>
                                        {% if hasAnySub %}
                                        <tr class="bg-slate-100 dark:bg-slate-800">
                                            {% for size in sub.sizes %}
                                                {% if size.hasVType %}
                                                <th class="py-1 px-2 text-center text-xs font-normal border border-slate-200 dark:border-slate-700">V-type</th>
                                                {% endif %}
                                                {% if size.hasHType %}
                                                <th class="py-1 px-2 text-center text-xs font-normal border border-slate-200 dark:border-slate-700">H-type</th>
                                                {% endif %}
                                            {% endfor %}
                                        </tr>
                                        {% endif %}
                                    </thead>
                                    <tbody>
                                        <template x-for="(row, rowIdx) in rows" :key="rowIdx">
                                            <tr class="hover:bg-slate-200/50 dark:hover:bg-slate-800/80"
                                                draggable="true"
                                                @dragstart="draggedIdx = rowIdx"
                                                @dragover.prevent
                                                @drop="moveRow(draggedIdx, rowIdx)">
                                                <td class="py-1 px-2 border border-slate-200 dark:border-slate-700 text-center cursor-move text-slate-400">
                                                    <i class="fa-solid fa-grip-vertical"></i>
                                                </td>
                                                <td class="py-1 px-2 border border-slate-200 dark:border-slate-700">
                                                    <select x-model="row.specId" class="w-full text-xs bg-transparent border-0 focus:ring-0 p-0">
                                                        <option value="">-- Selecionar --</option>
                                                        {% for spec in allSpecs %}
                                                        <option value="{{ spec.id }}">{{ spec.namePt }}</option>
                                                        {% endfor %}
                                                    </select>
                                                </td>
                                                <td class="py-1 px-2 border border-slate-200 dark:border-slate-700 text-slate-500" x-text="getUnit(row.specId)"></td>
                                                {% for size in sub.sizes %}
                                                    {% if size.hasVType %}
                                                    <td class="py-1 px-2 border border-slate-200 dark:border-slate-700">
                                                        <input type="text" x-model="row.values['{{ size.id }}'].v" class="w-full text-xs bg-transparent border-0 focus:ring-0 p-0 text-center">
                                                    </td>
                                                    {% endif %}
                                                    {% if size.hasHType %}
                                                    <td class="py-1 px-2 border border-slate-200 dark:border-slate-700">
                                                        <input type="text" x-model="row.values['{{ size.id }}'].h" class="w-full text-xs bg-transparent border-0 focus:ring-0 p-0 text-center">
                                                    </td>
                                                    {% endif %}
                                                    {% if not size.hasVType and not size.hasHType %}
                                                    <td class="py-1 px-2 border border-slate-200 dark:border-slate-700">
                                                        <input type="text" x-model="row.values['{{ size.id }}'].v" class="w-full text-xs bg-transparent border-0 focus:ring-0 p-0 text-center">
                                                    </td>
                                                    {% endif %}
                                                {% endfor %}
                                                <td class="py-1 px-2 border border-slate-200 dark:border-slate-700 text-center">
                                                    <button type="button" @click="removeRow(rowIdx)" class="text-red-500 hover:text-red-700"><i class="fa-solid fa-trash-can"></i></button>
                                                </td>
                                            </tr>
                                        </template>
                                    </tbody>
                                </table>
                            </div>
                            <div class="flex flex-wrap items-center justify-between gap-2 mt-3">
                                <div class="flex flex-wrap items-center gap-2">
                                    <button type="button" @click="addRow()" class="px-3 py-1.5 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 rounded text-xs transition-colors font-medium">
                                        <i class="fa-solid fa-plus mr-1"></i> Adicionar Linha
                                    </button>
                                    <a href="{{ path('app_admin_subproduct_specs_export_csv', {subproductId: sub.id}) }}" class="px-3 py-1.5 bg-green-600 hover:bg-green-700 text-white rounded text-xs transition-colors font-medium inline-flex items-center gap-1">
                                        <i class="fa-solid fa-file-csv"></i> Exportar CSV
                                    </a>
                                    <form method="post" action="{{ path('app_admin_subproduct_specs_import_csv', {subproductId: sub.id}) }}" enctype="multipart/form-data" class="inline-flex items-center gap-1">
                                        <input type="file" name="csvFile" accept=".csv,text/csv" class="hidden" id="csv-import-{{ sub.id }}" onchange="this.form.submit()">
                                        <button type="button" onclick="document.getElementById('csv-import-{{ sub.id }}').click()" class="px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs transition-colors font-medium inline-flex items-center gap-1">
                                            <i class="fa-solid fa-file-import"></i> Importar CSV
                                        </button>
                                    </form>
                                </div>
                                <button type="button" @click="saveAll()" class="px-4 py-1.5 bg-primary hover:bg-primary-dark text-white rounded text-xs transition-colors font-semibold">
                                    <i class="fa-solid fa-floppy-disk mr-1"></i> Salvar Parâmetros
                                </button>
                            </div>
                        </div>

                        <script>
                        function subSpecTable_{{ sub.id }}() {
                            const sizesData = [
                                {% for size in sub.sizes %}
                                { id: '{{ size.id }}', name: '{{ size.name|e('js') }}', hasV: {{ size.hasVType ? 'true' : 'false' }}, hasH: {{ size.hasHType ? 'true' : 'false' }} },
                                {% endfor %}
                            ];

                            const existingRows = {};
                            {% for size in sub.sizes %}
                                {% for val in size.specValues %}
                                const key_{{ val.id }} = '{{ val.specification.id }}_{{ val.position }}';
                                if (!existingRows[key_{{ val.id }}]) {
                                    existingRows[key_{{ val.id }}] = {
                                        specId: '{{ val.specification.id }}',
                                        position: {{ val.position }},
                                        values: {}
                                    };
                                    sizesData.forEach(s => { existingRows[key_{{ val.id }}].values[s.id] = { v: '', h: '' }; });
                                }
                                existingRows[key_{{ val.id }}].values['{{ val.productSize.id }}'] = {
                                    v: '{{ val.vTypeValue|e('js') }}',
                                    h: '{{ val.hTypeValue|e('js') }}'
                                };
                                {% endfor %}
                            {% endfor %}

                            let initialRows = Object.values(existingRows).sort((a, b) => a.position - b.position);
                            if (initialRows.length === 0) {
                                initialRows = [
                                    {
                                        specId: '',
                                        values: {},
                                        position: 999
                                    }
                                ];
                                sizesData.forEach(s => { initialRows[0].values[s.id] = { v: '', h: '' }; });
                            }

                            return {
                                rows: initialRows,
                                draggedIdx: null,

                                addRow() {
                                    const values = {};
                                    sizesData.forEach(s => { values[s.id] = { v: '', h: '' }; });
                                    this.rows.push({ specId: '', values, position: 999 });
                                },

                                removeRow(idx) {
                                    const row = this.rows[idx];
                                    const specName = specsMap[row.specId]?.name || 'esta linha';
                                    if (!confirm('Remover "' + specName + '" da tabela?\n\nAtenção: clique em "Salvar Parâmetros" para confirmar a remoção.')) return;
                                    this.rows.splice(idx, 1);
                                },

                                moveRow(from, to) {
                                    if (from === null || from === undefined || from === to) return;
                                    const item = this.rows.splice(from, 1)[0];
                                    this.rows.splice(to, 0, item);
                                },

                                getUnit(specId) {
                                    return specsMap[specId]?.unit || '';
                                },

                                async saveAll() {
                                    // Guard: check if there are valid rows
                                    const validRows = this.rows.filter(r => r.specId && r.specId !== '');
                                    if (validRows.length === 0) {
                                        alert('Erro: a tabela não pode ser salva sem nenhuma especificação selecionada.');
                                        return;
                                    }

                                    if (!confirm('Salvar parâmetros? (' + validRows.length + ' linhas válidas)')) return;

                                    this.rows.forEach((row, idx) => {
                                        row.position = idx;
                                    });

                                    try {
                                        const resp = await fetch('{{ path("app_admin_subproduct_specs_save", {subproductId: sub.id}) }}', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ rows: this.rows })
                                        });
                                        const data = await resp.json();
                                        if (data.success) {
                                            alert('Parâmetros salvos com sucesso!');
                                            location.reload();
                                        } else {
                                            alert('Erro: ' + (data.message || 'Falha ao salvar os parâmetros.'));
                                        }
                                    } catch (err) {
                                        alert('Erro de comunicação com o servidor. Seus dados NÃO foram perdidos. Tente novamente.');
                                        console.error('Save error:', err);
                                    }
                                }
                            };
                        }
                        </script>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    <!-- ADD SUBPRODUCT FORM -->
