{% extends 'admin/base.html.twig' %}
{% block title %}Gerenciar Produtos{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">Gerenciar Produtos</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400">Selecione um produto para gerenciar seus parâmetros técnicos, configurações e vídeos</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {% for product in products %}
    <a href="{{ path('app_admin_product_manage_detail', {slug: product.slug}) }}"
       class="admin-card hover:shadow-lg transition-shadow group cursor-pointer flex items-center gap-4">
        
        {# Main subproduct or product image #}
        {% set mainSub = product.defaultSubproduct %}
        {% set imgName = mainSub ? mainSub.imageName : product.imageName %}
        <div class="w-16 h-16 rounded overflow-hidden bg-slate-100 dark:bg-slate-800 flex-shrink-0 flex items-center justify-center border border-slate-200 dark:border-slate-700">
            {% if imgName %}
                <img src="/uploads/products/{{ imgName }}" alt="" class="w-full h-full object-contain p-1">
            {% else %}
                <i class="fa-solid fa-gears text-slate-400 text-2xl"></i>
            {% endif %}
        </div>

        <div>
            <h3 class="text-base font-semibold text-slate-800 dark:text-white group-hover:text-primary transition-colors">
                {{ product.getName('pt') }}
            </h3>
            <p class="text-xs text-slate-500 mt-1">{{ product.slug }}</p>
        </div>
    </a>
    {% endfor %}
</div>
{% endblock %}
