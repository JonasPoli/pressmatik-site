{% extends 'admin/base.html.twig' %}
{% block title %}{{ formTitle }}{% endblock %}
{% block body %}
<div class="page-header">
    <h1 class="page-title">{{ formTitle }}</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400"><a href="{{ path('app_admin_optional_item_index') }}" class="text-primary hover:underline">← Voltar</a></p>
</div>
<form method="post" class="space-y-6">
    <div class="admin-card">
        <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-4">Nomes nos Idiomas</h3>
        {% for lang, label in { pt: '🇧🇷 Português', en: '🇺🇸 Inglês', es: '🇪🇸 Espanhol' } %}
        <fieldset class="border border-slate-200 dark:border-slate-700 rounded-lg p-4 mb-4">
            <legend class="text-xs font-semibold text-slate-500 px-2">{{ label }}</legend>
            <div class="wab-field">
                <label class="wab-label">Nome do Item Opcional</label>
                <input type="text" name="name{{ lang|capitalize }}" value="{{ item ? attribute(item, 'name' ~ lang|capitalize) : '' }}" class="wab-input" {{ lang == 'pt' ? 'required' : '' }}>
            </div>
        </fieldset>
        {% endfor %}
    </div>

    <div class="admin-card">
        <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-4">Ícone Font Awesome & Configurações</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="wab-field">
                <label class="wab-label">Ícone FontAwesome (ex: fa-solid fa-microchip)</label>
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 flex items-center justify-center bg-amber-50 dark:bg-amber-950/40 rounded border border-slate-200 dark:border-slate-700 text-amber-600 dark:text-amber-400 text-lg" id="icon-preview-box">
                        <i id="icon-preview-el" class="{{ item and item.icon ? item.icon : 'fa-solid fa-microchip' }}"></i>
                    </div>
                    <input type="text" id="icon-input" name="icon" value="{{ item ? item.icon : '' }}" placeholder="fa-solid fa-microchip" class="wab-input flex-1" oninput="document.getElementById('icon-preview-el').className = this.value || 'fa-solid fa-microchip'">
                    <button type="button" onclick="openIconPicker('icon-input', 'icon-preview-box')" class="px-3 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg text-xs font-semibold whitespace-nowrap flex items-center gap-1.5 transition-colors shadow-sm cursor-pointer">
                        <i class="fa-solid fa-icons"></i> Escolher Ícone
                    </button>
                </div>
            </div>

            <div class="wab-field">
                <label class="wab-label">Posição</label>
                <input type="number" name="position" value="{{ item ? item.position : 0 }}" class="wab-input" min="0">
            </div>

            <div class="wab-field flex items-end">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="isActive" value="1" {{ (item is null or item.isActive) ? 'checked' : '' }} class="rounded border-slate-300 text-primary">
                    <span class="text-sm text-slate-700 dark:text-slate-300">Ativo</span>
                </label>
            </div>
        </div>
    </div>

    <div class="flex justify-end gap-3">
        <a href="{{ path('app_admin_optional_item_index') }}" class="px-4 py-2 text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors">Cancelar</a>
        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium"><i class="fa-solid fa-save"></i> Salvar</button>
    </div>
</form>
{% endblock %}
