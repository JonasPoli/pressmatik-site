{# Icon Picker Modal — include once in any form that needs icon selection #}
{# Usage:
   1. Include this partial in the form template
   2. Add hidden input: <input type="hidden" name="icon" id="icon-input" value="{{ item ? item.icon : '' }}">
   3. Add preview: <i id="icon-preview" class="{{ item ? item.icon : 'fa-solid fa-icons' }}"></i>
   4. Add button: <button type="button" onclick="openIconPicker('icon-input','icon-preview')">Escolher</button>
#}

<div id="icon-modal-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50 backdrop-blur-sm" onclick="if(event.target===this)closeIconPicker()">
    <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-2xl w-full max-w-2xl max-h-[80vh] flex flex-col mx-4">
        {# Header #}
        <div class="flex items-center justify-between p-4 border-b border-slate-200 dark:border-slate-700">
            <h3 class="text-lg font-semibold text-slate-800 dark:text-white">Escolher Ícone</h3>
            <button type="button" onclick="closeIconPicker()" class="text-slate-400 hover:text-slate-600 dark:hover:text-white">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        {# Search #}
        <div class="p-4 border-b border-slate-200 dark:border-slate-700">
            <input type="text" id="icon-search" placeholder="Buscar ícone..." class="wab-input w-full" oninput="filterIcons(this.value)">
        </div>

        {# Category tabs #}
        <div class="flex flex-wrap gap-1 px-4 pt-3">
            <button type="button" class="icon-tab active" onclick="switchIconTab('all', this)">Todos</button>
            <button type="button" class="icon-tab" onclick="switchIconTab('industry', this)">Indústria</button>
            <button type="button" class="icon-tab" onclick="switchIconTab('tools', this)">Ferramentas</button>
            <button type="button" class="icon-tab" onclick="switchIconTab('arrows', this)">Setas</button>
            <button type="button" class="icon-tab" onclick="switchIconTab('business', this)">Negócios</button>
            <button type="button" class="icon-tab" onclick="switchIconTab('general', this)">Geral</button>
        </div>

        {# Icon grid #}
        <div id="icon-grid" class="grid grid-cols-8 sm:grid-cols-10 gap-1 p-4 overflow-y-auto flex-1" style="max-height:50vh"></div>

        {# Preview pane #}
        <div id="icon-pane" class="flex items-center gap-3 p-4 border-t border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 rounded-b-2xl">
            <i id="icon-pane-preview" class="fa-solid fa-icons text-3xl text-primary"></i>
            <span id="icon-pane-name" class="text-sm text-slate-600 dark:text-slate-400 font-mono">Nenhum ícone selecionado</span>
        </div>
    </div>
</div>

<style>
    #icon-modal-overlay.open { display: flex; }
    .icon-tab {
        padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 500;
        background: transparent; color: #64748b; border: 1px solid #e2e8f0; cursor: pointer;
    }
    .dark .icon-tab { color: #94a3b8; border-color: #334155; }
    .icon-tab.active { background: #4f8ef7; color: white; border-color: #4f8ef7; }
    .icon-cell {
        display: flex; align-items: center; justify-content: center;
        width: 40px; height: 40px; border-radius: 8px; cursor: pointer; font-size: 16px;
        color: #475569; transition: all 0.15s;
    }
    .dark .icon-cell { color: #cbd5e1; }
    .icon-cell:hover { background: #e2e8f0; color: #1e293b; transform: scale(1.15); }
    .dark .icon-cell:hover { background: #334155; color: white; }
    .icon-cell.selected { background: #4f8ef7; color: white; }
</style>

<script>
(function() {
    let _pickerTarget = null, _pickerPreview = null, _currentTab = 'all';

    // Curated icon list for industrial/press context (100% FA6 Free valid)
    const ICON_LIST = [
        // Industry & Manufacturing
        'fa-solid fa-industry', 'fa-solid fa-gears', 'fa-solid fa-gear',
        'fa-solid fa-wrench', 'fa-solid fa-screwdriver-wrench', 'fa-solid fa-hammer',
        'fa-solid fa-toolbox', 'fa-solid fa-helmet-safety',
        'fa-solid fa-warehouse', 'fa-solid fa-truck', 'fa-solid fa-truck-fast',
        'fa-solid fa-boxes-stacked', 'fa-solid fa-box',
        'fa-solid fa-gauge-high', 'fa-solid fa-gauge', 'fa-solid fa-temperature-half',
        'fa-solid fa-bolt', 'fa-solid fa-plug', 'fa-solid fa-oil-can', 'fa-solid fa-fire',
        // Tools & Engineering
        'fa-solid fa-ruler-combined', 'fa-solid fa-ruler',
        'fa-solid fa-compass-drafting', 'fa-solid fa-pen-ruler',
        'fa-solid fa-cube', 'fa-solid fa-cubes', 'fa-solid fa-layer-group',
        'fa-solid fa-microchip', 'fa-solid fa-memory', 'fa-solid fa-robot',
        'fa-solid fa-sliders', 'fa-solid fa-microscope',
        'fa-solid fa-flask', 'fa-solid fa-vial', 'fa-solid fa-atom',
        // Arrows & Navigation
        'fa-solid fa-arrow-right', 'fa-solid fa-arrow-left', 'fa-solid fa-arrow-up',
        'fa-solid fa-arrow-down', 'fa-solid fa-arrows-rotate', 'fa-solid fa-rotate',
        'fa-solid fa-chevron-right', 'fa-solid fa-chevron-left', 'fa-solid fa-chevron-up',
        'fa-solid fa-chevron-down', 'fa-solid fa-angles-right', 'fa-solid fa-angles-left',
        'fa-solid fa-arrow-up-right-from-square', 'fa-solid fa-maximize', 'fa-solid fa-expand',
        'fa-solid fa-compress',
        // Business & Finance
        'fa-solid fa-gem', 'fa-solid fa-diamond', 'fa-regular fa-gem',
        'fa-solid fa-building', 'fa-solid fa-building-columns', 'fa-solid fa-briefcase',
        'fa-solid fa-chart-line', 'fa-solid fa-chart-bar', 'fa-solid fa-chart-pie',
        'fa-solid fa-handshake', 'fa-solid fa-hand-holding-dollar', 'fa-solid fa-coins',
        'fa-solid fa-trophy', 'fa-solid fa-award', 'fa-solid fa-medal',
        'fa-solid fa-certificate', 'fa-solid fa-star', 'fa-solid fa-crown',
        'fa-solid fa-bullseye', 'fa-solid fa-crosshairs',
        'fa-solid fa-users', 'fa-solid fa-user-tie', 'fa-solid fa-people-group',
        // General & UI
        'fa-solid fa-shield-halved', 'fa-solid fa-shield', 'fa-solid fa-lock',
        'fa-solid fa-key', 'fa-solid fa-eye', 'fa-solid fa-lightbulb',
        'fa-solid fa-bell', 'fa-solid fa-clock', 'fa-solid fa-calendar',
        'fa-solid fa-phone', 'fa-solid fa-envelope', 'fa-solid fa-globe',
        'fa-solid fa-location-dot', 'fa-solid fa-earth-americas',
        'fa-solid fa-check', 'fa-solid fa-check-double', 'fa-solid fa-circle-check',
        'fa-solid fa-heart', 'fa-solid fa-thumbs-up',
        'fa-solid fa-leaf', 'fa-solid fa-seedling', 'fa-solid fa-recycle',
        'fa-solid fa-truck-ramp-box', 'fa-solid fa-dolly',
        'fa-solid fa-stopwatch', 'fa-solid fa-hourglass-half', 'fa-solid fa-rocket',
        'fa-solid fa-paper-plane', 'fa-solid fa-flag', 'fa-solid fa-bookmark',
        'fa-solid fa-tag', 'fa-solid fa-tags', 'fa-solid fa-code',
        'fa-solid fa-wand-magic-sparkles', 'fa-solid fa-palette',
        'fa-solid fa-image', 'fa-solid fa-file', 'fa-solid fa-folder',
        'fa-solid fa-download', 'fa-solid fa-upload', 'fa-solid fa-link',
        'fa-solid fa-comment', 'fa-solid fa-comments', 'fa-solid fa-message',
        'fa-solid fa-circle-info', 'fa-solid fa-circle-question', 'fa-solid fa-circle-exclamation',
    ];

    const CATEGORIES = {
        all: () => ICON_LIST,
        industry: () => ICON_LIST.filter(i => {
            const n = i.split('fa-').pop();
            return ['industry','gear','cog','wrench','hammer','toolbox','helmet','hard-hat','warehouse','truck','box','pallet','gauge','tachometer','temperature','bolt','plug','battery','oil','pump','fire','boxes'].some(k => n.includes(k));
        }),
        tools: () => ICON_LIST.filter(i => {
            const n = i.split('fa-').pop();
            return ['ruler','compass','drafting','pen-ruler','pencil','cube','layer','microchip','memory','robot','slider','microscope','flask','vial','atom','screwdriver'].some(k => n.includes(k));
        }),
        arrows: () => ICON_LIST.filter(i => {
            const n = i.split('fa-').pop();
            return ['arrow','chevron','angle','rotate','expand','compress','maximize','up-down'].some(k => n.includes(k));
        }),
        business: () => ICON_LIST.filter(i => {
            const n = i.split('fa-').pop();
            return ['building','briefcase','chart','handshake','hand-holding','coin','trophy','award','medal','certificate','star','crown','bullseye','crosshair','target','users','user-tie','people'].some(k => n.includes(k));
        }),
        general: () => ICON_LIST.filter(i => {
            const n = i.split('fa-').pop();
            return ['shield','lock','key','eye','lightbulb','bell','clock','calendar','phone','envelope','globe','map','location','earth','check','heart','thumbs','hand-peace','leaf','seedling','recycle','rocket','paper','flag','bookmark','tag','code','wand','paint','palette','image','file','folder','download','upload','link','comment','message','circle-info','circle-question','circle-exclamation'].some(k => n.includes(k));
        }),
    };

    function renderIcons(list) {
        const grid = document.getElementById('icon-grid');
        grid.innerHTML = '';
        list.forEach(ic => {
            const div = document.createElement('div');
            div.className = 'icon-cell';
            div.title = ic;
            div.innerHTML = `<i class="${ic}"></i>`;
            div.onclick = () => selectIcon(ic);
            div.onmouseenter = () => previewIcon(ic);
            grid.appendChild(div);
        });
    }

    function previewIcon(ic) {
        document.getElementById('icon-pane-preview').className = ic + ' text-3xl text-primary';
        document.getElementById('icon-pane-name').textContent = ic;
    }

    function selectIcon(ic) {
        if (_pickerTarget) _pickerTarget.value = ic;
        if (_pickerPreview) _pickerPreview.className = ic;
        closeIconPicker();
    }

    window.openIconPicker = function(inputId, previewId) {
        _pickerTarget = document.getElementById(inputId);
        _pickerPreview = document.getElementById(previewId);
        document.getElementById('icon-search').value = '';
        _currentTab = 'all';
        document.querySelectorAll('.icon-tab').forEach((t,i) => {
            t.classList.toggle('active', i === 0);
        });
        renderIcons(ICON_LIST);
        document.getElementById('icon-modal-overlay').classList.add('open');
        document.getElementById('icon-search').focus();
        if (_pickerTarget && _pickerTarget.value) {
            previewIcon(_pickerTarget.value);
        }
    };

    window.closeIconPicker = function() {
        document.getElementById('icon-modal-overlay').classList.remove('open');
    };

    window.filterIcons = function(query) {
        const list = CATEGORIES[_currentTab]();
        if (!query) { renderIcons(list); return; }
        let term = query.toLowerCase().trim();

        const ALIASES = {
            'diamante': ['gem', 'diamond'],
            'diamantes': ['gem', 'diamond'],
            'joia': ['gem'],
            'gema': ['gem'],
            'engrenagem': ['gear', 'gears'],
            'ferramenta': ['wrench', 'toolbox', 'screwdriver', 'hammer'],
            'industria': ['industry'],
            'estrela': ['star'],
            'trofeu': ['trophy'],
            'medalha': ['medal'],
            'coroa': ['crown']
        };

        let searchTerms = [term];
        if (ALIASES[term]) {
            searchTerms = searchTerms.concat(ALIASES[term]);
        }

        renderIcons(list.filter(ic => {
            const icLower = ic.toLowerCase();
            return searchTerms.some(st => icLower.includes(st));
        }));
    };

    window.switchIconTab = function(category, btn) {
        document.querySelectorAll('.icon-tab').forEach(t => t.classList.remove('active'));
        btn.classList.add('active');
        _currentTab = category;
        document.getElementById('icon-search').value = '';
        renderIcons(CATEGORIES[category]());
    };
})();
</script>
