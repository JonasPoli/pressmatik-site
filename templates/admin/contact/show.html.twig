{% extends 'admin/base.html.twig' %}
{% block title %}Mensagem de {{ item.name }}{% endblock %}
{% block body %}
<div class="page-header">
    <h1 class="page-title">Mensagem de {{ item.name }}</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400"><a href="{{ path('app_admin_contact_index') }}" class="text-primary hover:underline">← Voltar</a></p>
</div>
<div class="admin-card">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
            <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-3">Dados do Contato</h3>
            <dl class="space-y-2 text-sm">
                <div class="flex"><dt class="w-28 text-slate-500 flex-shrink-0">Nome:</dt><dd class="text-slate-800 dark:text-white font-medium">{{ item.name }}</dd></div>
                <div class="flex"><dt class="w-28 text-slate-500 flex-shrink-0">E-mail:</dt><dd><a href="mailto:{{ item.email }}" class="text-primary hover:underline">{{ item.email }}</a></dd></div>
                {% if item.phone %}<div class="flex"><dt class="w-28 text-slate-500 flex-shrink-0">Telefone:</dt><dd class="text-slate-800 dark:text-white">{{ item.phone }}</dd></div>{% endif %}
                {% if item.cpfCnpj %}<div class="flex"><dt class="w-28 text-slate-500 flex-shrink-0">CPF/CNPJ:</dt><dd class="text-slate-800 dark:text-white">{{ item.cpfCnpj }}</dd></div>{% endif %}
                {% if item.company %}<div class="flex"><dt class="w-28 text-slate-500 flex-shrink-0">Empresa:</dt><dd class="text-slate-800 dark:text-white">{{ item.company }}</dd></div>{% endif %}
            </dl>
        </div>
        <div>
            <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-3">Detalhes</h3>
            <dl class="space-y-2 text-sm">
                <div class="flex"><dt class="w-28 text-slate-500 flex-shrink-0">Tipo:</dt><dd>
                    {% if item.type == 'quote' %}<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">Cotação</span>
                    {% else %}<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">Contato</span>{% endif %}
                </dd></div>
                <div class="flex"><dt class="w-28 text-slate-500 flex-shrink-0">Data:</dt><dd class="text-slate-800 dark:text-white">{{ item.createdAt|date('d/m/Y H:i') }}</dd></div>
                {% if item.productSlug %}<div class="flex"><dt class="w-28 text-slate-500 flex-shrink-0">Produto:</dt><dd class="text-slate-800 dark:text-white">{{ item.productSlug }}</dd></div>{% endif %}
                {% if item.productInterest %}<div class="flex"><dt class="w-28 text-slate-500 flex-shrink-0">Interesse:</dt><dd class="text-slate-800 dark:text-white">{{ item.productInterest }}</dd></div>{% endif %}
            </dl>
        </div>
    </div>
    {% if item.message %}
    <div class="mt-6 pt-6 border-t border-slate-200 dark:border-slate-700">
        <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-3">Mensagem</h3>
        <div class="bg-slate-50 dark:bg-slate-900 rounded-lg p-4 text-sm text-slate-700 dark:text-slate-300 whitespace-pre-wrap">{{ item.message }}</div>
    </div>
    {% endif %}
</div>
{% endblock %}
