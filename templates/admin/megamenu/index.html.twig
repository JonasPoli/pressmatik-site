{% extends 'admin/base.html.twig' %}

{% block title %}Gerenciar Imagens do MegaMenu{% endblock %}

{% block body %}
<div class="page-header flex items-center justify-between">
    <div>
        <h1 class="page-title">Imagens do MegaMenu</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400">Gerenciamento das imagens de capa para as categorias do menu superior (MegaMenu)</p>
    </div>
    <a href="{{ path('app_admin_megamenu_seed') }}" class="btn-primary text-xs flex items-center gap-2">
        <i class="fa-solid fa-rotate"></i> Inicializar Categorias Padrão
    </a>
</div>

<div class="admin-card">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
            <thead>
                <tr class="border-b border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400">
                    <th class="py-3 px-4">Capa/Imagem</th>
                    <th class="py-3 px-4">Categoria / Chave</th>
                    <th class="py-3 px-4">Título Exibido</th>
                    <th class="py-3 px-4 text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                <tr class="border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/50">
                    <td class="py-3 px-4">
                        <div class="w-20 h-14 rounded overflow-hidden bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 flex items-center justify-center">
                            <img src="{{ item.imageUrl }}" alt="" class="w-full h-full object-cover">
                        </div>
                    </td>
                    <td class="py-3 px-4 font-mono text-xs text-slate-600 dark:text-slate-300">
                        {{ item.categoryKey }}
                    </td>
                    <td class="py-3 px-4 font-medium text-slate-800 dark:text-slate-200">
                        {{ item.titlePt ?: item.categoryKey }}
                    </td>
                    <td class="py-3 px-4 text-right">
                        <a href="{{ path('app_admin_megamenu_edit', {id: item.id}) }}" class="inline-flex items-center gap-1 px-3 py-1.5 bg-primary/10 text-primary hover:bg-primary hover:text-white rounded-lg transition-colors text-xs font-semibold">
                            <i class="fa-solid fa-pen-to-square"></i> Alterar Imagem
                        </a>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="py-8 text-center text-slate-500">
                        <p class="mb-3">Nenhuma categoria cadastrada.</p>
                        <a href="{{ path('app_admin_megamenu_seed') }}" class="btn-primary inline-flex items-center gap-2 text-xs">
                            <i class="fa-solid fa-rotate"></i> Carregar 5 Categorias Padrão Agora
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
