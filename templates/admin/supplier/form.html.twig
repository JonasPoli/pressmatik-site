{% extends 'admin/base.html.twig' %}
{% block title %}{{ formTitle }}{% endblock %}
{% block body %}
<div class="page-header">
    <h1 class="page-title">{{ formTitle }}</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400"><a href="{{ path('app_admin_supplier_index') }}" class="text-primary hover:underline">← Voltar</a></p>
</div>
<form method="post" enctype="multipart/form-data" class="space-y-6">
    <div class="admin-card">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="wab-field"><label class="wab-label">Nome</label><input type="text" name="name" value="{{ item ? item.name : '' }}" class="wab-input" required></div>
            <div class="wab-field"><label class="wab-label">Website URL</label><input type="url" name="websiteUrl" value="{{ item ? item.websiteUrl : '' }}" class="wab-input" placeholder="https://..."></div>
            <div class="wab-field"><label class="wab-label">Posição</label><input type="number" name="position" value="{{ item ? item.position : 0 }}" class="wab-input" min="0"></div>
        </div>
        <div class="mt-4"><label class="flex items-center gap-2 cursor-pointer"><input type="checkbox" name="isActive" value="1" {{ (item is null or item.isActive) ? 'checked' : '' }} class="rounded border-slate-300 text-primary"><span class="text-sm text-slate-700 dark:text-slate-300">Ativo</span></label></div>
    </div>
    <div class="admin-card">
        <label class="wab-label">Logo</label>
        {% if item and item.imageName %}
            <div class="mb-2">
                <img src="/uploads/suppliers/{{ item.imageName }}" alt="" class="max-h-20 rounded bg-slate-100 p-2 border border-slate-200">
                <div class="mt-2">
                    <label class="inline-flex items-center gap-1.5 text-xs text-red-500 cursor-pointer">
                        <input type="checkbox" name="deleteImage" value="1" class="rounded border-slate-300 text-red-600 focus:ring-red-500"> Remover logo atual
                    </label>
                </div>
            </div>
        {% endif %}
        <input type="file" name="imageFile" accept="image/*" class="wab-input" {% if item is null %}required{% endif %}>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            <strong>Resolução indicada:</strong> 400 × 200 px (ou 300 × 300 px) &nbsp;|&nbsp; <strong>Proporção recomendada:</strong> 2:1 ou 1:1 &nbsp;|&nbsp; <strong>Formatos:</strong> PNG transparente ou WebP
        </p>
    </div>
    <div class="flex justify-end gap-3">
        <a href="{{ path('app_admin_supplier_index') }}" class="px-4 py-2 text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors">Cancelar</a>
        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium"><i class="fa-solid fa-save"></i> Salvar</button>
    </div>
</form>
{% endblock %}
