<!DOCTYPE html>
<html lang="pt-BR" class="{{ app.user and is_granted('ROLE_PREVIOUS_ADMIN') ? 'impersonating' : '' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin{% endblock %} · Pressmatik</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#0f1117">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    {# Tailwind CDN for admin area #}
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        primary: { DEFAULT: '#4f8ef7', light: '#6fa3ff', dark: '#3b7de0' },
                    }
                }
            }
        }
    </script>

    {{ importmap('app') }}

    {% block stylesheets %}{% endblock %}

    <script>
        (function(){
            const t = localStorage.getItem('theme');
            const dark = t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.classList.toggle('dark', dark);
        })();
    </script>
</head>
<body class="admin-body" data-controller="nav">

{% if app.user and is_granted('ROLE_PREVIOUS_ADMIN') %}
    <div class="impersonate-banner" role="alert">
        <span>
            <i class="fa-solid fa-mask" aria-hidden="true"></i>
            Você está navegando como <strong>{{ app.user.userIdentifier }}</strong>
        </span>
        <a href="{{ path('app_admin_user_index', {'_switch_user': '_exit'}) }}"
        class="impersonate-exit"
        aria-label="Sair da impersonação e voltar ao seu usuário">
            <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
            Sair da impersonação
        </a>
    </div>
{% endif %}

{# ══════════════════════════════════════════════════════════════════════════
   SIDEBAR
   ══════════════════════════════════════════════════════════════════════════ #}
<aside class="admin-sidebar"
       id="admin-sidebar"
       data-nav-target="sidebar"
       aria-label="Menu de navegação">

    {# ── Brand ─────────────────────────────────────────────────────────── #}
    <div class="sidebar-brand flex items-center justify-center p-4 border-b border-slate-200/80 dark:border-white/10" style="height: 72px;">
        <a href="{{ path('admin_dash') }}" class="block">
            <img src="/images/logo-fundo-branco.png" alt="Pressmatik Logo" class="h-8 dark:hidden mx-auto">
            <img src="/images/logo-fundo-preto.png" alt="Pressmatik Logo" class="h-8 hidden dark:block mx-auto">
        </a>
    </div>

    {# ── Nav ───────────────────────────────────────────────────────────── #}
    <nav class="sidebar-nav" aria-label="Navegação principal">

        <div class="sidebar-section-label">Principal</div>

        <a {{nav_item_class('admin_dash')}} href="{{ path('admin_dash') }}">
            <i class="fa-solid fa-house" aria-hidden="true"></i>
            <span>Dashboard</span>
        </a>

        <a {{nav_item_class('app_admin_user')}} href="{{ path('app_admin_user_index') }}">
            <i class="fa-solid fa-users" aria-hidden="true"></i>
            <span>Usuários</span>
        </a>

        <div class="sidebar-section-label">Institucional</div>

        <a {{nav_item_class('app_admin_about')}} href="{{ path('app_admin_about_edit') }}">
            <i class="fa-solid fa-building" aria-hidden="true"></i>
            <span>Quem Somos</span>
        </a>

        <a {{nav_item_class('app_admin_history')}} href="{{ path('app_admin_history_index') }}">
            <i class="fa-solid fa-timeline" aria-hidden="true"></i>
            <span>Linha do Tempo</span>
        </a>

        <a {{nav_item_class('app_admin_testimony')}} href="{{ path('app_admin_testimony_index') }}">
            <i class="fa-solid fa-comments" aria-hidden="true"></i>
            <span>Depoimentos</span>
        </a>

        <a {{nav_item_class('app_admin_client_logo')}} href="{{ path('app_admin_client_logo_index') }}">
            <i class="fa-solid fa-images" aria-hidden="true"></i>
            <span>Clientes</span>
        </a>

        <a {{nav_item_class('app_admin_differential')}} href="{{ path('app_admin_differential_index') }}">
            <i class="fa-solid fa-star" aria-hidden="true"></i>
            <span>Diferenciais</span>
        </a>

        <a {{nav_item_class('app_admin_supplier')}} href="{{ path('app_admin_supplier_index') }}">
            <i class="fa-solid fa-handshake" aria-hidden="true"></i>
            <span>Fornecedores</span>
        </a>

        <a {{nav_item_class('app_admin_quality')}} href="{{ path('app_admin_quality_index') }}">
            <i class="fa-solid fa-certificate" aria-hidden="true"></i>
            <span>Certificações</span>
        </a>

        <a {{nav_item_class('app_admin_success_case')}} href="{{ path('app_admin_success_case_index') }}">
            <i class="fa-solid fa-trophy" aria-hidden="true"></i>
            <span>Cases de Sucesso</span>
        </a>

        <a {{nav_item_class('app_admin_org_chart')}} href="{{ path('app_admin_org_chart_index') }}">
            <i class="fa-solid fa-sitemap" aria-hidden="true"></i>
            <span>Organograma</span>
        </a>

        <a {{nav_item_class('app_admin_banner')}} href="{{ path('app_admin_banner_index') }}">
            <i class="fa-solid fa-panorama" aria-hidden="true"></i>
            <span>Banners</span>
        </a>

        <div class="sidebar-section-label">Produtos</div>

        <a {{nav_item_class('app_admin_tech_spec')}} href="{{ path('app_admin_tech_spec_index') }}">
            <i class="fa-solid fa-ruler-combined" aria-hidden="true"></i>
            <span>Especificações Téc.</span>
        </a>

        <a {{nav_item_class('app_admin_product_manage')}} href="{{ path('app_admin_product_manage_index') }}">
            <i class="fa-solid fa-gears" aria-hidden="true"></i>
            <span>Gerenciar Produtos</span>
        </a>

        <a {{nav_item_class('app_admin_application')}} href="{{ path('app_admin_application_index') }}">
            <i class="fa-solid fa-briefcase" aria-hidden="true"></i>
            <span>Aplicações</span>
        </a>

        <div class="sidebar-section-label">Conteúdo</div>

        <a {{nav_item_class('app_admin_service')}} href="{{ path('app_admin_service_index') }}">
            <i class="fa-solid fa-wrench" aria-hidden="true"></i>
            <span>Serviços</span>
        </a>

        <a {{nav_item_class('app_admin_news')}} href="{{ path('app_admin_news_index') }}">
            <i class="fa-solid fa-newspaper" aria-hidden="true"></i>
            <span>Notícias</span>
        </a>

        <div class="sidebar-section-label">Atendimento</div>

        <a {{nav_item_class('app_admin_contact')}} href="{{ path('app_admin_contact_index') }}">
            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
            <span>Mensagens</span>
        </a>

        {% block sidebar_links %}{% endblock %}

    </nav>

    {# ── Footer ────────────────────────────────────────────────────────── #}
    <div class="sidebar-footer">
        <div class="sidebar-user">
            <div class="sidebar-user-avatar" aria-hidden="true"
                 style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#4f8ef7,#a855f7);color:white;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0">
                {{ (app.user.name ?? app.user.userIdentifier)|first|upper }}
            </div>
            <div class="sidebar-user-info" style="min-width:0;flex:1">
                <span class="sidebar-user-name">{{ app.user.name ?? app.user.userIdentifier }}</span>
                <span class="sidebar-user-role">Administrador</span>
            </div>
        </div>
        <a href="{{ path('app_logout') }}"
                class="theme-toggle"
                aria-label="Sair"
                title="Sair">
            <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
        </a>
    </div>

</aside>

{# ══════════════════════════════════════════════════════════════════════════
   MAIN WRAPPER
   ══════════════════════════════════════════════════════════════════════════ #}
<div class="admin-main" id="admin-main">

    {# ── Mobile topbar ─────────────────────────────────────────────────── #}
    <header class="admin-topbar" aria-label="Cabeçalho">
        <button type="button"
                class="topbar-menu-btn"
                data-action="click->nav#toggleSidebar"
                aria-expanded="false"
                aria-controls="admin-sidebar"
                aria-label="Abrir menu">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>

        <div class="topbar-breadcrumbs">
            {% block breadcrumbs %}{% endblock %}
        </div>

        <div class="topbar-actions">
            <button type="button"
                    class="topbar-icon-btn"
                    id="theme-btn-topbar"
                    onclick="document.documentElement.classList.contains('dark') ? lightMode() : darkMode(); updateThemeIcons()"
                    aria-label="Alternar tema"
                    title="Alternar tema">
                <i class="fa-regular fa-sun" id="theme-icon-topbar" aria-hidden="true"></i>
            </button>
        </div>
    </header>

    {% if app.flashes|length > 0 %}
        <div class="flash-container" aria-live="polite">
            {{ include('admin/_partials/flash.html.twig') }}
        </div>
    {% endif %}

    <main class="admin-content" id="main-content">
        {% block body %}{% endblock %}
    </main>

</div>

{# ── Mobile overlay ────────────────────────────────────────────────────── #}
<div class="sidebar-overlay" data-nav-target="overlay" data-action="click->nav#closeSidebar" aria-hidden="true"></div>

{# ── Icon Picker Modal ── #}
<div id="icon-modal-overlay">
    <div id="icon-modal">
        <div style="display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e2e8f0;padding-bottom:.75rem">
            <div style="display:flex;align-items:center;gap:.6rem">
                <i class="fa-solid fa-star text-primary" style="font-size:1.2rem;vertical-align:middle;filter:drop-shadow(0 0 8px rgba(213,28,35,0.4))"></i>
                <span style="font-weight:800;font-size:1.15rem;letter-spacing:-.01em">Escolher Ícone Font Awesome</span>
            </div>
            <button type="button" onclick="closeIconPicker()" style="background:none;border:none;cursor:pointer;color:#64748b;font-size:1.4rem;display:flex;align-items:center;transition:color 0.2s" onmouseover="this.style.color='#D51C23'" onmouseout="this.style.color='#64748b'">✕</button>
        </div>
        <div class="icon-search-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="icon-search" placeholder="Pesquisar mais de 600 ícones... ex: home, school, facebook" oninput="filterIcons(this.value)">
        </div>
        <div class="icon-tabs" id="icon-tabs-container">
            <button type="button" class="icon-tab active" onclick="switchIconTab('all', this)">Todos</button>
            <button type="button" class="icon-tab" onclick="switchIconTab('edu', this)">Educação & Cursos</button>
            <button type="button" class="icon-tab" onclick="switchIconTab('biz', this)">Negócios & Web</button>
            <button type="button" class="icon-tab" onclick="switchIconTab('brands', this)">Marcas & Redes</button>
            <button type="button" class="icon-tab" onclick="switchIconTab('media', this)">Interface & Mídia</button>
            <button type="button" class="icon-tab" onclick="switchIconTab('health', this)">Saúde & Esporte</button>
            <button type="button" class="icon-tab" onclick="switchIconTab('arrows', this)">Setas & Navegação</button>
        </div>
        <div class="icon-grid" id="icon-grid-container"></div>
        
        <!-- Live Preview Pane -->
        <div id="icon-preview-pane" style="display:flex;align-items:center;gap:1.25rem;padding:0.85rem 1.15rem;background:rgba(0,0,0,0.03);border:1px solid #e2e8f0;border-radius:14px;margin-top:0.25rem;min-height:68px;transition:all 0.2s ease">
            <div id="icon-preview-pane-icon" style="font-size:2rem;width:48px;height:48px;background:rgba(213,28,35,0.1);border:1px solid rgba(213,28,35,0.25);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#D51C23;transition:all .18s ease">
                <i class="fa-solid fa-face-smile"></i>
            </div>
            <div style="display:flex;flex-direction:column;gap:0.2rem">
                <span id="icon-preview-pane-name" style="font-size:0.9rem;font-weight:700;font-family:monospace;letter-spacing:0.02em">fa-solid fa-face-smile</span>
                <span id="icon-preview-pane-desc" style="font-size:0.76rem;color:#64748b">Passe o mouse sobre qualquer ícone da lista para ver os detalhes em tempo real</span>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded',()=>{
    loadIconsFromStylesheets();
    
    // Configura o ouvinte de rolagem infinita (Infinite Scroll)
    const grid = document.getElementById('icon-grid-container');
    if (grid) {
        grid.addEventListener('scroll', function() {
            if (this.scrollTop + this.clientHeight >= this.scrollHeight - 40) {
                appendMoreIcons();
            }
        });
    }
});

