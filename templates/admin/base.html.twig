        'backward-step', 'arrow-right-to-bracket', 'arrow-right-from-bracket', 'sign-in-alt', 'sign-out-alt',
        'reply', 'share', 'location-arrow', 'compass', 'map-pin', 'location-dot', 'route', 'road',
        'map-location-dot', 'map-location', 'paper-plane',
        
        // Marcas & Redes
        'instagram', 'facebook', 'facebook-f', 'youtube', 'linkedin', 'linkedin-in', 'whatsapp',
        'twitter', 'tiktok', 'github', 'google', 'apple', 'microsoft', 'android', 'amazon',
        'wordpress', 'paypal', 'stripe', 'spotify', 'slack', 'discord', 'figma', 'sass',
        'html5', 'css3', 'js', 'react', 'vue', 'angular', 'node', 'python', 'php', 'docker',
        'git', 'aws', 'digital-ocean', 'cloudflare', 'stack-overflow', 'medium', 'vimeo',
        'tumblr', 'pinterest', 'snapchat', 'reddit', 'quora', 'telegram', 'skype', 'zoom',
        'trello', 'behance', 'dribbble', 'flickr', 'deviantart', 'steam', 'twitch', 'xbox',
        'playstation', 'nintendo-switch', 'google-play', 'app-store'
    ];
    
    staticList.forEach(name => iconSet.add(name));

    try {
        for (let sheet of document.styleSheets) {
            try {
                if (sheet.href && (sheet.href.includes('font-awesome') || sheet.href.includes('all.min.css'))) {
                    const rules = sheet.cssRules || sheet.rules;
                    if (rules) {
                        for (let rule of rules) {
                            if (rule.selectorText) {
                                const matches = rule.selectorText.match(/\.fa-([a-z0-9-]+)::before/g);
                                if (matches) {
                                    for (let match of matches) {
                                        const iconName = match.replace(/^\.fa-/, '').replace(/::before/, '');
                                        if (!['lg', '2xs', 'xs', 'sm', 'xl', '2xl', '3xl', '4xl', '5xl', '6xl', '7xl', '8xl', '9xl', '10xl', '2x', '3x', '4x', '5x', '6x', '7x', '8x', '9x', '10x', 'fw', 'ul', 'li', 'border', 'pull-left', 'pull-right', 'spin', 'pulse', 'rotate-90', 'rotate-180', 'rotate-270', 'flip-horizontal', 'flip-vertical', 'flip-both', 'stack', 'stack-1x', 'stack-2x', 'inverse', 'solid', 'regular', 'light', 'thin', 'duotone', 'brands'].includes(iconName)) {
                                            iconSet.add(iconName);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } catch (e) {}
        }
    } catch (globalErr) {}

    FA_ICONS = Array.from(iconSet).map(name => {
        const prefix = getIconPrefix(name);
        return `${prefix} fa-${name}`;
    }).sort();
}

function openIconPicker(inputId, previewId) {
    _pickerTarget = document.getElementById(inputId);
    _pickerPreview = document.getElementById(previewId);
    
    loadIconsFromStylesheets();
    document.getElementById('icon-search').value = '';
    
    const tabs = document.querySelectorAll('.icon-tab');
    tabs.forEach(t => t.classList.remove('active'));
    if (tabs[0]) tabs[0].classList.add('active');
    _currentTab = 'all';
    
    renderIcons(FA_ICONS, true);
    document.getElementById('icon-modal-overlay').classList.add('open');
    document.getElementById('icon-search').focus();
    
    if (_pickerTarget && _pickerTarget.value) {
        previewIcon(_pickerTarget.value);
    } else {
        resetPanePreview();
    }
}

function closeIconPicker() {
    document.getElementById('icon-modal-overlay').classList.remove('open');
}

function switchIconTab(category, btn) {
    const tabs = document.querySelectorAll('.icon-tab');
    tabs.forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    
    _currentTab = category;
    document.getElementById('icon-search').value = '';
    
    const list = getCategorizedIcons(category);
    renderIcons(list, true);
}

function getCategorizedIcons(category) {
    if (category === 'all') return FA_ICONS;
    
    return FA_ICONS.filter(ic => {
        const parts = ic.split(' ');
        const prefix = parts[0];
        const name = parts[1].replace('fa-', '');
        
        if (category === 'brands') {
            return prefix === 'fa-brands';
        }
        
        if (category === 'edu') {
            const keywords = ['graduation', 'book', 'school', 'teacher', 'university', 'college', 'pencil', 'pen', 'brain', 'microscope', 'flask', 'award', 'trophy', 'medal', 'calculator', 'ruler', 'certificate', 'shapes', 'palette', 'dna', 'atlas', 'language'];
            return keywords.some(k => name.includes(k));
        }
        
        if (category === 'biz') {
            const keywords = ['briefcase', 'building', 'store', 'shop', 'shopping', 'credit', 'wallet', 'piggy', 'bank', 'chart', 'tachometer', 'handshake', 'globe', 'server', 'database', 'cloud', 'wifi', 'shield', 'key', 'lock', 'envelope', 'phone', 'bell', 'dollar', 'euro', 'coin', 'receipt', 'invoice', 'vault', 'stamp', 'signature'];
            return keywords.some(k => name.includes(k));
        }
        
        if (category === 'media') {
            const keywords = ['image', 'photo', 'video', 'play', 'music', 'microphone', 'headphones', 'camera', 'film', 'gear', 'tool', 'wrench', 'hammer', 'trash', 'edit', 'check', 'times', 'info', 'question', 'exclamation', 'search', 'filter', 'sort', 'list', 'bars', 'ellipsis', 'clock', 'calendar'];
            return keywords.some(k => name.includes(k));
        }
        
        if (category === 'health') {
            const keywords = ['heart', 'stethoscope', 'hospital', 'doctor', 'nurse', 'injured', 'kit', 'pills', 'syringe', 'wheelchair', 'virus', 'microbe', 'lungs', 'spa', 'dumbbell', 'running', 'hiking', 'swimming', 'biking', 'walking', 'bicycle', 'carrot', 'lemon', 'sport', 'soccer', 'football', 'basketball', 'baseball', 'tennis', 'trophy', 'medal', 'volleyball', 'golf', 'bowling', 'child'];
            return keywords.some(k => name.includes(k));
        }
        
        if (category === 'arrows') {
            const keywords = ['arrow', 'chevron', 'caret', 'exchange', 'rotate', 'sync', 'repeat', 'spin', 'location', 'compass', 'map-pin', 'direction', 'route', 'road', 'sign', 'plane', 'paper-plane'];
            return keywords.some(k => name.includes(k));
        }
        
        return false;
    });
}

function filterIcons(q) {
    const term = q.toLowerCase().trim().replace(/^fa-(solid|brands|regular)\s+fa-/, '').replace(/fa-/,'');
    const baseList = getCategorizedIcons(_currentTab);
    
    if (!term) {
        renderIcons(baseList, true);
        return;
    }
    
    const filtered = baseList.filter(ic => ic.toLowerCase().includes(term));
    renderIcons(filtered, true);
}

function renderIcons(list, resetScroll = true) {
    _currentList = list;
    const grid = document.getElementById('icon-grid-container');
    if (!grid) return;
    
    if (resetScroll) {
        grid.scrollTop = 0;
        _renderedCount = 0;
        grid.innerHTML = '';
    }
    
    if (list.length === 0) {
        grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:3rem;color:#64748b">Nenhum ícone encontrado.</div>';
        return;
    }
    
    appendMoreIcons();
}

function appendMoreIcons() {
    const grid = document.getElementById('icon-grid-container');
    if (!grid) return;
    
    const start = _renderedCount;
    const end = Math.min(start + _renderLimit, _currentList.length);
    if (start >= _currentList.length) return;
    
    const nextBatch = _currentList.slice(start, end);
    const html = nextBatch.map(ic =>
        `<button type="button" onclick="selectIcon('${ic}')" onmouseenter="previewIcon('${ic}')" title="${ic}"><i class="${ic}"></i></button>`
    ).join('');
    
    const indicator = document.getElementById('scroll-load-indicator');
    if (indicator) indicator.remove();
    
    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = html;
    while (tempDiv.firstChild) {
        grid.appendChild(tempDiv.firstChild);
    }
    
    _renderedCount = end;
    
    if (_renderedCount < _currentList.length) {
        const sentinel = document.createElement('div');
        sentinel.id = 'scroll-load-indicator';
        sentinel.style.gridColumn = '1 / -1';
        sentinel.style.textAlign = 'center';
        sentinel.style.padding = '1rem 0';
        sentinel.style.fontSize = '0.78rem';
        sentinel.style.color = '#64748b';
        sentinel.innerText = `Role para carregar mais... (${_renderedCount} de ${_currentList.length})`;
        grid.appendChild(sentinel);
    }
}

function selectIcon(cls) {
    if (_pickerTarget) _pickerTarget.value = cls;
    if (_pickerPreview) _pickerPreview.innerHTML = `<i class="${cls}"></i>`;
    closeIconPicker();
}

function previewIcon(cls) {
    const paneIcon = document.getElementById('icon-preview-pane-icon');
    const paneName = document.getElementById('icon-preview-pane-name');
    const paneDesc = document.getElementById('icon-preview-pane-desc');
    if (!paneIcon || !paneName || !paneDesc) return;
    
    paneIcon.innerHTML = `<i class="${cls}"></i>`;
    paneName.innerText = cls;
    
    const parts = cls.split(' ');
    const type = parts[0] === 'fa-brands' ? 'Marca / Logotipo' : 'Estilo Sólido';
    const name = parts[1].replace('fa-', '');
    paneDesc.innerText = `Ícone "${name}" • Tipo: ${type}`;
    
    paneIcon.style.transform = 'scale(1.1)';
    paneIcon.style.borderColor = 'rgba(213, 28, 35, 0.5)';
    paneIcon.style.boxShadow = '0 0 12px rgba(213, 28, 35, 0.25)';
}

function resetPanePreview() {
    const paneIcon = document.getElementById('icon-preview-pane-icon');
    const paneName = document.getElementById('icon-preview-pane-name');
    const paneDesc = document.getElementById('icon-preview-pane-desc');
    if (!paneIcon || !paneName || !paneDesc) return;
    
    paneIcon.innerHTML = `<i class="fa-solid fa-face-smile"></i>`;
    paneName.innerText = 'fa-solid fa-face-smile';
    paneDesc.innerText = 'Passe o mouse sobre qualquer ícone da lista para ver os detalhes em tempo real';
    
    paneIcon.style.transform = 'scale(1)';
    paneIcon.style.borderColor = 'rgba(213, 28, 35, 0.25)';
    paneIcon.style.boxShadow = 'none';
}

document.getElementById('icon-modal-overlay').addEventListener('click', function(e){
    if(e.target === this) closeIconPicker();
});
</script>

