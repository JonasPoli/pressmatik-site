        'fa-solid fa-address-book', 'fa-solid fa-address-card', 'fa-solid fa-signature', 'fa-solid fa-stamp',
        'fa-solid fa-scale-balanced', 'fa-solid fa-gavel', 'fa-solid fa-vault',

        // Media & Interface
        'fa-solid fa-image', 'fa-solid fa-images', 'fa-solid fa-camera', 'fa-solid fa-video', 'fa-solid fa-film',
        'fa-solid fa-volume-high', 'fa-solid fa-volume-low', 'fa-solid fa-volume-xmark', 'fa-solid fa-microphone',
        'fa-solid fa-headphones', 'fa-solid fa-music', 'fa-solid fa-tv', 'fa-solid fa-radio', 'fa-solid fa-podcast',
        'fa-solid fa-rss', 'fa-solid fa-newspaper', 'fa-solid fa-bullhorn', 'fa-solid fa-share-nodes', 'fa-solid fa-link',
        'fa-solid fa-arrow-up-right-from-square', 'fa-solid fa-circle-play', 'fa-solid fa-circle-pause', 'fa-solid fa-circle-stop',

        // Health & Sports
        'fa-solid fa-heart-pulse', 'fa-solid fa-stethoscope', 'fa-solid fa-hospital', 'fa-solid fa-user-doctor',
        'fa-solid fa-user-nurse', 'fa-solid fa-kit-medical', 'fa-solid fa-pills', 'fa-solid fa-syringe',
        'fa-solid fa-wheelchair', 'fa-solid fa-dumbbell', 'fa-solid fa-person-running', 'fa-solid fa-person-hiking',
        'fa-solid fa-person-swimming', 'fa-solid fa-person-biking', 'fa-solid fa-person-walking',

        // Arrows & Navigation
        'fa-solid fa-arrow-up-right', 'fa-solid fa-arrow-up-left', 'fa-solid fa-arrow-down-right', 'fa-solid fa-arrow-down-left',
        'fa-solid fa-chevron-up', 'fa-solid fa-chevron-down', 'fa-solid fa-chevron-left', 'fa-solid fa-chevron-right',
        'fa-solid fa-caret-up', 'fa-solid fa-caret-down', 'fa-solid fa-caret-left', 'fa-solid fa-caret-right',
        'fa-solid fa-arrow-rotate-left', 'fa-solid fa-arrow-rotate-right', 'fa-solid fa-repeat', 'fa-solid fa-paper-plane',

        // Brands & Social
        'fa-brands fa-linkedin', 'fa-brands fa-linkedin-in', 'fa-brands fa-instagram', 'fa-brands fa-youtube',
        'fa-brands fa-facebook', 'fa-brands fa-facebook-f', 'fa-brands fa-tiktok', 'fa-brands fa-whatsapp',
        'fa-brands fa-twitter', 'fa-brands fa-x-twitter', 'fa-brands fa-github', 'fa-brands fa-google',
        'fa-brands fa-apple', 'fa-brands fa-microsoft', 'fa-brands fa-android', 'fa-brands fa-amazon',
        'fa-brands fa-wordpress', 'fa-brands fa-paypal', 'fa-brands fa-stripe', 'fa-brands fa-spotify',
        'fa-brands fa-slack', 'fa-brands fa-discord', 'fa-brands fa-figma', 'fa-brands fa-sass',
        'fa-brands fa-html5', 'fa-brands fa-css3-alt', 'fa-brands fa-js', 'fa-brands fa-react',
        'fa-brands fa-vuejs', 'fa-brands fa-angular', 'fa-brands fa-node-js', 'fa-brands fa-python',
        'fa-brands fa-php', 'fa-brands fa-docker', 'fa-brands fa-git-alt', 'fa-brands fa-aws',
        'fa-brands fa-cloudflare', 'fa-brands fa-stack-overflow', 'fa-brands fa-telegram', 'fa-brands fa-skype',
        'fa-brands fa-zoom', 'fa-brands fa-trello', 'fa-brands fa-behance', 'fa-brands fa-dribbble'
    ];

    FA_ICONS = Array.from(new Set(curatedIcons)).sort();
}

function openIconPicker(inputId, previewId) {
    _pickerTarget = typeof inputId === 'string' ? document.getElementById(inputId) : inputId;
    _pickerPreview = typeof previewId === 'string' ? document.getElementById(previewId) : previewId;
    
    loadIconsFromStylesheets();
    document.getElementById('icon-search').value = '';
    
    const tabs = document.querySelectorAll('.icon-tab');
    tabs.forEach(t => t.classList.remove('active'));
    if (tabs[0]) tabs[0].classList.add('active');
    _currentTab = 'all';
    
    renderIcons(FA_ICONS, true);
    document.getElementById('icon-modal-overlay').classList.add('open');
    document.getElementById('icon-search').focus();
    
    if (_pickerTarget && _pickerTarget.value) {
        previewIcon(_pickerTarget.value);
    } else {
        resetPanePreview();
    }
}

function closeIconPicker() {
    document.getElementById('icon-modal-overlay').classList.remove('open');
}

function switchIconTab(category, btn) {
    const tabs = document.querySelectorAll('.icon-tab');
    tabs.forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    
    _currentTab = category;
    document.getElementById('icon-search').value = '';
    
    const list = getCategorizedIcons(category);
    renderIcons(list, true);
}

function getCategorizedIcons(category) {
    if (category === 'all') return FA_ICONS;
    
    return FA_ICONS.filter(ic => {
        const parts = ic.split(' ');
        const prefix = parts[0];
        const name = (parts[1] || '').replace('fa-', '');
        
        if (category === 'brands') {
            return prefix === 'fa-brands';
        }
        
        if (category === 'edu') {
            const keywords = ['graduation', 'book', 'school', 'teacher', 'university', 'college', 'pencil', 'pen', 'brain', 'microscope', 'flask', 'award', 'trophy', 'medal', 'calculator', 'ruler', 'certificate', 'shapes', 'palette', 'dna', 'atlas', 'language', 'child', 'code', 'terminal'];
            return keywords.some(k => name.includes(k));
        }
        
        if (category === 'biz') {
            const keywords = ['gem', 'diamond', 'crown', 'briefcase', 'building', 'store', 'shop', 'shopping', 'credit', 'wallet', 'piggy', 'bank', 'chart', 'tachometer', 'handshake', 'globe', 'server', 'database', 'cloud', 'wifi', 'shield', 'key', 'lock', 'envelope', 'phone', 'bell', 'dollar', 'euro', 'sterling', 'yen', 'real', 'percent', 'coin', 'receipt', 'invoice', 'vault', 'stamp', 'signature', 'industry', 'gear', 'wrench', 'tool', 'robot', 'bolt', 'box', 'truck', 'dolly', 'microchip', 'scale', 'gavel'];
            return keywords.some(k => name.includes(k));
        }
        
        if (category === 'media') {
            const keywords = ['image', 'photo', 'video', 'play', 'music', 'microphone', 'headphones', 'camera', 'film', 'trash', 'edit', 'check', 'xmark', 'info', 'question', 'exclamation', 'search', 'filter', 'sort', 'list', 'bars', 'ellipsis', 'clock', 'calendar', 'link', 'share', 'rss', 'newspaper', 'bullhorn', 'tv'];
            return keywords.some(k => name.includes(k));
        }
        
        if (category === 'health') {
            const keywords = ['heart', 'stethoscope', 'hospital', 'doctor', 'nurse', 'injured', 'kit', 'pills', 'syringe', 'wheelchair', 'virus', 'microbe', 'lungs', 'spa', 'dumbbell', 'running', 'hiking', 'swimming', 'biking', 'walking', 'bicycle', 'carrot', 'lemon', 'sport', 'soccer', 'football', 'basketball', 'baseball', 'tennis', 'trophy', 'medal', 'volleyball', 'golf', 'bowling', 'child'];
            return keywords.some(k => name.includes(k));
        }
        
        if (category === 'arrows') {
            const keywords = ['arrow', 'chevron', 'caret', 'exchange', 'rotate', 'sync', 'repeat', 'spin', 'location', 'compass', 'map-pin', 'direction', 'route', 'road', 'sign', 'plane', 'paper-plane'];
            return keywords.some(k => name.includes(k));
        }
        
        return false;
    });
}

function filterIcons(q) {
    let term = q.toLowerCase().trim().replace(/^fa-(solid|brands|regular)\s+fa-/, '').replace(/fa-/,'');
    const baseList = getCategorizedIcons(_currentTab);
    
    if (!term) {
        renderIcons(baseList, true);
        return;
    }

    const ALIASES = {
        'diamante': ['gem', 'diamond'],
        'diamantes': ['gem', 'diamond'],
        'joia': ['gem'],
        'gema': ['gem'],
        'engrenagem': ['gear', 'gears'],
        'engrenagens': ['gears'],
        'ferramenta': ['wrench', 'toolbox', 'screwdriver-wrench', 'hammer'],
        'industria': ['industry'],
        'empresa': ['building', 'briefcase'],
        'estrela': ['star'],
        'trofeu': ['trophy'],
        'medalha': ['medal'],
        'coroa': ['crown']
    };

    let searchTerms = [term];
    if (ALIASES[term]) {
        searchTerms = searchTerms.concat(ALIASES[term]);
    }

    const filtered = baseList.filter(ic => {
        const icLower = ic.toLowerCase();
        return searchTerms.some(st => icLower.includes(st));
    });
    renderIcons(filtered, true);
}

function renderIcons(list, resetScroll = true) {
    _currentList = list;
    const grid = document.getElementById('icon-grid-container');
    if (!grid) return;
    
    if (resetScroll) {
        grid.scrollTop = 0;
        _renderedCount = 0;
        grid.innerHTML = '';
    }
    
    if (list.length === 0) {
        grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:3rem;color:#64748b">Nenhum ícone encontrado.</div>';
        return;
    }
    
    appendMoreIcons();
}

function appendMoreIcons() {
    const grid = document.getElementById('icon-grid-container');
    if (!grid) return;
    
    const start = _renderedCount;
    const end = Math.min(start + _renderLimit, _currentList.length);
    if (start >= _currentList.length) return;
    
    const nextBatch = _currentList.slice(start, end);
    const html = nextBatch.map(ic =>
        `<button type="button" onclick="selectIcon('${ic}')" onmouseenter="previewIcon('${ic}')" title="${ic}"><i class="${ic}"></i></button>`
    ).join('');
    
    const indicator = document.getElementById('scroll-load-indicator');
    if (indicator) indicator.remove();
    
    const tempDiv = document.createElement('div');
    tempDiv.innerHTML = html;
    while (tempDiv.firstChild) {
        grid.appendChild(tempDiv.firstChild);
    }
    
    _renderedCount = end;
    
    if (_renderedCount < _currentList.length) {
        const sentinel = document.createElement('div');
        sentinel.id = 'scroll-load-indicator';
        sentinel.style.gridColumn = '1 / -1';
        sentinel.style.textAlign = 'center';
        sentinel.style.padding = '1rem 0';
        sentinel.style.fontSize = '0.78rem';
        sentinel.style.color = '#64748b';
        sentinel.innerText = `Role para carregar mais... (${_renderedCount} de ${_currentList.length})`;
        grid.appendChild(sentinel);
    }
}

function selectIcon(cls) {
    if (_pickerTarget) {
        _pickerTarget.value = cls;
        _pickerTarget.dispatchEvent(new Event('input', { bubbles: true }));
    }
    if (_pickerPreview) {
        const iconEl = _pickerPreview.querySelector('i') || _pickerPreview;
        if (iconEl && iconEl.tagName && iconEl.tagName.toLowerCase() === 'i') {
            iconEl.className = cls;
        } else {
            _pickerPreview.innerHTML = `<i class="${cls}"></i>`;
        }
    }
    closeIconPicker();
}

function previewIcon(cls) {
    const paneIcon = document.getElementById('icon-preview-pane-icon');
    const paneName = document.getElementById('icon-preview-pane-name');
    const paneDesc = document.getElementById('icon-preview-pane-desc');
    if (!paneIcon || !paneName || !paneDesc) return;
    
    paneIcon.innerHTML = `<i class="${cls}"></i>`;
    paneName.innerText = cls;
    
    const parts = cls.split(' ');
    const type = parts[0] === 'fa-brands' ? 'Marca / Logotipo' : 'Estilo Sólido';
    const name = parts[1].replace('fa-', '');
    paneDesc.innerText = `Ícone "${name}" • Tipo: ${type}`;
    
    paneIcon.style.transform = 'scale(1.1)';
    paneIcon.style.borderColor = 'rgba(213, 28, 35, 0.5)';
    paneIcon.style.boxShadow = '0 0 12px rgba(213, 28, 35, 0.25)';
}

function resetPanePreview() {
    const paneIcon = document.getElementById('icon-preview-pane-icon');
    const paneName = document.getElementById('icon-preview-pane-name');
    const paneDesc = document.getElementById('icon-preview-pane-desc');
    if (!paneIcon || !paneName || !paneDesc) return;
    
    paneIcon.innerHTML = `<i class="fa-solid fa-face-smile"></i>`;
    paneName.innerText = 'fa-solid fa-face-smile';
    paneDesc.innerText = 'Passe o mouse sobre qualquer ícone da lista para ver os detalhes em tempo real';
    
    paneIcon.style.transform = 'scale(1)';
    paneIcon.style.borderColor = 'rgba(213, 28, 35, 0.25)';
    paneIcon.style.boxShadow = 'none';
}

document.getElementById('icon-modal-overlay').addEventListener('click', function(e){
    if(e.target === this) closeIconPicker();
});
</script>

