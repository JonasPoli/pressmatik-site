function getIconPrefix(iconName) {
    const brands = [
        'instagram', 'facebook', 'facebook-f', 'youtube', 'linkedin', 'linkedin-in', 'whatsapp', 'twitter', 'tiktok', 'github',
        'google', 'apple', 'microsoft', 'android', 'amazon', 'wordpress', 'paypal', 'stripe',
        'spotify', 'slack', 'discord', 'figma', 'sass', 'html5', 'css3', 'js', 'react', 'vue',
        'angular', 'node', 'python', 'php', 'docker', 'git', 'aws', 'digital-ocean', 'cloudflare',
        'stack-overflow', 'medium', 'vimeo', 'tumblr', 'pinterest', 'snapchat', 'reddit', 'quora',
        'telegram', 'skype', 'zoom', 'trello', 'behance', 'dribbble', 'flickr', 'deviantart',
        'steam', 'twitch', 'xbox', 'playstation', 'nintendo-switch', 'google-play', 'app-store'
    ];
    if (brands.includes(iconName) || brands.some(b => iconName.startsWith(b + '-'))) {
        return 'fa-brands';
    }
    return 'fa-solid';
}

