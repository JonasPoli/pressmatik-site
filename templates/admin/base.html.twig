            <span>Itens Opcionais</span>
        </a>

        <div class="sidebar-section-label">Conteúdo</div>

        <a {{nav_item_class('app_admin_service')}} href="{{ path('app_admin_service_index') }}">
            <i class="fa-solid fa-wrench" aria-hidden="true"></i>
            <span>Serviços</span>
        </a>

        <a {{nav_item_class('app_admin_news')}} href="{{ path('app_admin_news_index') }}">
            <i class="fa-solid fa-newspaper" aria-hidden="true"></i>
            <span>Notícias</span>
        </a>

        <div class="sidebar-section-label">Atendimento</div>

        <a {{nav_item_class('app_admin_contact')}} href="{{ path('app_admin_contact_index') }}">
