            <span>Aplicações (Banners)</span>
        </a>

        <a {{nav_item_class('app_admin_application_list_item')}} href="{{ path('app_admin_application_list_item_index') }}">
            <i class="fa-solid fa-industry" aria-hidden="true"></i>
