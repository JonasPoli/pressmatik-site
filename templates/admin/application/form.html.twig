{% extends 'admin/base.html.twig' %}
{% block title %}{{ formTitle }}{% endblock %}
{% block body %}
<div class="page-header">
    <h1 class="page-title">{{ formTitle }}</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400"><a href="{{ path('app_admin_application_index') }}" class="text-primary hover:underline">← Voltar</a></p>
</div>
<form method="post" enctype="multipart/form-data" class="space-y-6">
    <div class="admin-card">
        <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-4">Nomes nos Idiomas</h3>
        {% for lang, label in { pt: '🇧🇷 Português', en: '🇺🇸 Inglês', es: '🇪🇸 Espanhol' } %}
        <fieldset class="border border-slate-200 dark:border-slate-700 rounded-lg p-4 mb-4">
            <legend class="text-xs font-semibold text-slate-500 px-2">{{ label }}</legend>
            <div class="wab-field">
                <label class="wab-label">Nome da Aplicação</label>
                <input type="text" name="name{{ lang|capitalize }}" value="{{ item ? attribute(item, 'name' ~ lang|capitalize) : '' }}" class="wab-input" {{ lang == 'pt' ? 'required' : '' }}>
            </div>
        </fieldset>
        {% endfor %}
    </div>

    <div class="admin-card">
        <h3 class="text-sm font-semibold text-slate-600 dark:text-slate-300 mb-4">Configurações & Imagem / Ícone</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="wab-field">
                <label class="wab-label">Upload de Ícone / Imagem</label>
                <div class="flex items-start gap-4">
                    {% if item and item.imageName %}
                        <div class="flex flex-col gap-1 items-center">
                            <img src="/uploads/applications/{{ item.imageName }}" alt="" class="w-16 h-16 object-contain rounded border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-800 p-1">
                            <label class="flex items-center gap-1 cursor-pointer text-xs text-red-500 hover:text-red-700 mt-1">
                                <input type="checkbox" name="deleteImage" value="1" class="rounded">
                                Remover Imagem
                            </label>
                        </div>
                    {% else %}
                        <div class="w-16 h-16 flex items-center justify-center bg-slate-100 dark:bg-slate-800 rounded border border-dashed border-slate-300 dark:border-slate-600 text-slate-400 text-xs">
                            Sem ícone
                        </div>
                    {% endif %}
                    <div class="flex-grow">
                        <input type="file" name="imageFile" class="wab-input text-xs" accept="image/*">
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
                            <strong>Resolução indicada:</strong> 400 × 400 px (mínimo 80 × 80 px) &nbsp;|&nbsp; <strong>Proporção recomendada:</strong> 1:1 (Quadrado) &nbsp;|&nbsp; <strong>Formatos:</strong> PNG transparente ou WebP
                        </p>
                    </div>
                </div>
            </div>

            <div class="wab-field">
                <label class="wab-label">Posição</label>
                <input type="number" name="position" value="{{ item ? item.position : 0 }}" class="wab-input" min="0">
            </div>

            <div class="wab-field flex items-end">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" name="isActive" value="1" {{ (item is null or item.isActive) ? 'checked' : '' }} class="rounded border-slate-300 text-primary">
                    <span class="text-sm text-slate-700 dark:text-slate-300">Ativa</span>
                </label>
            </div>
        </div>
    </div>

    <div class="flex justify-end gap-3">
        <a href="{{ path('app_admin_application_index') }}" class="px-4 py-2 text-sm text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition-colors">Cancelar</a>
        <button type="submit" class="inline-flex items-center gap-2 px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium"><i class="fa-solid fa-save"></i> Salvar</button>
    </div>
</form>
{% endblock %}
