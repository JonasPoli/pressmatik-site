{% extends 'admin/base.html.twig' %}
{% block title %}Itens de Série{% endblock %}
{% block body %}
<div class="page-header flex items-center justify-between">
    <div>
        <h1 class="page-title">Itens de Série</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400">Gerencie a lista global de itens de série (equipamentos padrão)</p>
    </div>
    <a href="{{ path('app_admin_standard_item_new') }}" class="inline-flex items-center gap-2 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium">
        <i class="fa-solid fa-plus"></i> Adicionar
    </a>
</div>
<div class="admin-card">
    {% if items|length == 0 %}
        <p class="text-sm text-slate-500 py-8 text-center">Nenhum item de série cadastrado.</p>
    {% else %}
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead><tr class="border-b border-slate-200 dark:border-slate-700">
                <th class="text-left py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Pos.</th>
                <th class="text-left py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Ícone</th>
                <th class="text-left py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Nome (PT)</th>
                <th class="text-left py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Nome (EN)</th>
                <th class="text-left py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Nome (ES)</th>
                <th class="text-left py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Status</th>
                <th class="text-right py-3 px-4 font-semibold text-slate-600 dark:text-slate-300">Ações</th>
            </tr></thead>
            <tbody id="standard-item-tbody">
                {% for item in items %}
                <tr class="border-b border-slate-100 dark:border-slate-800 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors" data-id="{{ item.id }}">
                    <td class="py-3 px-4 text-slate-500 cursor-move"><i class="fa-solid fa-grip-vertical mr-2 text-slate-400"></i>{{ item.position }}</td>
                    <td class="py-3 px-4">
                        <div class="w-8 h-8 flex items-center justify-center bg-blue-50 dark:bg-blue-950/40 rounded text-blue-600 dark:text-blue-400 text-base">
                            <i class="{{ item.icon ?: 'fa-solid fa-check' }}"></i>
                        </div>
                    </td>
                    <td class="py-3 px-4 font-medium text-slate-800 dark:text-white">{{ item.namePt }}</td>
                    <td class="py-3 px-4 text-slate-500 dark:text-slate-400">{{ item.nameEn ?: '—' }}</td>
                    <td class="py-3 px-4 text-slate-500 dark:text-slate-400">{{ item.nameEs ?: '—' }}</td>
                    <td class="py-3 px-4">{% if item.isActive %}<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">Ativo</span>{% else %}<span class="text-xs text-slate-400">Inativo</span>{% endif %}</td>
                    <td class="py-3 px-4 text-right"><div class="flex items-center justify-end gap-2">
                        <a href="{{ path('app_admin_standard_item_edit', {id: item.id}) }}" class="text-primary hover:text-primary-dark"><i class="fa-solid fa-pen-to-square"></i></a>
                        <form method="post" action="{{ path('app_admin_standard_item_delete', {id: item.id}) }}" onsubmit="return confirm('Tem certeza?')" class="inline"><input type="hidden" name="_token" value="{{ csrf_token('delete' ~ item.id) }}"><button type="submit" class="text-red-500 hover:text-red-700"><i class="fa-solid fa-trash-can"></i></button></form>
                    </div></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>
{% endblock %}
{% block javascripts %}
{% include 'admin/_partials/_sortable_script.html.twig' with { tbodyId: 'standard-item-tbody', reorderUrl: path('app_admin_standard_item_reorder') } %}
{% endblock %}
