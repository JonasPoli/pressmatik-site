{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Pressmatik - Prensas Hidráulicas e Equipamentos Industriais{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}A Pressmatik é líder na fabricação de prensas hidráulicas, servo-hidráulicas, mecânicas, automação industrial e serviços de manutenção NR12.{% endblock %}">
        <meta name="keywords" content="{% block meta_keywords %}prensas hidraulicas, prensas servo hidraulicas, prensas mecanicas, automacao industrial, alimentadores servo, nr12, retrofitting prensas, pressmatik{% endblock %}">
        <meta name="robots" content="index, follow">
        
        {# Canonical URL & Multilingual Hreflang #}
        <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.requestUri }}">
        <link rel="alternate" hreflang="pt" href="{{ app.request.schemeAndHttpHost ~ path(app.request.attributes.get('_route') ?: 'app_home', (app.request.attributes.get('_route_params') ?: [])|merge(app.request.query.all)|merge({'_locale': 'pt'})) }}">
        <link rel="alternate" hreflang="en" href="{{ app.request.schemeAndHttpHost ~ path(app.request.attributes.get('_route') ?: 'app_home', (app.request.attributes.get('_route_params') ?: [])|merge(app.request.query.all)|merge({'_locale': 'en'})) }}">
        <link rel="alternate" hreflang="es" href="{{ app.request.schemeAndHttpHost ~ path(app.request.attributes.get('_route') ?: 'app_home', (app.request.attributes.get('_route_params') ?: [])|merge(app.request.query.all)|merge({'_locale': 'es'})) }}">
        <link rel="alternate" hreflang="x-default" href="{{ app.request.schemeAndHttpHost ~ path(app.request.attributes.get('_route') ?: 'app_home', (app.request.attributes.get('_route_params') ?: [])|merge(app.request.query.all)|merge({'_locale': 'pt'})) }}">

        {# OpenGraph & Twitter Social Meta Tags #}
        <meta property="og:locale" content="{{ app.request.locale == 'pt' ? 'pt_BR' : (app.request.locale == 'es' ? 'es_ES' : 'en_US') }}">
        <meta property="og:type" content="website">
        <meta property="og:site_name" content="Pressmatik">
        <meta property="og:title" content="{% block og_title %}Pressmatik - Prensas Hidráulicas e Equipamentos Industriais{% endblock %}">
        <meta property="og:description" content="{% block og_description %}Soluções de alta precisão em prensas hidráulicas, servo-hidráulicas e automação industrial.{% endblock %}">
        <meta property="og:image" content="{% block og_image %}{{ app.request.schemeAndHttpHost }}/images/logos/PRESSMATIK_LOGO2_HORIZONTAL_SEGMENTOBASE_VERMELHO.png{% endblock %}">
        <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.requestUri }}">

        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="{% block twitter_title %}Pressmatik - Prensas Hidráulicas{% endblock %}">
        <meta name="twitter:description" content="{% block twitter_description %}Soluções de alta precisão em prensas hidráulicas, servo-hidráulicas e automação industrial.{% endblock %}">
        <meta name="twitter:image" content="{% block twitter_image %}{{ app.request.schemeAndHttpHost }}/images/logos/PRESSMATIK_LOGO2_HORIZONTAL_SEGMENTOBASE_VERMELHO.png{% endblock %}">

        <link rel="icon" href="/images/favicon.png" type="image/png">
        <link rel="shortcut icon" href="/favicon.ico">
        
        {# Performance DNS Preconnect Hints (max 2 for key font origin) #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

        {# Web Fonts - non-blocking #}
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Outfit:wght@400;600;700;800&display=swap" media="print" onload="this.media='all'">

        {# Web Awesome CDN Stylesheet - non-blocking #}
        <link rel="stylesheet" href="https://ka-f.webawesome.com/webawesome@3.9.0/styles/webawesome.css" media="print" onload="this.media='all'">

        {# Bootstrap Icons - non-blocking #}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" media="print" onload="this.media='all'">

        {# Font Awesome - non-blocking #}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" media="print" onload="this.media='all'" crossorigin="anonymous" referrerpolicy="no-referrer">

        {# Global CSS Variables and Styles #}
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {# Preload LCP image hint - overridden per page when needed #}
        {% block preload_lcp %}{% endblock %}

        {# Web Awesome Loader Script #}
        <script type="module" src="https://ka-f.webawesome.com/webawesome@3.9.0/webawesome.loader.js" defer></script>

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {# Schema.org Structured Data (JSON-LD) #}
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Organization",
                    "@id": "{{ app.request.schemeAndHttpHost }}/#organization",
                    "name": "Pressmatik Prensas e Equipamentos",
                    "url": "{{ app.request.schemeAndHttpHost }}",
                    "logo": {
                        "@type": "ImageObject",
                        "url": "{{ app.request.schemeAndHttpHost }}/images/logos/PRESSMATIK_LOGO2_HORIZONTAL_SEGMENTOBASE_VERMELHO.png",
                        "caption": "Pressmatik Logo"
                    },
                    "sameAs": [
                        "https://www.linkedin.com/company/pressmatik/",
                        "https://www.instagram.com/pressmatik_oficial",
                        "https://www.youtube.com/channel/UCE7ZUUPzVg858f45I8nbByQ",
                        "https://www.facebook.com/pressmatikprensaseequipamentos"
                    ],
                    "contactPoint": {
                        "@type": "ContactPoint",
                        "telephone": "+55-16-3014-8368",
                        "contactType": "sales",
                        "areaServed": "BR",
                        "availableLanguage": ["Portuguese", "English", "Spanish"]
                    }
                },
                {
                    "@type": "WebSite",
                    "@id": "{{ app.request.schemeAndHttpHost }}/#website",
                    "url": "{{ app.request.schemeAndHttpHost }}",
                    "name": "Pressmatik",
                    "publisher": {
                        "@id": "{{ app.request.schemeAndHttpHost }}/#organization"
                    },
                    "inLanguage": "{{ app.request.locale }}"
                }
            ]
        }
        </script>
    </head>
    <body>
        {% set locale = app.request.locale %}
        
        <!-- Header (Cabeçalho) -->
        <header class="site-header">
            <div class="container header-container">
                <a href="{{ path('app_home', {'_locale': locale}) }}" class="logo-link" aria-label="Pressmatik Página Inicial">
                    <img src="/images/logos/PRESSMATIK_LOGO2_HORIZONTAL_SEGMENTOBASE_ORIGINAL.png" alt="Pressmatik Logo" width="220" height="48" class="logo-image logo-light" fetchpriority="high" decoding="async">
                    <img src="/images/logos/PRESSMATIK_LOGO2_HORIZONTAL_SEGMENTOBASE_VERMELHO.png" alt="Pressmatik Logo" width="220" height="48" class="logo-image logo-dark" loading="lazy" decoding="async">
                </a>
                
                <nav aria-label="Menu Principal">
                    <ul class="nav-menu">
                        <li><a href="{{ path('app_home', {'_locale': locale}) }}" class="nav-link">{{ 'menu.home'|trans }}</a></li>
                        <li><a href="{{ path('app_about_us', {'_locale': locale}) }}" class="nav-link">{{ 'menu.company'|trans }}</a></li>
                        <li class="nav-item-dropdown">
                            <a href="#" class="nav-link dropdown-trigger-mega" aria-expanded="false" aria-label="Produtos Pressmatik">
                                {{ 'menu.products'|trans }} <span class="dropdown-caret">▼</span>
                            </a>
                            <div class="megamenu-panel">
                                <div class="megamenu-container">
                                    <div class="megamenu-grid">
                                         {% set db_grouped = get_products_grouped() %}
                                         {% set mm_cats = get_megamenu_categories() %}
                                         {% set grouped_cats = {
                                             'hydraulic': {
                                                 'title': mm_cats['hydraulic'].title(locale) ?? 'products_sec.hydraulic_presses'|trans,
                                                 'img': mm_cats['hydraulic'].imageUrl ?? '/images/prensa-hidraulica-tipo-c-duplo-linha-st.webp',
                                                 'products': db_grouped['hydraulic'] ?? []
                                             },
                                             'servo-hydraulic': {
                                                 'title': mm_cats['servo-hydraulic'].title(locale) ?? 'products_sec.servo_presses'|trans,
                                                 'img': mm_cats['servo-hydraulic'].imageUrl ?? '/images/pmc-es.png',
                                                 'products': db_grouped['servo-hydraulic'] ?? []
                                             },
                                             'mechanical': {
                                                 'title': mm_cats['mechanical'].title(locale) ?? 'Prensas Mecânicas',
                                                 'img': mm_cats['mechanical'].imageUrl ?? '/images/prensa-hidraulica-tipo-c-linha-st.webp',
                                                 'products': db_grouped['mechanical'] ?? []
                                             }
                                         } %}

                                         {% for cat_id, cat_info in grouped_cats %}
                                             <div class="megamenu-col">
                                                 <div class="megamenu-img-wrapper">
                                                     <img src="{{ cat_info.img|webp }}" alt="{{ cat_info.title }}" width="160" height="120" loading="lazy" decoding="async">
                                                 </div>
                                                 <span class="megamenu-title">{{ cat_info.title }}</span>
                                                 <ul class="megamenu-links">
                                                     {% for prod in cat_info.products %}
                                                         <li>
                                                             <a href="{{ path('app_product_detail', {'_locale': locale, 'slug': prod.slug}) }}">
                                                                 {{ prod.getName(locale) }}
                                                             </a>
                                                         </li>
                                                     {% endfor %}
                                                 </ul>
                                             </div>
                                         {% endfor %}
                                         <!-- Col 4: Equipamentos -->
                                         <div class="megamenu-col">
                                             <div class="megamenu-img-wrapper">
                                                 <img src="{{ mm_cats['equipments'].imageUrl ?? '/images/tipo-h.webp' }}" alt="{{ mm_cats['equipments'].title(locale) ?? 'products_sec.equipments'|trans }}" width="160" height="120" loading="lazy" decoding="async">
                                             </div>
                                             <span class="megamenu-title">{{ mm_cats['equipments'].title(locale) ?? 'products_sec.equipments'|trans }}</span>
                                             <ul class="megamenu-links">
                                                 {% for prod in db_grouped['equipments'] ?? [] %}
                                                     <li><a href="{{ path('app_product_detail', {'_locale': locale, 'slug': prod.slug}) }}">{{ prod.getName(locale) }}</a></li>
                                                 {% endfor %}
                                             </ul>
                                         </div>
                                         <!-- Col 5: Peças e Acessórios -->
                                         <div class="megamenu-col">
                                             <div class="megamenu-img-wrapper">
                                                 <img src="{{ mm_cats['parts'].imageUrl ?? '/images/especiais.webp' }}" alt="{{ mm_cats['parts'].title(locale) ?? 'products_sec.parts'|trans }}" width="160" height="120" loading="lazy" decoding="async">
                                             </div>
                                             <span class="megamenu-title">{{ mm_cats['parts'].title(locale) ?? 'products_sec.parts'|trans }}</span>
                                             <ul class="megamenu-links">
                                                 {% for prod in db_grouped['parts'] ?? [] %}
                                                     <li><a href="{{ path('app_product_detail', {'_locale': locale, 'slug': prod.slug}) }}">{{ prod.getName(locale) }}</a></li>
                                                 {% endfor %}
                                             </ul>
                                         </div>
                                    </div>
                                </div>
                            </div>
                        </li>
                        <li><a href="{{ path('app_home', {'_locale': locale}) ~ '#services' }}" class="nav-link">{{ 'menu.services'|trans }}</a></li>
                        <li><a href="{{ path('app_news_list', {'_locale': locale}) }}" class="nav-link">{{ 'menu.blog'|trans }}</a></li>
                        <li><a href="{{ path('app_home', {'_locale': locale}) ~ '#contact' }}" class="nav-link">{{ 'menu.contact'|trans }}</a></li>
                    </ul>
                </nav>
                
                <div class="header-actions">
                    <!-- Seletor de Idioma (Language switcher) using custom CSS dropdown -->
                    <div class="lang-selector">
                        <button class="dropdown-trigger" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Selecionar idioma">
                            <i class="bi bi-globe" style="color: var(--color-accent-red); margin-right: 4px;"></i>
                            <span>{{ locale|upper }}</span>
                            <span class="dropdown-caret">▼</span>
                        </button>
                        <ul class="dropdown-menu">
                            <li><a href="{{ path(app.request.attributes.get('_route') ?: 'app_home', (app.request.attributes.get('_route_params') ?: [])|merge(app.request.query.all)|merge({'_locale': 'pt'})) }}">Português (PT)</a></li>
                            <li><a href="{{ path(app.request.attributes.get('_route') ?: 'app_home', (app.request.attributes.get('_route_params') ?: [])|merge(app.request.query.all)|merge({'_locale': 'en'})) }}">English (EN)</a></li>
                            <li><a href="{{ path(app.request.attributes.get('_route') ?: 'app_home', (app.request.attributes.get('_route_params') ?: [])|merge(app.request.query.all)|merge({'_locale': 'es'})) }}">Español (ES)</a></li>
                        </ul>
                    </div>

                    <!-- Theme Toggle Button -->
                    <wa-button id="theme-toggle" variant="text" size="m" aria-label="Alternar tema claro ou escuro" style="color: var(--color-text-primary); margin-right: 8px;">
                        <i id="theme-toggle-icon" class="bi bi-moon" style="color: var(--color-accent-red); font-size: 1.2rem;"></i>
                    </wa-button>
                    
                    <wa-button variant="brand" href="{{ path('app_home', {'_locale': locale}) ~ '#contact' }}">
                        {{ 'menu.quote'|trans }}
                    </wa-button>

                    <!-- Mobile Menu Button -->
                    <button id="mobile-menu-toggle" class="mobile-menu-btn" aria-label="Abrir menu de navegação">
                        <i class="bi bi-list"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Mobile Menu Overlay -->
        <div id="mobile-menu-overlay" onclick="closeMobileMenu();" role="presentation" aria-hidden="true"></div>

        <!-- Mobile Navigation Panel -->
        <div id="mobile-menu-drawer">
            <div class="mobile-nav-header">
                <span>Menu</span>
                <button type="button" onclick="closeMobileMenu();" aria-label="Fechar menu">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="mobile-nav-container">
                <ul class="mobile-nav-menu">
                    <li><a href="{{ path('app_home', {'_locale': locale}) }}" class="mobile-nav-link" onclick="closeMobileMenu();">{{ 'menu.home'|trans }}</a></li>
                    <li><a href="{{ path('app_about_us', {'_locale': locale}) }}" class="mobile-nav-link" onclick="closeMobileMenu();">{{ 'menu.company'|trans }}</a></li>
                    
                    {# Dynamic Products list in Mobile Menu - Collapsible Accordion #}
                    {% set db_grouped = get_products_grouped() %}
                    {% set grouped_cats_mobile = [
                        {'title': 'products_sec.hydraulic_presses'|trans, 'products': db_grouped['hydraulic'] ?? []},
                        {'title': 'products_sec.servo_presses'|trans, 'products': db_grouped['servo-hydraulic'] ?? []},
                        {'title': 'Prensas Mecânicas', 'products': db_grouped['mechanical'] ?? []},
                        {'title': 'products_sec.equipments'|trans, 'products': db_grouped['equipments'] ?? []},
                        {'title': 'products_sec.parts'|trans, 'products': db_grouped['parts'] ?? []}
                    ] %}
                    <li>
                        <button type="button" class="mobile-nav-link mobile-nav-accordion-trigger" aria-label="Expandir menu de Produtos" aria-expanded="false" onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true'); this.classList.toggle('open'); var panel = this.nextElementSibling; panel.style.maxHeight = panel.style.maxHeight ? null : panel.scrollHeight + 'px';" style="width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; cursor: pointer; font: inherit; color: inherit;">
                            {{ 'menu.products'|trans }}
                            <i class="bi bi-chevron-down" style="font-size: 0.75rem; transition: transform 0.3s ease;"></i>
                        </button>
                        <ul class="mobile-nav-accordion-panel" style="max-height: 0; overflow: hidden; transition: max-height 0.35s ease; list-style: none; padding: 0; margin: 0;">
                            {% for cat in grouped_cats_mobile %}
                                {% if cat.products is not empty %}
                                    <li>
                                        <span style="display: block; font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 800; color: var(--color-text-secondary); margin-top: 0.75rem; margin-bottom: 0.25rem; padding-left: 1.25rem;">
                                            {{ cat.title }}
                                        </span>
                                    </li>
                                    {% for prod in cat.products %}
                                        <li>
                                            <a href="{{ path('app_product_detail', {'_locale': locale, 'slug': prod.slug}) }}"
                                               class="mobile-nav-link"
                                               style="padding-left: 2rem; font-size: 0.9rem;"
                                               onclick="closeMobileMenu();">
                                                {{ prod.getName(locale) }}
                                            </a>
                                        </li>
                                    {% endfor %}
                                {% endif %}
                            {% endfor %}
                        </ul>
                    </li>
                    
                    <li><a href="{{ path('app_home', {'_locale': locale}) ~ '#services' }}" class="mobile-nav-link" onclick="closeMobileMenu();">{{ 'menu.services'|trans }}</a></li>
                    <li><a href="{{ path('app_news_list', {'_locale': locale}) }}" class="mobile-nav-link" onclick="closeMobileMenu();">{{ 'menu.blog'|trans }}</a></li>
                    <li><a href="{{ path('app_home', {'_locale': locale}) ~ '#contact' }}" class="mobile-nav-link" onclick="closeMobileMenu();">{{ 'menu.contact'|trans }}</a></li>
                </ul>

                <div class="mobile-nav-divider"></div>

                <div class="mobile-nav-actions">
                    <p class="mobile-lang-label">Idioma:</p>
                    <div class="mobile-lang-btns">
                        <a href="{{ path(app.request.attributes.get('_route') ?: 'app_home', (app.request.attributes.get('_route_params') ?: [])|merge(app.request.query.all)|merge({'_locale': 'pt'})) }}" class="mobile-lang-btn">PT</a>
                        <a href="{{ path(app.request.attributes.get('_route') ?: 'app_home', (app.request.attributes.get('_route_params') ?: [])|merge(app.request.query.all)|merge({'_locale': 'en'})) }}" class="mobile-lang-btn">EN</a>
                        <a href="{{ path(app.request.attributes.get('_route') ?: 'app_home', (app.request.attributes.get('_route_params') ?: [])|merge(app.request.query.all)|merge({'_locale': 'es'})) }}" class="mobile-lang-btn">ES</a>
                    </div>
                    <a href="{{ path('app_home', {'_locale': locale}) ~ '#contact' }}" class="mobile-cta-btn" onclick="closeMobileMenu();">
                        {{ 'menu.quote'|trans }}
                    </a>

                    <div class="mobile-nav-divider"></div>

                    <button id="mobile-theme-toggle" class="mobile-theme-btn" aria-label="Alternar tema">
                        <i id="mobile-theme-icon" class="bi bi-moon"></i>
                        <span id="mobile-theme-label">Tema escuro</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <main>
            {% block body %}{% endblock %}
        </main>

        <!-- Floating WhatsApp Button -->
        <a href="https://wa.me/5516997704156?text=Ol%C3%A1%2C%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20as%20prensas%20Pressmatik." class="whatsapp-float" target="_blank" rel="noopener noreferrer nofollow" aria-label="Contato direto via WhatsApp Pressmatik">
            <i class="bi bi-whatsapp"></i>
        </a>

        <!-- Footer (Rodapé Premium "Estilo Americano") -->
        <footer class="site-footer">
            <div class="container footer-grid">
                <div class="footer-brand">
                    <img src="/images/logos/PRESSMATIK_LOGO2_HORIZONTAL_SEGMENTOBASE_VERMELHO.png" alt="Pressmatik Logo Rodapé" width="200" height="46" loading="lazy" decoding="async" style="max-height: 50px; margin-bottom: 12px;">
                    <p>{{ 'footer.about'|trans }}</p>
                    <div class="footer-social-links">
                        <a href="https://www.linkedin.com/company/pressmatik/" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Siga a Pressmatik no LinkedIn" title="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="https://www.instagram.com/pressmatik_oficial" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Siga a Pressmatik no Instagram" title="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="https://www.youtube.com/channel/UCE7ZUUPzVg858f45I8nbByQ" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Inscreva-se no canal do YouTube da Pressmatik" title="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="https://www.facebook.com/pressmatikprensaseequipamentos?_rdr" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Curta a página da Pressmatik no Facebook" title="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="https://www.tiktok.com/@pressmatik?lang=pt-br" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Siga a Pressmatik no TikTok" title="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="https://linktr.ee/pressmatikoficial" target="_blank" rel="noopener noreferrer" class="footer-social-btn" aria-label="Acesse todos os links da Pressmatik no Linktree" title="Linktree"><i class="bi bi-tree-fill"></i></a>
                    </div>
                </div>
                
                <div class="footer-links-col">
                    <h3 class="footer-col-title">{{ 'menu.products'|trans }}</h3>
                    <ul>
                        <li><a href="{{ path('app_product_detail', {'_locale': locale, 'slug': 'prensas-hidraulicas-tipo-c'}) }}">{{ 'catalog.hydraulic.tipo_c.name'|trans }}</a></li>
                        <li><a href="{{ path('app_product_detail', {'_locale': locale, 'slug': 'prensas-hidraulicas-4-colunas'}) }}">{{ 'catalog.hydraulic.colunas.name'|trans }}</a></li>
                        <li><a href="{{ path('app_product_detail', {'_locale': locale, 'slug': 'prensas-servo-hidraulicas-servo-bombas'}) }}">{{ 'catalog.servo_hydraulic.bombas.name'|trans }}</a></li>
                        <li><a href="{{ path('app_product_detail', {'_locale': locale, 'slug': 'prensas-mecanicas-mecanicas'}) }}">{{ 'catalog.mechanical.mecanicas.name'|trans }}</a></li>
                    </ul>
                </div>
                
                <div class="footer-links-col">
                    <h3 class="footer-col-title">{{ 'menu.services'|trans }}</h3>
                    <ul>
                        {% set active_services = get_active_services() %}
                        {% for serv in active_services %}
                            <li><a href="{{ path('app_service_detail', {'_locale': locale, 'slug': serv.getSlug(locale)}) }}">{{ serv.getTitle(locale) }}</a></li>
                        {% else %}
                            <li><a href="{{ path('app_home', {'_locale': locale}) ~ '#services' }}">{{ 'services_sec.maintenance.title'|trans }}</a></li>
                            <li><a href="{{ path('app_home', {'_locale': locale}) ~ '#services' }}">{{ 'services_sec.refit.title'|trans }}</a></li>
                            <li><a href="{{ path('app_home', {'_locale': locale}) ~ '#services' }}">{{ 'services_sec.nr12.title'|trans }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
                
                <div class="footer-links-col">
                    <h3 class="footer-col-title">{{ 'footer.address_title'|trans }}</h3>
                    <p style="font-size: 0.85rem; line-height: 1.6; margin-bottom: 0.5rem; color: var(--color-text-secondary);">
                        {{ 'footer.address_factory'|trans }}
                    </p>
                    {% if 'footer.address_office'|trans is not empty %}
                    <p style="font-size: 0.85rem; line-height: 1.6; margin-bottom: 1rem; color: var(--color-text-secondary);">
                        {{ 'footer.address_office'|trans }}
                    </p>
                    {% endif %}
                    <p style="font-size: 0.85rem; color: var(--color-text-primary); font-weight: 500;">
                        <a href="tel:+551630148368" style="color: inherit; text-decoration: none;">{{ 'footer.phone'|trans }}</a>
                    </p>
                    <p style="font-size: 0.85rem; color: #25d366; font-weight: 500;">
                        <a href="https://wa.me/5516997704156?text=Ol%C3%A1%2C%20gostaria%20de%20mais%20informa%C3%A7%C3%B5es%20sobre%20as%20prensas%20Pressmatik." target="_blank" style="color: inherit; text-decoration: none;">
                            <i class="bi bi-whatsapp" style="margin-right: 4px;"></i>{{ 'footer.whatsapp'|trans }}
                        </a>
                    </p>
                    <p style="font-size: 0.85rem; color: #f87171; font-weight: 500;">
                        {{ 'footer.email'|trans }}
                    </p>
                </div>
            </div>
            
            <div class="container footer-bottom">
                <div>
                    {{ 'footer.rights'|trans }}
                </div>
                <div class="footer-bottom-links">
                    <a href="{{ path('app_home', {'_locale': locale}) ~ '#contact' }}">{{ 'footer.privacy_policy'|trans({}, 'messages', locale)|default('Privacy Policy') }}</a>
                    <a href="{{ path('app_home', {'_locale': locale}) ~ '#contact' }}">{{ 'footer.terms_of_service'|trans({}, 'messages', locale)|default('Terms of Service') }}</a>
                </div>
            </div>
        </footer>

        <script>
            // Inline theme detection to prevent flash of wrong theme
            (function() {
                const savedTheme = localStorage.getItem('theme');
                if (savedTheme === 'dark') {
                    document.documentElement.classList.add('dark-theme');
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.classList.remove('dark-theme');
                    document.documentElement.setAttribute('data-theme', 'light');
                }
            })();

            function initPage() {
                // Theme toggle implementation
                const toggle = document.getElementById('theme-toggle');
                const icon = document.getElementById('theme-toggle-icon');
                const mobileThemeToggle = document.getElementById('mobile-theme-toggle');
                const mobileThemeIcon = document.getElementById('mobile-theme-icon');
                const mobileThemeLabel = document.getElementById('mobile-theme-label');

                // Shared function to apply theme state to icons
                function applyThemeIcons(isDark) {
                    if (icon) icon.className = isDark ? 'bi bi-sun' : 'bi bi-moon';
                    if (mobileThemeIcon) mobileThemeIcon.className = isDark ? 'bi bi-sun' : 'bi bi-moon';
                    if (mobileThemeLabel) mobileThemeLabel.textContent = isDark ? 'Tema claro' : 'Tema escuro';
                }

                // Shared function to toggle theme
                function toggleTheme() {
                    const isDark = document.documentElement.classList.contains('dark-theme');
                    const newTheme = isDark ? 'light' : 'dark';
                    localStorage.setItem('theme', newTheme);
                    
                    if (window.applyColorTheme) {
                        window.applyColorTheme();
                    } else {
                        if (newTheme === 'dark') {
                            document.documentElement.classList.add('dark-theme', 'dark', 'wa-dark');
                            document.documentElement.classList.remove('wa-light');
                            document.documentElement.setAttribute('data-theme', 'dark');
                        } else {
                            document.documentElement.classList.remove('dark-theme', 'dark', 'wa-dark');
                            document.documentElement.classList.add('wa-light');
                            document.documentElement.setAttribute('data-theme', 'light');
                        }
                    }
                    applyThemeIcons(newTheme === 'dark');
                }

                // Initialize icon state
                applyThemeIcons(document.documentElement.classList.contains('dark-theme'));

                if (toggle && !toggle.dataset.themeInitialized) {
                    toggle.addEventListener('click', toggleTheme);
                    toggle.dataset.themeInitialized = 'true';
                }
                if (mobileThemeToggle && !mobileThemeToggle.dataset.themeInitialized) {
                    mobileThemeToggle.addEventListener('click', toggleTheme);
                    mobileThemeToggle.dataset.themeInitialized = 'true';
                }

                // Mobile Menu Toggle logic
                const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
                const mobileMenuDrawer = document.getElementById('mobile-menu-drawer');
                const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');

                if (mobileMenuToggle && mobileMenuDrawer) {
                    mobileMenuToggle.addEventListener('click', () => {
                        mobileMenuDrawer.classList.add('open');
                        if (mobileMenuOverlay) mobileMenuOverlay.classList.add('open');
                        document.body.style.overflow = 'hidden';
                    });
                }

                window.closeMobileMenu = function() {
                    if (mobileMenuDrawer) {
                        mobileMenuDrawer.classList.remove('open');
                        if (mobileMenuOverlay) mobileMenuOverlay.classList.remove('open');
                        document.body.style.overflow = '';
                    }
                };

                // Global IntersectionObserver scroll-animate script
                const observer = new IntersectionObserver(
                    (entries) => {
                        for (const entry of entries) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add('animated');
                            }
                        }
                    },
                    {
                        threshold: 0.05,
                        rootMargin: '0px 0px -55px 0px'
                    }
                );

                document.querySelectorAll('.scroll-animate').forEach((el) => {
                    observer.observe(el);
                });
            }
            document.addEventListener('turbo:load', initPage);
            document.addEventListener('DOMContentLoaded', initPage);
        </script>
    </body>
</html>
