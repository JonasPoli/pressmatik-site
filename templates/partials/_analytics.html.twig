{# templates/partials/_analytics.html.twig

   Google Analytics 4 (gtag.js).

   Carrega apenas nos dominios canonicos de producao (app.production_hosts).
   Em homologacao (*.wab.com / *.wab.com.br) e no ambiente local nada e
   carregado, para nao contaminar os dados da propriedade com acessos de teste.
#}
{% if app.request.host|lower in production_hosts and ga_measurement_id %}
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ ga_measurement_id }}"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        {# Valor vem do parametro app.ga_measurement_id (codigo proprio, nao input
           de usuario); sem |e('js') para o ID ficar legivel no HTML e poder ser
           auditado pelas ferramentas do Google (Tag Assistant). #}
        gtag('config', '{{ ga_measurement_id }}');
    </script>
{% endif %}
